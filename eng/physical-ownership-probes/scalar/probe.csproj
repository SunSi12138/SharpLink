<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework><ImplicitUsings>enable</ImplicitUsings><AssemblyName>SharpLink.Benchmarks</AssemblyName><Nullable>enable</Nullable></PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <Reference Include="SharpLink.Abstractions"><HintPath>$(LibraryRoot)/SharpLink.Abstractions.dll</HintPath></Reference>
    <Reference Include="SharpLink.Runtime"><HintPath>$(LibraryRoot)/SharpLink.Runtime.dll</HintPath></Reference>
    <Reference Include="SharpLink.Client"><HintPath>$(LibraryRoot)/SharpLink.Client.dll</HintPath></Reference>
  </ItemGroup>
</Project>
