@@ -0,0 +1,61 @@
+namespace SharpLink.UnitTests.Runtime;
+
+public sealed class PreAdmissionImmutableBindingTests
+{
+    [Test]
+    [Arguments(false)]
+    [Arguments(true)]
+    public async Task ExplicitBindingClearMustReachChildAcrossAttachment(bool duringAttachment)
+    {
+        var timeout = TimeSpan.FromSeconds(10);
+        using var configured = new ManualResetEventSlim();
+        using var release = new ManualResetEventSlim();
+        var bytes = 0;
+        var binding = PooledDispatcherReceiveBindingExtensions.Create(
+            (_, _, count) => bytes += count, null, default, 9630, 1);
+        var mailbox = new PreAdmissionStreamDispatcher(
+            new SharpLinkBufferWriterPool(new BufferWriterPoolOptions()),
+            _ => true, _ => { }, () => throw new InvalidOperationException("Unexpected capacity."));
+        mailbox.SetReceiveCreditBinding(binding);
+        var child = new BindingChild(value =>
+        {
+            if (value is null || !duringAttachment) return;
+            configured.Set();
+            if (!release.Wait(timeout)) throw new TimeoutException("Missing attachment release.");
+        });
+        if (!mailbox.TryBeginAttach(child, out _)) throw new InvalidOperationException("Attach must begin.");
+        var attachment = Task.Run(() => mailbox.FinishAttach(child));
+        try
+        {
+            if (duringAttachment && !configured.Wait(timeout))
+                throw new TimeoutException("Missing child configuration.");
+            if (!duringAttachment) await attachment.WaitAsync(timeout);
+            mailbox.SetReceiveCreditBinding(null);
+        }
+        finally { release.Set(); }
+        await attachment.WaitAsync(timeout);
+        if (child.Binding is not null) throw new InvalidOperationException("Explicit clear did not reach child.");
+        await mailbox.DispatchAsync(new ReadOnlySequence<byte>(new byte[] { 1 }), 1);
+        if (bytes != 0) throw new InvalidOperationException("Child used a binding after explicit clear.");
+        mailbox.Abandon(out _);
+    }
+
+    private sealed class BindingChild(Action<StreamManager.DispatcherEntry?> configured)
+        : IStreamReceiveCreditBoundDispatcher
+    {
+        internal StreamManager.DispatcherEntry? Binding;
+        public void SetReceiveCreditBinding(StreamManager.DispatcherEntry? binding)
+        {
+            Binding = binding;
+            configured(binding);
+        }
+        public ValueTask DispatchAsync(ReadOnlySequence<byte> payload) => DispatchAsync(payload, 1);
+        public ValueTask DispatchAsync(ReadOnlySequence<byte> payload, int encodedByteCount)
+        {
+            Binding?.RecordConsumed(encodedByteCount);
+            return ValueTask.CompletedTask;
+        }
+        public void Complete(bool isError, string? errorMessage) { }
+        public void Complete(Exception? exception) { }
+    }
+}
diff --git a/test/SharpLink.UnitTests/Runtime/ResolvedStreamPublicationTests.cs b/test/SharpLink.UnitTests/Runtime/ResolvedStreamPublicationTests.cs
new file mode 100644
index 00000000..43435d62
