@@ -0,0 +1,41 @@
+namespace SharpLink.UnitTests.Runtime;
+
+// Standalone dispatcher fixtures use real immutable entry bindings without registering a
+// transport route or changing the fixture's independent dispatch-lifetime state machine.
+internal static class PooledDispatcherReceiveBindingExtensions
+{
+    internal static void SetBytesConsumedCallback<T>(this PooledAsyncStreamDispatcher<T> dispatcher,
+        Action<long, ushort, int>? callback, long requestId, ushort streamId)
+        => dispatcher.SetReceiveCreditBinding(callback is null ? null :
+            Create(callback, null, default, requestId, streamId));
+
+    internal static bool TrySetResolvedBytesConsumedCallback<T>(this PooledAsyncStreamDispatcher<T> dispatcher,
+        ResolvedStreamBytesCallback? callback, in StreamFlowController.ResolvedReceiveCreditLease lease)
+    {
+        dispatcher.SetReceiveCreditBinding(callback is null ? null :
+            Create(null, callback, lease, lease.RequestId, lease.StreamId));
+        return true;
+    }
+
+    internal static StreamManager.DispatcherEntry Create(Action<long, ushort, int>? keyed,
+        ResolvedStreamBytesCallback? resolved, StreamFlowController.ResolvedReceiveCreditLease lease,
+        long requestId, ushort streamId)
+    {
+        var manager = new StreamManager(new RuntimeConcurrencyOptions(), null, keyed, null,
+            maxActiveStreams: 1, activeStreamCapacityExceeded: null,
+            resolvedBytesConsumed: resolved);
+        var entry = new StreamManager.DispatcherEntry(StandaloneDispatcher.Instance, manager, requestId, streamId);
+        entry.InitializeReceiveCredit(lease);
+        entry.ActivateRegistration();
+        entry.FinishRegistration();
+        return entry;
+    }
+
+    private sealed class StandaloneDispatcher : IStreamDispatcher
+    {
+        internal static readonly StandaloneDispatcher Instance = new();
+        public ValueTask DispatchAsync(ReadOnlySequence<byte> payload) => ValueTask.CompletedTask;
+        public void Complete(bool isError, string? errorMessage) { }
+        public void Complete(Exception? exception) { }
+    }
+}
diff --git a/test/SharpLink.UnitTests/Runtime/PooledDispatcherSlowWaitTests.cs b/test/SharpLink.UnitTests/Runtime/PooledDispatcherSlowWaitTests.cs
new file mode 100644
index 00000000..466a2a49
--- /dev/null
+++ b/test/SharpLink.UnitTests/Runtime/PooledDispatcherSlowWaitTests.cs
@@ -0,0 +1,254 @@
+using System.Runtime.CompilerServices;
+using System.Threading;
+using System.Reflection;
+using System.Threading.Tasks.Sources;
+
+namespace SharpLink.UnitTests.Runtime;
+
+[NotInParallel("dispatcher-pool")]
+public sealed class PooledDispatcherSlowWaitTests
+{
+    private static readonly TimeSpan Bound = TimeSpan.FromSeconds(10);
+    private static readonly AsyncLocal<object?> ContextMarker = new();
+
+    [Test]
+    public async Task RepeatedSuspendedReadsMustNotAllocateOneWrapperPerItem()
+        => await MeasureSuspendedReadsAsync().WaitAsync(Bound);
+
+    private static async Task MeasureSuspendedReadsAsync()
+    {
+        const int warmups = 128;
+        const int count = 512;
+        PooledAsyncStreamDispatcher<string?>.ClearPoolForTests();
+        var dispatcher = PooledAsyncStreamDispatcher<string?>.Rent(default, StringCodec.Instance);
+        var enumerator = dispatcher.GetAsyncEnumerator();
+        var bytes = new ArrayBufferWriter<byte>();
+        string? value = "wait-value";
+        StringCodec.Instance.Serialize(in value, bytes);
+        var payload = new ReadOnlySequence<byte>(bytes.WrittenMemory);
+        long returned = 0;
+        dispatcher.SetBytesConsumedCallback((_, _, size) => returned += size, 9910, 1);
+        long allocated = 0;
+        try
+        {
+            for (var iteration = 0; iteration < warmups + count; iteration++)
+            {
+                var before = GC.GetAllocatedBytesForCurrentThread();
+                var read = enumerator.MoveNextAsync();
+                var perRead = GC.GetAllocatedBytesForCurrentThread() - before;
+                Require(!read.IsCompleted, "every measured read must genuinely wait for DATA");
+                await dispatcher.DispatchAsync(payload, bytes.WrittenCount);
+                Require(await read && enumerator.Current == value,
+                    "each suspended read must deliver exactly its own payload");
+                if (iteration >= warmups) allocated += perRead;
+            }
+            dispatcher.Complete(exception: null);
+            Require(!await enumerator.MoveNextAsync(), "terminal read must complete without invented DATA");
+            await enumerator.DisposeAsync();
+            Require(returned == (warmups + count) * bytes.WrittenCount,
+                "suspended reads must return exactly the consumed byte count");
+            Require(!dispatcher.HasRetainedReferencesForTests,
+                "dispatcher pool return must still clear callbacks, codec and tokens");
+            var directory = Environment.GetEnvironmentVariable("SHARPLINK_SLOW_WAIT_EVIDENCE");
+            if (!string.IsNullOrEmpty(directory))
+            {
+                System.IO.Directory.CreateDirectory(directory);
+                System.IO.File.WriteAllText(System.IO.Path.Combine(directory, "pending-read.csv"),
+                    $"count,allocated_bytes\n{count},{allocated}\n");
+            }
+            Console.WriteLine($"PENDING_READ_ALLOCATION count={count} bytes={allocated}");
+            Require(allocated <= count * 16L,
+                "suspended MoveNext still allocates one fresh wrapper for every item");
+        }
+        finally
+        {
+            dispatcher.Complete(exception: null);
+            await enumerator.DisposeAsync();
+            PooledAsyncStreamDispatcher<string?>.ClearPoolForTests();
+        }
+    }
+
+    [Test]
+    public async Task SuspendedReadPreservesCancellationIdentityAndTaskStatus()
+    {
+        PooledAsyncStreamDispatcher<string?>.ClearPoolForTests();
+        using var stop = new CancellationTokenSource();
+        var dispatcher = PooledAsyncStreamDispatcher<string?>.Rent(stop.Token, StringCodec.Instance);
+        var enumerator = dispatcher.GetAsyncEnumerator();
+        try
+        {
+            var read = enumerator.MoveNextAsync();
+            Require(!read.IsCompleted, "cancellation control needs a pending consumer");
+            var task = read.AsTask(); // Convert exactly once; the ValueTask is not reused.
+            stop.Cancel();
+            Exception? failure = null;
+            try { _ = await task.WaitAsync(Bound); }
+            catch (Exception error) { failure = error; }
+            Require(failure is OperationCanceledException canceled && canceled.CancellationToken == stop.Token,
+                "the pending read must retain its original cancellation token");
+            Require(task.IsCanceled && !task.IsFaulted,
+                "canceled reads must not change to faulted Task status");
+        }
+        finally
+        {
+            await enumerator.DisposeAsync();
+            Require(!dispatcher.HasRetainedReferencesForTests, "canceled wait retained dispatcher references");
+            PooledAsyncStreamDispatcher<string?>.ClearPoolForTests();
+        }
+    }
+
+    [Test]
+    public async Task SuspendedReadPreservesOriginalTerminalException()
+    {
+        PooledAsyncStreamDispatcher<string?>.ClearPoolForTests();
+        var dispatcher = PooledAsyncStreamDispatcher<string?>.Rent(default, StringCodec.Instance);
+        var enumerator = dispatcher.GetAsyncEnumerator();
+        var expected = new InvalidOperationException("pending terminal control");
+        try
+        {
+            var read = enumerator.MoveNextAsync();
+            Require(!read.IsCompleted, "fault control needs a pending consumer");
+            var task = read.AsTask();
+            dispatcher.Complete(expected);
+            Exception? failure = null;
+            try { _ = await task.WaitAsync(Bound); }
+            catch (Exception error) { failure = error; }
+            Require(ReferenceEquals(failure, expected) && task.IsFaulted && !task.IsCanceled,
+                "pooled completion must preserve original exception identity and fault status");
+        }
+        finally
+        {
+            await enumerator.DisposeAsync();
+            Require(!dispatcher.HasRetainedReferencesForTests, "failed wait retained dispatcher references");
+            PooledAsyncStreamDispatcher<string?>.ClearPoolForTests();
+        }
+    }
+
+    [Test]
+    public async Task DelayedOldResultCannotReadAReusedDispatcherGeneration()
+    {
+        PooledAsyncStreamDispatcher<string?>.ClearPoolForTests();
+        var dispatcher = PooledAsyncStreamDispatcher<string?>.Rent(default, StringCodec.Instance);
+        var enumerator = dispatcher.GetAsyncEnumerator();
+        var expected = new InvalidOperationException("old generation terminal");
+        var read = enumerator.MoveNextAsync();
+        Require(!read.IsCompleted, "old generation must start with a pending consumer");
+        dispatcher.Complete(expected);
+        await WaitUntilCompleteAsync(read).WaitAsync(Bound);
+        await enumerator.DisposeAsync();
+        var replacement = PooledAsyncStreamDispatcher<string?>.Rent(default, StringCodec.Instance);
+        try
+        {
+            Require(ReferenceEquals(dispatcher, replacement), "control must reuse the actual pooled dispatcher");
+            Exception? failure = null;
+            try { _ = await read; }
+            catch (Exception error) { failure = error; }
+            Require(ReferenceEquals(failure, expected),
+                "an old unconsumed result must not observe the replacement generation");
+            replacement.Complete(exception: null);
+            Require(!await replacement.MoveNextAsync(), "replacement terminal must stay independent");
+        }
+        finally
+        {
+            replacement.Complete(exception: null);
+            await replacement.DisposeAsync();
+            PooledAsyncStreamDispatcher<string?>.ClearPoolForTests();
+        }
+    }
+
+    private static async Task WaitUntilCompleteAsync(ValueTask<bool> operation)
+    {
+        while (!operation.IsCompleted) await Task.Yield();
+    }
+
+    [Test]
+    [Arguments(false)]
+    [Arguments(true)]
+    public void ConsumedReadCacheMustNotRetainExecutionContextPayload(bool retainContextNegativeControl)
+    {
+        CacheProbe? probe = null;
+        Exception? failure = null;
+        // A completed Task can publish its result before its execution-context stack
+        // unwinds. A joined thread and inline completion exclude that unrelated root.
+        var thread = new Thread(() =>
+        {
+            try { probe = ExerciseContextInline(retainContextNegativeControl); }
+            catch (Exception error) { failure = error; }
+        });
+        using (ExecutionContext.SuppressFlow()) thread.Start();
+        Require(thread.Join(Bound), "context fixture thread did not exit");
+        if (failure is not null)
+            System.Runtime.ExceptionServices.ExceptionDispatchInfo.Capture(failure).Throw();
+        var completed = probe ?? throw new InvalidOperationException("missing context probe");
+        Collect();
+        Require(completed.Payload.IsAlive == retainContextNegativeControl,
+            "consumed wait/cache retained context, or the deliberate context-root negative control was missed");
+        completed.DeliberateRoot = null;
+        Collect();
+        Require(!completed.Payload.IsAlive,
+            "a completed and consumed wait cached its old ExecutionContext payload");
+        // Hold the exact result source alive through both collections, rather than
+        // accidentally passing by collecting a broken pooled state-machine object.
+        GC.KeepAlive(completed.ResultSource);
+    }
+
+    [MethodImpl(MethodImplOptions.NoInlining)]
+    private static CacheProbe ExerciseContextInline(bool keepContext)
+    {
+        PooledAsyncStreamDispatcher<string?>.ClearPoolForTests();
+        var marker = new byte[1024 * 1024];
+        var weak = new WeakReference(marker);
+        ContextMarker.Value = marker;
+        var dispatcher = PooledAsyncStreamDispatcher<string?>.Rent(default, StringCodec.Instance);
+        var enumerator = dispatcher.GetAsyncEnumerator();
+        try
+        {
+            // Force the existing wait source to complete inline, so its resumed
+            // state-machine frame has returned before GetResult and before thread exit.
+            var field = dispatcher.GetType().GetField("_waitSource", BindingFlags.Instance | BindingFlags.NonPublic)!;
+            var source = (ManualResetValueTaskSourceCore<bool>)field.GetValue(dispatcher)!;
+            source.RunContinuationsAsynchronously = false;
+            field.SetValue(dispatcher, source);
+            var read = enumerator.MoveNextAsync();
+            Require(!read.IsCompleted, "context control must really suspend");
+            var resultSource = typeof(ValueTask<bool>).GetField("_obj", BindingFlags.Instance | BindingFlags.NonPublic)!
+                .GetValue(read) ?? throw new InvalidOperationException("missing asynchronous result source");
+            var deliberateRoot = keepContext ? ExecutionContext.Capture() : null;
+            dispatcher.Complete(exception: null);
+            Require(read.IsCompleted, "inline completion must unwind before result consumption");
+            Require(!read.GetAwaiter().GetResult(), "normal empty completion must remain false");
+            enumerator.DisposeAsync().AsTask().GetAwaiter().GetResult();
+            Require(!dispatcher.HasRetainedReferencesForTests, "dispatcher itself retained user state");
+            return new CacheProbe(weak, resultSource, deliberateRoot);
+        }
+        finally
+        {
+            ContextMarker.Value = null;
+            dispatcher.Complete(exception: null);
+            enumerator.DisposeAsync().AsTask().GetAwaiter().GetResult();
+            PooledAsyncStreamDispatcher<string?>.ClearPoolForTests();
+        }
+    }
+
+    private static void Collect()
+    {
+        for (var pass = 0; pass < 3; pass++)
+        {
+            GC.Collect();
+            GC.WaitForPendingFinalizers();
+            GC.Collect();
+        }
+    }
+
+    private sealed class CacheProbe(WeakReference payload, object source, ExecutionContext? root)
+    {
+        internal WeakReference Payload { get; } = payload;
+        internal object ResultSource { get; } = source;
+        internal ExecutionContext? DeliberateRoot = root;
+    }
+
+    private static void Require(bool condition, string message)
+    {
+        if (!condition) throw new InvalidOperationException(message);
+    }
+}
