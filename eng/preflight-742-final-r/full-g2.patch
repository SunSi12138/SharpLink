+    [Test]
+    [Arguments("Attached")]
+    [Arguments("Lease")]
+    [Arguments("Completed")]
+    [Arguments("AbortException")]
+    public async Task OrderedTailShouldLetExistingScanRejectInvalidPredecessors(string invalidField)
+    {
+        var controller = new StreamFlowController(2, 6, 1024);
+        await controller.AcquireSendCreditAsync(953, 0, 2, CancellationToken.None);
+        var head = controller.AcquireSendCreditAsync(953, 0, 1, CancellationToken.None);
+        var state = GetSendState(controller, 953, 0);
+        var rejection = new SharpLinkException(SharpLinkErrorCode.Cancelled, "invalid queued predecessor");
+        // Public lifecycle methods remove these waiters eagerly. Inject each defensive
+        // scan case deterministically; no production hook or timing race is required.
+        object invalidValue = invalidField switch
+        {
+            "Attached" => false,
+            "Lease" => GetPrivateField<long>(state, "Lease") + 1,
+            "Completed" => true,
+            _ => rejection,
+        };
+        SetTailTestField(state, invalidField, invalidValue);
+        var tail = controller.AcquireSendCreditAsync(954, 0, 1, CancellationToken.None);
+        Ensure(tail.IsCompletedSuccessfully, "the existing scan must reject the predecessor and admit the tail");
+        await tail;
+        try
+        {
+            await head.AsTask().WaitAsync(TimeSpan.FromSeconds(5));
+            throw new Exception("expected the invalid predecessor to be rejected");
+        }
+        catch (SharpLinkException exception)
+        {
+            Ensure(invalidField == "AbortException" ? ReferenceEquals(exception, rejection) :
+                exception.Code == SharpLinkErrorCode.ConnectionClosed,
+                "the fallback must preserve the predecessor's exact rejection semantics");
+        }
+        Ensure(controller.SendConnectionCredit == 3,
+            "invalid predecessor removal must not debit or refund its outstanding credit");
+    }
+
+    [Test]
+    public async Task OrderedTailShouldNotBypassAnEligibleQueuedPredecessor()
+    {
+        var controller = new StreamFlowController(2, 6, 1024);
+        await controller.AcquireSendCreditAsync(955, 0, 2, CancellationToken.None);
+        var head = controller.AcquireSendCreditAsync(955, 0, 1, CancellationToken.None);
+        // Make the earlier entry eligible without running its normal credit-return scan,
+        // to exercise the conservative guard that must leave all mutation to AdmitWaiters.
+        SetTailTestField(GetSendState(controller, 955, 0), "Credit", 1L);
+        var tail = controller.AcquireSendCreditAsync(956, 0, 4, CancellationToken.None);
+        await head.AsTask().WaitAsync(TimeSpan.FromSeconds(5));
+        Ensure(!tail.IsCompleted && controller.SendConnectionCredit == 3,
+            "the earlier eligible waiter must consume its byte before the oversized tail tests connection credit");
+        controller.ReturnUnsentCredit(955, 0, 1);
+        await tail.AsTask().WaitAsync(TimeSpan.FromSeconds(5));
+        Ensure(controller.SendConnectionCredit == 0, "the tail must reserve only after four bytes become available");
+    }
+
+    [Test]
+    public async Task OrderedTailOptimizationMustNotPublishStateFromUnsuccessfulProbes()
+    {
+        var controller = new StreamFlowController(2, 4, 1024);
+        await controller.AcquireSendCreditAsync(957, 0, 2, CancellationToken.None);
+        using var cancellation = new CancellationTokenSource();
+        var head = controller.AcquireSendCreditAsync(957, 0, 1, cancellation.Token);
+        Ensure(!controller.TryAcquireSendCredit(958, 0, 1), "the keyed probe must still fail behind queued work");
+        Ensure(!controller.TryAcquireSendCreditLease(959, 0, 1, out var lease) && !lease.IsResolved,
+            "the first-lease probe must still fail without resolving a new state");
+        Ensure(controller.RetainedSendStreamCount == 1 && controller.ActiveSendStreamCount == 1 &&
+            controller.SendConnectionCredit == 2, "failed probes must publish no state and reserve no credit");
+        cancellation.Cancel();
+        await ExpectCancellation(head);
+        controller.ReturnUnsentCredit(957, 0, 2);
+    }
+
+    [Test]
+    public async Task OrderedTailFirstAdmissionShouldCaptureGenerationBeforePooledReuse()
+    {
+        var controller = new StreamFlowController(2, 6, 1024);
+        await controller.AcquireSendCreditAsync(960, 0, 2, CancellationToken.None);
+        using var cancellation = new CancellationTokenSource();
+        var head = controller.AcquireSendCreditAsync(960, 0, 1, cancellation.Token);
+        var admission = controller.AcquireSendCreditLeaseAsync(961, 0, 1, CancellationToken.None);
+        Ensure(admission.IsCompletedSuccessfully, "the first tail admission should complete inline");
+        var debited = controller.ResolveSendCreditLease(961, 0);
+        controller.ReturnUnsentCredit(in debited, 1);
+        controller.CompleteSendStream(961, 0);
+        var replacement = await controller.AcquireSendCreditLeaseAsync(961, 0, 1, CancellationToken.None);
+        var original = await admission;
+        Ensure(ReferenceEquals(original.State, replacement.State) && original.Generation != replacement.Generation &&
+            original.Generation == debited.Generation,
+            "the inline admission must retain the generation captured under the reserving gate");
+        controller.ReturnUnsentCredit(in original, 1);
+        Ensure(controller.SendConnectionCredit == 3, "the old lease must not refund the replacement's debit");
+        controller.ReturnUnsentCredit(in replacement, 1);
+        cancellation.Cancel();
+        await ExpectCancellation(head);
+        controller.ReturnUnsentCredit(960, 0, 2);
+    }
+
+    [Test]
+    public async Task OrderedTailShouldHonorPreCancellationAndKeepSuccessfulAdmissionAfterLaterCancellation()
+    {
+        var controller = new StreamFlowController(2, 4, 1024);
+        await controller.AcquireSendCreditAsync(962, 0, 2, CancellationToken.None);
+        using var headCancellation = new CancellationTokenSource();
+        using var tailCancellation = new CancellationTokenSource();
+        var head = controller.AcquireSendCreditAsync(962, 0, 1, headCancellation.Token);
+        tailCancellation.Cancel();
+        try
+        {
+            _ = controller.AcquireSendCreditLeaseAsync(963, 0, 1, tailCancellation.Token);
+            throw new Exception("expected pre-cancellation");
+        }
+        catch (OperationCanceledException)
+        {
+        }
+        Ensure(controller.RetainedSendStreamCount == 1 && controller.SendConnectionCredit == 2,
+            "a pre-canceled tail must not create state or reserve bytes");
+        using var afterAdmission = new CancellationTokenSource();
+        var admission = controller.AcquireSendCreditLeaseAsync(963, 0, 1, afterAdmission.Token);
+        Ensure(admission.IsCompletedSuccessfully, "the uncanceled eligible tail should complete inline");
+        afterAdmission.Cancel();
+        var lease = await admission;
+        Ensure(controller.SendConnectionCredit == 1 && !head.IsCompleted,
+            "cancellation after successful admission must neither refund it nor remove its predecessor");
+        controller.ReturnUnsentCredit(in lease, 1);
+        headCancellation.Cancel();
+        await ExpectCancellation(head);
+        controller.ReturnUnsentCredit(962, 0, 2);
+    }
+
+    private static long MeasureOrderedTailAdmissions(
+        StreamFlowController controller,
+        StreamFlowController.ResolvedSendCreditLease lease,
+        int admissionKind,
+        CancellationToken token,
+        int iterations)
+    {
+        var before = GC.GetAllocatedBytesForCurrentThread();
+        for (var index = 0; index < iterations; index++)
+        {
+            if (admissionKind == 2)
+            {
+                var admission = controller.AcquireSendCreditLeaseAsync(941, 0, 1, token);
+                Ensure(admission.IsCompletedSuccessfully, "first tail admission must complete inline");
+                var acquired = admission.GetAwaiter().GetResult();
+                Ensure(acquired.Generation == lease.Generation && ReferenceEquals(acquired.State, lease.State),
+                    "first tail admission must return the state that reserved credit");
+            }
+            else
+            {
+                var admission = admissionKind == 0
+                    ? controller.AcquireSendCreditAsync(941, 0, 1, token)
+                    : controller.AcquireSendCreditAsync(in lease, 1, token);
+                Ensure(admission.IsCompletedSuccessfully, "ordered tail admission must complete inline");
+                admission.GetAwaiter().GetResult();
+            }
+            controller.ReturnUnsentCredit(in lease, 1);
+        }
+        return GC.GetAllocatedBytesForCurrentThread() - before;
+    }
+
+    private static void SetTailTestField(object owner, string name, object? value)
+    {
+        var field = owner.GetType().GetField(name, BindingFlags.Instance | BindingFlags.Public | BindingFlags.NonPublic)
+            ?? throw new Exception($"tail test field {name} was not found");
+        field.SetValue(owner, value);
+    }
+}
