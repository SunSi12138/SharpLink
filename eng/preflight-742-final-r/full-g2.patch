+    private sealed class CountingCodec(bool sized) : IRpcCodec<Payload>, IRpcSizedCodec<Payload>
+    {
+        private readonly TaskCompletionSource<bool> _secondSnapshotReleased =
+            new(TaskCreationOptions.RunContinuationsAsynchronously);
+        internal Task SecondSnapshotReleased => _secondSnapshotReleased.Task;
+        internal int SerializeCount { get; private set; }
+        internal int ReleaseCount { get; private set; }
+        internal Action? AfterSerialize { get; set; }
+        internal bool Sized => sized;
+        public bool CanExactSize => sized;
+        public void Serialize(in Payload value, IBufferWriter<byte> buffer)
+        {
+            SerializeCount++;
+            buffer.GetSpan(value.Bytes)[..value.Bytes].Fill(0x5a);
+            buffer.Advance(value.Bytes);
+            AfterSerialize?.Invoke();
+        }
+        public Payload Deserialize(in ReadOnlySequence<byte> buffer) => new(checked((int)buffer.Length));
+        public bool TryGetEncodedSize(in Payload value, out int size) { size = value.Bytes; return sized; }
+        public bool TryGetEncodedSize(in Payload value, out int size, out IRpcSizedCodecSnapshot? snapshot)
+        {
+            size = value.Bytes;
+            snapshot = new Snapshot();
+            return sized;
+        }
+        public void SerializeSized(in Payload value, IBufferWriter<byte> buffer, int size, IRpcSizedCodecSnapshot? snapshot)
+        {
+            Ensure(snapshot is Snapshot { Released: false } && size == value.Bytes, "snapshot must remain live through serialization");
+            Serialize(in value, buffer);
+        }
+        public void ReleaseSnapshot(IRpcSizedCodecSnapshot? snapshot)
+        {
+            Ensure(snapshot is Snapshot { Released: false }, "snapshot must be released exactly once");
+            ((Snapshot)snapshot!).Released = true;
+            ReleaseCount++;
+            if (ReleaseCount == 2)
+                _secondSnapshotReleased.TrySetResult(true);
+        }
+        private sealed class Snapshot : IRpcSizedCodecSnapshot { internal bool Released; }
+    }
+
+    private sealed class Fixture : IAsyncDisposable
+    {
+        private readonly SharpLinkRuntimeContext _context;
+        private readonly Pipe _input = new();
+        private readonly Pipe _output = new();
+        internal RpcSession Session { get; }
+        internal StreamFlowController Controller =>
+            ((RpcSessionProtocolState)typeof(RpcSession).GetField("_protocolState", BindingFlags.Instance | BindingFlags.NonPublic)!
+                .GetValue(Session)!).FlowController!;
+        internal Fixture(int window, bool flowControl = true, int sendQueueBytes = 4 * 1024 * 1024)
+        {
+            _context = new SharpLinkRuntimeContextBuilder().Configure(options =>
+            {
+                options.FlowControl.MaxSendQueueBytes = sendQueueBytes;
+                options.FlowControl.MaxPreCreditSerializedBytes = Math.Max(1, window);
+            }).Build(includeGeneratedAssemblyCatalog: false);
+            Session = RpcSessionTestFixture.CreateSessionOverTestTransport(
+                "retained-send-result", _input.Reader, _output.Writer,
+                RpcSessionTestFixture.ServerOptions(_context), completeHandshake: false);
+            RpcSessionTestFixture.CompleteHandshake(Session,
+                flowControl ? ProtocolV2Capabilities.FlowControl : ProtocolV2Capabilities.None,
+                streamReceiveWindowBytes: window, connectionReceiveWindowBytes: window);
+        }
+        internal ValueTask<StreamFlowController.ResolvedSendCreditLease> First(CountingCodec codec, int bytes)
+            => Session.SendClientStreamChunkWithCreditLeaseAsync(1, 0, new Payload(bytes), codec,
+                codec.Sized ? codec : null, default, TimeProvider.System, CancellationToken.None, default);
+        internal ValueTask Retained(CountingCodec codec, int bytes, StreamFlowController.ResolvedSendCreditLease lease,
+            CancellationToken cancellationToken = default)
+            => Session.SendClientStreamChunkResolvedAsync(1, 0, new Payload(bytes), codec,
+                codec.Sized ? codec : null, default, TimeProvider.System, cancellationToken, lease);
+        internal void ReturnCredit(int bytes) => Session.ApplyWindowUpdate(1, new ProtocolV2WindowUpdate(0, checked((uint)bytes)));
+        internal async Task WaitForPreCreditCleanupAsync()
+        {
+            // Deadline abandonment deliberately observes the send separately. Wait for that
+            // owned cleanup condition rather than relying on a sleep or continuation ordering.
+            while (Session.PreCreditSerializedBytes != 0 || Session.PreCreditSerializedWaiterCount != 0)
+                await Task.Yield();
+        }
+        internal async Task<int> CountDataFramesAsync()
+        {
+            await Session.FlushSendQueueAsync().AsTask().WaitAsync(TimeSpan.FromSeconds(5));
+            var read = await _output.Reader.ReadAsync().AsTask().WaitAsync(TimeSpan.FromSeconds(5));
+            var remaining = read.Buffer;
+            var count = 0;
+            while (ProtocolV2FrameParser.TryReadFrame(ref remaining, _context.Protocol, out var header, out _))
+                if (header.Type == ProtocolV2FrameType.StreamData) count++;
+            Ensure(remaining.IsEmpty, "the output must contain complete frames");
+            _output.Reader.AdvanceTo(read.Buffer.End);
+            return count;
+        }
+        public async ValueTask DisposeAsync()
+        {
+            await Session.DisposeAsync();
+            await _output.Reader.CompleteAsync();
+            await _input.Writer.CompleteAsync();
+            _context.Dispose();
+        }
+    }
