@@ -0,0 +1,74 @@
+using System.Collections.Generic;
+using System.IO.Pipelines;
+using SharpLink.Client;
+
+namespace SharpLink.UnitTests.Client;
+
+public sealed class ClientStreamSendDisposalTests
+{
+    [Test]
+    [Arguments(false, false)]
+    [Arguments(false, true)]
+    [Arguments(true, false)]
+    [Arguments(true, true)]
+    public async Task FirstAndRetainedSendLoopShouldPreserveAsyncDisposalOwnership(bool moveFails, bool disposeFails)
+    {
+        await using var owner = ClientBuilderTestHelper.Build(new TestClientTransportFactory());
+        var context = (SharpLinkRuntimeContext)owner.RuntimeContext;
+        var input = new Pipe();
+        var output = new Pipe();
+        await using var session = RpcSessionTestFixture.CreateSessionOverTestTransport(
+            "client-send-disposal", input.Reader, output.Writer, RpcSessionTestFixture.ClientOptions(context));
+        using var lifetime = new CancellationTokenSource();
+        await using var connection = new ClientConnection(owner, session, lifetime, 8, context);
+        var codec = context.Codecs.GetCodec<int>();
+        _ = connection.PendingCalls.Rent(codec, PendingCallKind.ClientStreaming,
+            default, CancellationToken.None, out var requestId, hasResponsePayload: true, responseNullable: false);
+        var moveFailure = new InvalidOperationException("move failed");
+        var disposeFailure = new InvalidOperationException("dispose failed");
+        var producer = new Producer(moveFails ? moveFailure : null);
+        var send = connection.SendClientStreamAsync(requestId, 0, producer, codec);
+        await producer.DisposalStarted.Task.WaitAsync(TimeSpan.FromSeconds(5));
+        Ensure(producer.MoveCount == 3 && producer.DisposeCount == 1,
+            "the loop must send the first and retained item before disposing exactly once");
+        Ensure(!send.IsCompleted, "the sender must await asynchronous enumerator disposal");
+        if (disposeFails) producer.Disposal.TrySetException(disposeFailure);
+        else producer.Disposal.TrySetResult(true);
+        Exception? failure = null;
+        try { await send.WaitAsync(TimeSpan.FromSeconds(5)); }
+        catch (Exception exception) { failure = exception; }
+        var expected = disposeFails ? disposeFailure : moveFails ? moveFailure : null;
+        Ensure(ReferenceEquals(failure, expected), "disposal must preserve the compiler await-using exception precedence");
+        Ensure(producer.DisposeCount == 1, "fault propagation must not retry disposal");
+        await output.Reader.CompleteAsync();
+        await input.Writer.CompleteAsync();
+    }
+
+    private sealed class Producer(Exception? moveFailure) : IAsyncEnumerable<int>, IAsyncEnumerator<int>
+    {
+        internal TaskCompletionSource<bool> DisposalStarted { get; } = new(TaskCreationOptions.RunContinuationsAsynchronously);
+        internal TaskCompletionSource<bool> Disposal { get; } = new(TaskCreationOptions.RunContinuationsAsynchronously);
+        internal int MoveCount { get; private set; }
+        internal int DisposeCount { get; private set; }
+        public int Current => MoveCount;
+        public IAsyncEnumerator<int> GetAsyncEnumerator(CancellationToken cancellationToken = default) => this;
+        public ValueTask<bool> MoveNextAsync()
+        {
+            MoveCount++;
+            if (MoveCount < 3) return ValueTask.FromResult(true);
+            if (moveFailure is not null) return ValueTask.FromException<bool>(moveFailure);
+            return ValueTask.FromResult(false);
+        }
+        public ValueTask DisposeAsync()
+        {
+            DisposeCount++;
+            DisposalStarted.TrySetResult(true);
+            return new ValueTask(Disposal.Task);
+        }
+    }
+
+    private static void Ensure(bool condition, string message)
+    {
+        if (!condition) throw new InvalidOperationException(message);
+    }
+}
