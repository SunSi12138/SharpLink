--- /dev/null
+++ b/test/SharpLink.UnitTests/Client/ClientStreamValueTaskConsumptionTests.cs
@@ -0,0 +1,121 @@
+using System.Reflection;
+using System.Threading.Tasks.Sources;
+using SharpLink.Client;
+
+namespace SharpLink.UnitTests.Client;
+
+public sealed class ClientStreamValueTaskConsumptionTests
+{
+    private const BindingFlags Members = BindingFlags.Instance | BindingFlags.Public | BindingFlags.NonPublic;
+
+    [Test]
+    [Arguments("logical", false, false)]
+    [Arguments("logical", false, true)]
+    [Arguments("logical", true, false)]
+    [Arguments("logical", true, true)]
+    [Arguments("telemetry", false, false)]
+    [Arguments("telemetry", false, true)]
+    [Arguments("telemetry", true, false)]
+    [Arguments("telemetry", true, true)]
+    [Arguments("both", false, false)]
+    [Arguments("both", false, true)]
+    [Arguments("both", true, false)]
+    [Arguments("both", true, true)]
+    public async Task ClientWrappersConsumeEachValueTaskSourceExactlyOnce(
+        string wrapper, bool pending, bool result)
+    {
+        await using var client = ClientBuilderTestHelper.Build(new TestClientTransportFactory());
+        var source = new SingleConsumptionStream(pending, result);
+        IAsyncEnumerator<string> reader = source;
+        if (wrapper is "telemetry" or "both")
+            reader = CreateTelemetry(reader);
+        var logical = wrapper is "logical" or "both";
+        if (logical)
+        {
+            // Isolate the actual private wrapper, with the same one logical invocation
+            // that the production invoker hands to it. No network/scheduler race is needed.
+            typeof(SharpLinkClient).GetField("_activeLogicalInvocations", Members)!.SetValue(client, 1);
+            reader = CreateLogical(client, new ExistingEnumerator(reader)).GetAsyncEnumerator();
+        }
+        try
+        {
+            var move = reader.MoveNextAsync();
+            if (pending)
+            {
+                Require(!move.IsCompleted, "pending control must exercise the asynchronous wrapper");
+                source.Finish();
+            }
+            Require(await move == result, "the wrapper changed the underlying read result");
+            Require(source.ConsumptionCount == 1, "the underlying ValueTask source was consumed twice");
+            if (logical)
+                Require(((ISharpLinkClientDrainInspector)client).ActiveCallCount == (result ? 1 : 0),
+                    "logical completion must occur exactly once at the terminal result");
+        }
+        finally
+        {
+            source.ReleaseForCleanup();
+            await reader.DisposeAsync();
+        }
+        Require(source.DisposeCount == 1, "the wrapper must dispose the source once");
+        if (logical)
+            Require(((ISharpLinkClientDrainInspector)client).ActiveCallCount == 0,
+                "logical disposal must not double-complete call accounting");
+    }
+
+    private static IAsyncEnumerator<string> CreateTelemetry(IAsyncEnumerator<string> source)
+    {
+        var type = typeof(SharpLinkClient).GetNestedType("TelemetryAsyncEnumerator`1", BindingFlags.NonPublic)!
+            .MakeGenericType(typeof(string));
+        return (IAsyncEnumerator<string>)Activator.CreateInstance(type, Members, null,
+            [source, default(SharpLinkTelemetry.CallScope)], null)!;
+    }
+
+    private static IAsyncEnumerable<string> CreateLogical(SharpLinkClient client, IAsyncEnumerable<string> source)
+    {
+        var type = typeof(SharpLinkClient).GetNestedType("LogicalInvocationAsyncEnumerable`1", BindingFlags.NonPublic)!
+            .MakeGenericType(typeof(string));
+        return (IAsyncEnumerable<string>)Activator.CreateInstance(type, Members, null, [client, source], null)!;
+    }
+
+    private sealed class ExistingEnumerator(IAsyncEnumerator<string> source) : IAsyncEnumerable<string>
+    {
+        public IAsyncEnumerator<string> GetAsyncEnumerator(CancellationToken cancellationToken = default) => source;
+    }
+
+    private sealed class SingleConsumptionStream(bool pending, bool result) : IAsyncEnumerator<string>, IValueTaskSource<bool>
+    {
+        private ManualResetValueTaskSourceCore<bool> _core = new() { RunContinuationsAsynchronously = true };
+        private bool _finished;
+        internal int ConsumptionCount { get; private set; }
+        internal int DisposeCount { get; private set; }
+        public string Current => "value";
+        public ValueTask<bool> MoveNextAsync()
+        {
+            var move = new ValueTask<bool>(this, _core.Version);
+            if (!pending) Finish();
+            return move;
+        }
+        internal void Finish()
+        {
+            _finished = true;
+            _core.SetResult(result);
+        }
+        internal void ReleaseForCleanup() { if (!_finished) Finish(); }
+        public ValueTask DisposeAsync() { DisposeCount++; return ValueTask.CompletedTask; }
+        public bool GetResult(short token)
+        {
+            var value = _core.GetResult(token);
+            ConsumptionCount++;
+            _core.Reset(); // A legal reusable source invalidates a consumed result immediately.
+            return value;
+        }
+        public ValueTaskSourceStatus GetStatus(short token) => _core.GetStatus(token);
+        public void OnCompleted(Action<object?> continuation, object? state, short token, ValueTaskSourceOnCompletedFlags flags)
+            => _core.OnCompleted(continuation, state, token, flags);
+    }
+
+    private static void Require(bool condition, string message)
+    {
+        if (!condition) throw new InvalidOperationException(message);
+    }
+}
