+        var first = controller.AcceptReceivedAndResolveCreditLease(1121, 0, 1);
+        var second = controller.AcceptReceivedAndResolveCreditLease(1121, 0, 2);
+        Ensure(ReferenceEquals(first.State, existing.State) && first.Generation == existing.Generation &&
+            second.Generation == existing.Generation && States(controller).Count == 1,
+            "fused admission must preserve a live state rather than rent a replacement");
+        Ensure(Credit(controller) == 5 && StateCredit(existing.State!) == 1,
+            "each successful call debits exactly its supplied byte count");
+        Ensure(controller.RecordConsumed(in existing, 3) == 3 && controller.FlushConsumed(in existing) == 0,
+            "the same existing generation owns all three admitted bytes");
+    }
