+            Controller.Complete(new OperationCanceledException("fixture cleanup"));
+        }
+    }
+
+    private sealed class Consumer : IStreamReceiveCreditBoundDispatcher, IStreamDispatchLease
+    {
+        internal StreamManager.DispatcherEntry? Binding;
+        internal Func<int, ValueTask>? BeforeConsume;
+        internal Action<int>? AfterConsume;
+        internal int Installs, Clears, Dispatches, Drained;
+        internal readonly List<int> Order = [];
+        public void SetReceiveCreditBinding(StreamManager.DispatcherEntry? binding)
+        {
+            Binding = binding;
+            if (binding is null) Clears++; else Installs++;
+        }
+        public void BindDispatchState(IStreamDispatchState state) { }
+        public void OnDispatchesDrained()
+        {
+            Interlocked.Increment(ref Drained);
+            SetReceiveCreditBinding(null);
+        }
+        public ValueTask DispatchAcquiredAsync(ReadOnlySequence<byte> payload, int count) => DispatchAsync(payload, count);
+        public ValueTask DispatchAsync(ReadOnlySequence<byte> payload) => DispatchAsync(payload, checked((int)payload.Length));
+        public async ValueTask DispatchAsync(ReadOnlySequence<byte> payload, int count)
+        {
+            var binding = Binding;
+            Interlocked.Increment(ref Dispatches);
+            lock (Order) Order.Add(count);
+            if (BeforeConsume is { } before) await before(count);
+            binding?.RecordConsumed(count);
+            AfterConsume?.Invoke(count);
+        }
+        public void Complete(bool isError, string? errorMessage) { }
+        public void Complete(Exception? exception) { }
+    }
+}
