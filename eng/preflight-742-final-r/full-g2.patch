index 00000000..9646ed1c
--- /dev/null
+++ b/test/SharpLink.UnitTests/Runtime/StreamFlowFirstReceiveGateCountTests.cs
@@ -0,0 +1,73 @@
+using System.Linq;
+using System.Reflection;
+using System.Reflection.Emit;
+
+namespace SharpLink.UnitTests.Runtime;
+
+public class StreamFlowFirstReceiveGateCountTests
+{
+    [Test]
+    public void FirstReceiveShouldUseOneControllerGate()
+    {
+        const BindingFlags flags = BindingFlags.Instance | BindingFlags.NonPublic | BindingFlags.Public;
+        var type = typeof(StreamFlowController);
+        var fused = type.GetMethod("AcceptReceivedAndResolveCreditLease", flags);
+        var resolve = type.GetMethod("ResolveReceiveCreditLease", flags)!;
+        var accept = type.GetMethods(flags).Single(method => method.Name == "AcceptReceived" &&
+            method.GetParameters().Length == 2);
+        var originalCount = EnterScopeCount(resolve) + EnterScopeCount(accept);
+        var actualCount = fused is null ? originalCount : EnterScopeCount(fused);
+        var controller = new StreamFlowController(1, 1, 1024);
+        StreamFlowController.ResolvedReceiveCreditLease lease;
+        if (fused is null)
+        {
+            // Portable unchanged-N negative: run the complete old operation and count
+            // its actual two lock-enter instructions, rather than fail on method absence.
+            lease = controller.ResolveReceiveCreditLease(1120, 0);
+            controller.AcceptReceived(in lease, 1);
+        }
+        else
+        {
+            var admission = fused.CreateDelegate<Func<long, ushort, int,
+                StreamFlowController.ResolvedReceiveCreditLease>>(controller);
+            lease = admission(1120, 0, 1);
+        }
+        if (controller.RecordConsumed(in lease, 1) != 1 || controller.FlushConsumed(in lease) != 0)
+            throw new InvalidOperationException("the compared operation must debit and repay exactly one byte");
+        Console.WriteLine($"first receive gate entries: actual={actualCount}; original pair={originalCount}");
+        if (originalCount != 2 || actualCount != 1)
+            throw new InvalidOperationException($"first receive uses {actualCount} controller gates; expected exactly one");
+    }
+
+    private static int EnterScopeCount(MethodInfo method)
+    {
+        var codes = typeof(OpCodes).GetFields(BindingFlags.Public | BindingFlags.Static)
+            .Where(field => field.FieldType == typeof(OpCode))
+            .Select(field => (OpCode)field.GetValue(null)!)
+            .ToDictionary(code => code.Value);
+        var body = method.GetMethodBody()!.GetILAsByteArray()!;
+        var count = 0;
+        for (var offset = 0; offset < body.Length;)
+        {
+            var first = body[offset++];
+            var value = first == 0xfe ? unchecked((short)(0xfe00 | body[offset++])) : (short)first;
+            var code = codes[value];
+            if (code.OperandType == OperandType.InlineMethod)
+            {
+                var target = method.Module.ResolveMethod(BitConverter.ToInt32(body, offset));
+                if (target?.DeclaringType == typeof(Lock) && target.Name == "EnterScope")
+                    count++;
+            }
+            offset += code.OperandType switch
+            {
+                OperandType.InlineNone => 0,
+                OperandType.ShortInlineBrTarget or OperandType.ShortInlineI or OperandType.ShortInlineVar => 1,
+                OperandType.InlineVar => 2,
+                OperandType.InlineI8 or OperandType.InlineR => 8,
+                OperandType.InlineSwitch => 4 + 4 * BitConverter.ToInt32(body, offset),
+                _ => 4,
+            };
+        }
+        return count;
+    }
+}
diff --git a/test/SharpLink.UnitTests/Runtime/StreamManagerFirstReceiveAllocationTests.cs b/test/SharpLink.UnitTests/Runtime/StreamManagerFirstReceiveAllocationTests.cs
new file mode 100644
index 00000000..58d88e94
--- /dev/null
+++ b/test/SharpLink.UnitTests/Runtime/StreamManagerFirstReceiveAllocationTests.cs
@@ -0,0 +1,72 @@
+namespace SharpLink.UnitTests.Runtime;
+
+[NotInParallel("first-receive-allocation")]
+public sealed class StreamManagerFirstReceiveAllocationTests
+{
+    [Test]
+    [Arguments((ushort)0)]
+    [Arguments((ushort)7)]
+    public async Task PendingFirstDeliveryMustUseOneCompletionOwnerLikeSteadyDelivery(ushort streamId)
+    {
+        const int warmups = 64;
+        const int measurements = 64;
+        var controller = new StreamFlowController(8, 8, 1024, 1);
+        long consumed = 0, returned = 0;
+        void Accept(in StreamFlowController.ResolvedReceiveCreditLease lease, int bytes) => controller.AcceptReceived(in lease, bytes);
+        void Consume(in StreamFlowController.ResolvedReceiveCreditLease lease, int bytes)
+        {
+            consumed += bytes;
+            returned += controller.RecordConsumed(in lease, bytes);
+        }
+        var manager = new StreamManager(new RuntimeConcurrencyOptions(), null, null, null, 1, null,
+            null, Accept, Consume, lease => returned += controller.FlushConsumed(in lease),
+            (request, stream, bytes) => bytes == 0 ? controller.ResolveReceiveCreditLease(request, stream) :
+                controller.AcceptReceivedAndResolveCreditLease(request, stream, bytes));
+        var consumer = new PendingConsumer();
+        var payload = new ReadOnlySequence<byte>(new byte[] { 1 });
+        long firstBytes = 0, steadyBytes = 0;
+        for (var iteration = 0; iteration < warmups + measurements; iteration++)
+        {
+            manager.Register(9811, streamId, consumer);
+            consumer.Prepare();
+            var before = GC.GetAllocatedBytesForCurrentThread();
+            var first = manager.DispatchChunkAsync(9811, streamId, payload);
+            var firstAllocated = GC.GetAllocatedBytesForCurrentThread() - before;
+            Require(!first.IsCompleted, "first delivery must really suspend");
+            consumer.Resume();
+            await first.AsTask().WaitAsync(TimeSpan.FromSeconds(10));
+            consumer.Prepare();
+            before = GC.GetAllocatedBytesForCurrentThread();
+            var steady = manager.DispatchChunkAsync(9811, streamId, payload);
+            var steadyAllocated = GC.GetAllocatedBytesForCurrentThread() - before;
+            Require(!steady.IsCompleted, "steady control must really suspend");
+            consumer.Resume();
+            await steady.AsTask().WaitAsync(TimeSpan.FromSeconds(10));
+            manager.Unregister(9811, streamId);
+            if (iteration >= warmups) { firstBytes += firstAllocated; steadyBytes += steadyAllocated; }
+        }
+        Require(consumed == 2 * (warmups + measurements) && returned == consumed && manager.ActiveStreamCount == 0,
+            "both paths must preserve exact credit and lifetime ownership");
+        Console.WriteLine($"first receive pending allocation stream={streamId}: first={firstBytes}; steady={steadyBytes}; n={measurements}");
+        Require(firstBytes <= steadyBytes, "pending first delivery must not add a second completion state machine");
+        controller.Complete(new OperationCanceledException("allocation fixture cleanup"));
+    }
+
+    private sealed class PendingConsumer : IStreamReceiveCreditBoundDispatcher
+    {
+        private StreamManager.DispatcherEntry? _binding;
+        private TaskCompletionSource _pending = null!;
+        private int _bytes;
+        internal void Prepare() { _pending = new(TaskCreationOptions.RunContinuationsAsynchronously); _bytes = 0; }
+        internal void Resume() { _binding!.RecordConsumed(_bytes); _pending.SetResult(); }
+        public void SetReceiveCreditBinding(StreamManager.DispatcherEntry? binding) => _binding = binding;
+        public ValueTask DispatchAsync(ReadOnlySequence<byte> payload) => DispatchAsync(payload, 1);
+        public ValueTask DispatchAsync(ReadOnlySequence<byte> payload, int count) { _bytes = count; return new(_pending.Task); }
+        public void Complete(bool isError, string? errorMessage) { }
+        public void Complete(Exception? exception) { }
+    }
+    private static void Require(bool condition, string message)
+    {
+        if (!condition) throw new InvalidOperationException(message);
+    }
+}
