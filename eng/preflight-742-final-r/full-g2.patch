diff --git a/src/SharpLink.Runtime/StreamManager.EntryRetirement.cs b/src/SharpLink.Runtime/StreamManager.EntryRetirement.cs
new file mode 100644
index 00000000..1809bbe7
--- /dev/null
+++ b/src/SharpLink.Runtime/StreamManager.EntryRetirement.cs
@@ -0,0 +1,226 @@
+namespace SharpLink.Runtime;
+
+internal sealed partial class StreamManager
+{
+    internal sealed partial class DispatcherEntry
+    {
+        internal bool IsReceiveRetired => (Volatile.Read(ref _state) & ReceiveRetiredMask) != 0;
+
+        internal void RecordReceiveRetirementFailure(Exception exception)
+            => GetOrCreateCompletions().RecordReceiveRetirementFailure(exception);
+
+        internal void RouteRetirementFailuresToWaiter()
+            => Interlocked.Or(ref _state, AsyncRetirementMask);
+
+        internal void MarkReceiveRetired()
+        {
+            Interlocked.Or(ref _state, ReceiveRetirementReadyMask);
+            TryCompleteReceiveRetirement();
+        }
+
+        private void TryCompleteReceiveRetirement()
+        {
+            var state = Volatile.Read(ref _state);
+            if ((state & (ReceiveRetirementReadyMask | DetachedMask | DrainNotificationFinishedMask)) !=
+                    (ReceiveRetirementReadyMask | DetachedMask | DrainNotificationFinishedMask) ||
+                (state & (CountMask | CleanupMask)) != 0)
+                return;
+            Interlocked.Or(ref _state, ReceiveRetiredMask);
+            Volatile.Read(ref _completions)?.SignalReceiveRetired();
+        }
+
+        public ValueTask WaitForReceiveRetirementAsync(CancellationToken cancellationToken)
+        {
+            if ((Volatile.Read(ref _state) & ReceiveRetiredMask) != 0)
+            {
+                var failure = Volatile.Read(ref _completions)?.ReceiveRetirementFailure;
+                return failure is null ? ValueTask.CompletedTask : ValueTask.FromException(failure);
+            }
+            var completions = GetOrCreateCompletions();
+            if ((Volatile.Read(ref _state) & ReceiveRetiredMask) != 0)
+                completions.SignalReceiveRetired();
+            return completions.WaitForReceiveRetirementAsync(cancellationToken);
+        }
+
+        internal void Release()
+        {
+            var state = Interlocked.Decrement(ref _state);
+            if ((state & CountMask) == CountMask)
+                throw new InvalidOperationException("Stream dispatcher lease underflowed.");
+            if ((state & (ClosedMask | PeerTerminalReceivedMask)) != 0 && (state & CountMask) == 0)
+            {
+                // Only Close makes zero acquisitions monotonic. A retained peer-ended
+                // route can still acquire attachment/control work after a zero count.
+                if ((state & ClosedMask) != 0)
+                    Volatile.Read(ref _completions)?.SignalDispatchesDrained();
+                RunAfterDispatchesDrained();
+                TryNotifyDispatcherDrained();
+            }
+        }
+
+        internal void RequestPeerReceiveTerminal()
+        {
+            while (true)
+            {
+                var state = Volatile.Read(ref _state);
+                // Close transfers publication to the actual retirement owner. A pending
+                // peer request wins before Close (and pins that retirement), or loses this
+                // CAS and cannot start a competing publisher beside the drained fast path.
+                if ((state & (ClosedMask | PeerTerminalPendingMask | ReceiveTerminalPublishedMask)) != 0)
+                    return;
+                if (Interlocked.CompareExchange(ref _state, state | PeerTerminalPendingMask, state) == state)
+                    break;
+            }
+            RunAfterDispatchesDrained();
+        }
+
+        internal bool TryEnterDrainedRequestRetirement()
+        {
+            while (true)
+            {
+                var state = Volatile.Read(ref _state);
+                // Close excludes later DATA/control and later peer-publication scheduling.
+                // The same runner bit excludes a publisher already in flight.
+                if ((state & ClosedMask) == 0 || (state & (CountMask | CleanupMask)) != 0)
+                    return false;
+                if (Interlocked.CompareExchange(ref _state, state | DrainWorkRunningMask, state) == state)
+                    return true;
+            }
+        }
+
+        internal void ExitDrainedRequestRetirement()
+        {
+            Interlocked.And(ref _state, ~DrainWorkRunningMask);
+            TryNotifyDispatcherDrained();
+        }
+
+        internal void RequestStreamRetirement(bool clearCallback)
+        {
+            var flags = ReceiveRetirementPendingMask | StreamRetirementWorkMask;
+            if (clearCallback) flags |= ClearReceiveCallbackMask;
+            if ((Interlocked.Or(ref _state, flags) & ReceiveRetirementPendingMask) != 0)
+                throw new InvalidOperationException("Receive retirement already has a drain owner.");
+            RunAfterDispatchesDrained();
+        }
+
+        internal void RunWhenDispatchesDrained(Action continuation)
+            => SetDrainContinuation(continuation, recordFailureOnEntry: true);
+
+        internal void RunWhenRequestDispatchesDrained(Action continuation)
+            => SetDrainContinuation(continuation, recordFailureOnEntry: false);
+
+        private void SetDrainContinuation(Action continuation, bool recordFailureOnEntry)
+        {
+            if ((Interlocked.Or(ref _state, ReceiveRetirementPendingMask) & ReceiveRetirementPendingMask) != 0)
+                throw new InvalidOperationException("Receive retirement already has a drain owner.");
+            GetOrCreateCompletions().SetAfterDispatchesDrained(continuation, recordFailureOnEntry);
+            RunAfterDispatchesDrained();
+        }
+
+        // One runner orders receive-terminal publication before route retirement. Pending
+        // work pins pool return; callbacks execute outside registry, mailbox and flow locks.
+        private void RunAfterDispatchesDrained()
+        {
+            Exception? failure = null;
+            while (true)
+            {
+                var state = Volatile.Read(ref _state);
+                var completions = Volatile.Read(ref _completions);
+                if ((state & (CountMask | DrainWorkRunningMask)) != 0 ||
+                    (state & (PeerTerminalPendingMask | StreamRetirementWorkMask)) == 0 &&
+                    completions?.HasAfterDispatchesDrained != true)
+                    break;
+                if (Interlocked.CompareExchange(ref _state, state | DrainWorkRunningMask, state) != state)
+                    continue;
+                try
+                {
+                    if ((Volatile.Read(ref _state) & PeerTerminalPendingMask) != 0)
+                    {
+                        try
+                        {
+                            _owner?.PublishReceiveTerminal(_receiveCreditLease.RequestId,
+                                _receiveCreditLease.StreamId, this);
+                        }
+                        catch (Exception exception)
+                        {
+                            RecordReceiveRetirementFailure(exception);
+                            failure = exception;
+                        }
+                        finally { Interlocked.And(ref _state, ~PeerTerminalPendingMask); }
+                    }
+                    // A retained peer-ended route could acquire control/attachment work
+                    // while its publication callback ran. Actual retirement must recheck the
+                    // count after Close before consuming its one-shot work.
+                    var workState = Volatile.Read(ref _state);
+                    if ((workState & CountMask) == 0)
+                    {
+                        var streamWork = (workState & StreamRetirementWorkMask) != 0;
+                        var recordFailureOnEntry = true;
+                        var continuation = streamWork ? null :
+                            Volatile.Read(ref _completions)?.TakeAfterDispatchesDrained(out recordFailureOnEntry);
+                        if (streamWork || continuation is not null)
+                        {
+                            try
+                            {
+                                if (streamWork)
+                                    _owner!.FinishStreamRetirement(this, (workState & ClearReceiveCallbackMask) != 0);
+                                else
+                                    continuation!();
+                            }
+                            catch (Exception exception)
+                            {
+                                // Request finalization already records errors on each owning
+                                // entry. Its aggregate belongs to the request, not the last
+                                // entry that happens to release the group barrier.
+                                if (recordFailureOnEntry)
+                                    RecordReceiveRetirementFailure(exception);
+                                failure = failure is null ? exception : new AggregateException(failure, exception);
+                            }
+                            finally
+                            {
+                                Interlocked.And(ref _state,
+                                    ~(ReceiveRetirementPendingMask | StreamRetirementWorkMask | ClearReceiveCallbackMask));
+                            }
+                        }
+                    }
+                }
+                finally { Interlocked.And(ref _state, ~DrainWorkRunningMask); }
+                // A concurrent scheduler that found the runner active has already installed
+                // its work. Recheck after releasing the runner to avoid a lost notification.
+            }
+            TryNotifyDispatcherDrained();
+            if (failure is not null && (Volatile.Read(ref _state) & AsyncRetirementMask) == 0)
+                System.Runtime.ExceptionServices.ExceptionDispatchInfo.Capture(failure).Throw();
+        }
+
+        private void TryNotifyDispatcherDrained()
+        {
+            while (true)
+            {
+                var state = Volatile.Read(ref _state);
+                if ((state & DetachedMask) == 0 ||
+                    (state & (CountMask | CleanupMask | DrainNotifiedMask)) != 0)
+                    return;
+                if (Interlocked.CompareExchange(ref _state, state | DrainNotifiedMask, state) != state)
+                    continue;
+                try
+                {
+                    if (Dispatcher is IStreamDispatchLease lease)
+                        lease.OnDispatchesDrained();
+                }
+                catch (Exception exception)
+                {
+                    RecordReceiveRetirementFailure(exception);
+                    if ((Volatile.Read(ref _state) & AsyncRetirementMask) == 0)
+                        throw;
+                }
+                finally
+                {
+                    Interlocked.Or(ref _state, DrainNotificationFinishedMask);
+                    TryCompleteReceiveRetirement();
+                }
+                return;
+            }
+        }
+    }
+}
diff --git a/src/SharpLink.Runtime/StreamManager.FirstReceive.cs b/src/SharpLink.Runtime/StreamManager.FirstReceive.cs
new file mode 100644
index 00000000..577e4b53
--- /dev/null
+++ b/src/SharpLink.Runtime/StreamManager.FirstReceive.cs
@@ -0,0 +1,160 @@
+namespace SharpLink.Runtime;
+
+internal sealed partial class StreamManager
+{
+    internal enum ReceiveDispatchMode : byte { Ready, First, Pending }
+
+    private StreamFlowController.ResolvedReceiveCreditLease ResolveReceiveCreditForRegistration(long requestId, ushort streamId)
+        => _receiveCreditResolver switch
+        {
+            Func<long, ushort, StreamFlowController.ResolvedReceiveCreditLease> legacy => legacy(requestId, streamId),
+            Func<long, ushort, int, StreamFlowController.ResolvedReceiveCreditLease> fused => fused(requestId, streamId, 0),
+            _ => default
+        };
+
+    // Zero selects eager no-debit resolution only at registration. Actual DATA is always
+    // charged at least one byte, including an empty encoded payload.
+    // Every caller holds an entry acquisition. The first owner was elected by that
+    // acquisition, so neither terminal cleanup nor a later DATA can overtake it.
+    private ValueTask DispatchFirstReceiveAsync(DispatcherEntry entry,
+        ReadOnlySequence<byte> payload, int encodedBytes, ReceiveDispatchMode mode)
+    {
+        if (mode == ReceiveDispatchMode.Pending)
+            return AwaitFirstReceiveAndDispatchAsync(entry, payload, encodedBytes);
+
+        ArgumentOutOfRangeException.ThrowIfNegativeOrZero(encodedBytes);
+        ref readonly var key = ref entry.ReceiveCreditLease;
+        var resolver = (Func<long, ushort, int, StreamFlowController.ResolvedReceiveCreditLease>)_receiveCreditResolver!;
+        var lease = resolver(key.RequestId, key.StreamId, encodedBytes);
+        // The immutable entry reference was bound at registration. Publish its credit
+        // identity before exposing any bytes; no callback change can now fail/refund.
+        entry.InitializeReceiveCredit(lease);
+        // The caller publishes any synchronous failure, including payload-length failure
+        // before this method. Once delivery starts its dispatcher owns consumption.
+        return DispatchAfterReceiveCredit(entry.Dispatcher, payload, encodedBytes);
+    }
+
+    private static ValueTask CompleteReceiveDispatch(DispatcherEntry entry, ValueTask dispatch,
+        ReceiveDispatchMode mode)
+        => mode switch
+        {
+            ReceiveDispatchMode.First => CompleteFirstDispatch(entry, dispatch),
+            ReceiveDispatchMode.Pending => dispatch, // The waiting follower owns its release.
+            _ => CompleteDispatch(entry, dispatch)
+        };
+
+    private static ValueTask CompleteFirstDispatch(DispatcherEntry entry, ValueTask dispatch)
+    {
+        if (!dispatch.IsCompletedSuccessfully)
+            return AwaitFirstDispatchAsync(entry, dispatch);
+        try
+        {
+            try { dispatch.GetAwaiter().GetResult(); }
+            catch (Exception error)
+            {
+                entry.FailFirstReceive(error);
+                throw;
+            }
+            entry.PublishFirstReceive();
+        }
+        finally { entry.Release(); }
+        return ValueTask.CompletedTask;
+    }
+
+    // One completion owner consumes the actual dispatcher result, publishes the initial
+    // FIFO boundary and releases the acquisition. Do not nest this in AwaitDispatchAsync.
+    private static async ValueTask AwaitFirstDispatchAsync(DispatcherEntry entry, ValueTask dispatch)
+    {
+        try
+        {
+            try { await dispatch.ConfigureAwait(false); }
+            catch (Exception error)
+            {
+                entry.FailFirstReceive(error);
+                throw;
+            }
+            entry.PublishFirstReceive();
+        }
+        finally { entry.Release(); }
+    }
+
+    private async ValueTask AwaitFirstReceiveAndDispatchAsync(DispatcherEntry entry,
+        ReadOnlySequence<byte> payload, int encodedBytes)
+    {
+        try
+        {
+            await entry.WaitForFirstReceiveAsync().ConfigureAwait(false);
+            if (entry.ReceiveCreditLease.IsResolved)
+                _acceptResolvedBytes!(in entry.ReceiveCreditLease, encodedBytes);
+            else
+                _acceptBytes?.Invoke(entry.ReceiveCreditLease.RequestId, entry.ReceiveCreditLease.StreamId, encodedBytes);
+            await DispatchAfterReceiveCredit(entry.Dispatcher, payload, encodedBytes).ConfigureAwait(false);
+        }
+        finally { entry.Release(); }
+    }
+
+    private static ValueTask DispatchAfterReceiveCredit(IStreamDispatcher dispatcher,
+        ReadOnlySequence<byte> payload, int encodedBytes)
+        => dispatcher is IStreamDispatchLease leased
+            ? leased.DispatchAcquiredAsync(payload, encodedBytes)
+            : ((IStreamConsumptionAwareDispatcher)dispatcher).DispatchAsync(payload, encodedBytes);
+
+    internal sealed partial class DispatcherEntry
+    {
+        private const long ReceiveDeferredMask = 1L << 48;
+        private const long FirstReceiveStartedMask = 1L << 49;
+        private const long FirstReceivePublishedMask = 1L << 50;
+
+        internal void DeferFirstReceive() => Interlocked.Or(ref _state, ReceiveDeferredMask);
+
+        internal void PublishFirstReceive()
+        {
+            Interlocked.Or(ref _state, FirstReceivePublishedMask);
+            Volatile.Read(ref _completions)?.SignalFirstReceive(null);
+        }
+
+        internal void FailFirstReceive(Exception error)
+            => GetOrCreateCompletions().SignalFirstReceive(error);
+
+        internal ValueTask WaitForFirstReceiveAsync()
+        {
+            var completions = GetOrCreateCompletions();
+            if ((Volatile.Read(ref _state) & FirstReceivePublishedMask) != 0)
+                completions.SignalFirstReceive(null);
+            return completions.WaitForFirstReceiveAsync();
+        }
+
+        private sealed partial class DispatcherEntryCompletions
+        {
+            private int _firstReceiveSignaled;
+            private Exception? _firstReceiveError;
+            private TaskCompletionSource? _firstReceiveCompletion;
+
+            internal void SignalFirstReceive(Exception? error)
+            {
+                if (error is not null) _firstReceiveError = error;
+                // Fence the signal store before loading a concurrently installed TCS.
+                // A release store alone permits both sides to miss the other's write.
+                Interlocked.Exchange(ref _firstReceiveSignaled, 1);
+                CompleteFirstReceive(Volatile.Read(ref _firstReceiveCompletion));
+            }
+
+            internal ValueTask WaitForFirstReceiveAsync()
+            {
+                if (Volatile.Read(ref _firstReceiveSignaled) != 0)
+                    return _firstReceiveError is { } error
+                        ? ValueTask.FromException(error) : ValueTask.CompletedTask;
+                var completion = GetOrCreateCompletion(ref _firstReceiveCompletion);
+                if (Volatile.Read(ref _firstReceiveSignaled) != 0)
+                    CompleteFirstReceive(completion);
+                return new ValueTask(completion.Task);
+            }
+
+            private void CompleteFirstReceive(TaskCompletionSource? completion)
+            {
+                if (_firstReceiveError is { } error) completion?.TrySetException(error);
+                else completion?.TrySetResult();
+            }
+        }
+    }
+}
