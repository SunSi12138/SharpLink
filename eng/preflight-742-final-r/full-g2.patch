@@ -0,0 +1,90 @@
+using System.IO.Pipelines;
+using System.Linq;
+using SharpLink.Client;
+using SharpLink.UnitTests.Runtime;
+
+namespace SharpLink.UnitTests.Client;
+
+public partial class ClientConnectionConsumerAbandonmentTests
+{
+    [Test]
+    public async Task ConsumerCancelMustWaitBeyondLogicalDetachUntilReceivePublicationCompletes()
+    {
+        await using var owner = ClientBuilderTestHelper.Build(new TestClientTransportFactory());
+        var runtime = (SharpLinkRuntimeContext)owner.RuntimeContext;
+        var input = new Pipe();
+        var output = new Pipe();
+        await using var session = RpcSessionTestFixture.CreateSessionOverTestTransport(
+            "consumer-retirement-credit-order", input.Reader, output.Writer,
+            RpcSessionTestFixture.ClientOptions(runtime), completeHandshake: false);
+        RpcSessionTestFixture.CompleteHandshake(session,
+            ProtocolV2Capabilities.FlowControl | ProtocolV2Capabilities.CancellationReason,
+            streamReceiveWindowBytes: 4, connectionReceiveWindowBytes: 4);
+        using var cancellation = new CancellationTokenSource();
+        await using var connection = new ClientConnection(owner, session, cancellation, 8, runtime);
+        var dispatcher = new RetirementGateDispatcher();
+        const long requestId = 9650;
+        session.StreamManager.Register(requestId, dispatcher);
+        var dispatch = session.StreamManager.DispatchChunkAsync(requestId,
+            new ReadOnlySequence<byte>(new byte[] { 1 }));
+        session.StreamManager.Unregister(requestId);
+        Ensure(dispatcher.State.IsDetached, "logical detach must retain its immediate existing contract");
+        using var publishing = new ManualResetEventSlim();
+        using var release = new ManualResetEventSlim();
+        var finalRelease = Task.Run(() =>
+        {
+            StreamManagerTestHooks.BeforeReceiveTerminalPublish = (_, _) =>
+            {
+                publishing.Set();
+                if (!release.Wait(RaceCoordinationTimeout)) throw new TimeoutException("Missing final-credit release.");
+            };
+            try { dispatcher.Release(); }
+            finally { StreamManagerTestHooks.BeforeReceiveTerminalPublish = null; }
+        });
+        ValueTask abandonment = default;
+        try
+        {
+            Ensure(publishing.Wait(RaceCoordinationTimeout), "the final credit callback must be paused");
+            Ensure(dispatcher.State.WaitForDispatchesDrainedAsync().IsCompletedSuccessfully,
+                "DATA-drained and receive-retired are deliberately distinct barriers");
+            abandonment = connection.OnConsumerAbandonedAsync(requestId, dispatcher.State);
+            Ensure(!abandonment.IsCompleted,
+                "logical detach alone must not allow Cancel to overtake final receive credit");
+        }
+        finally { release.Set(); }
+        await finalRelease.WaitAsync(RaceCoordinationTimeout);
+        await dispatch;
+        await abandonment;
+        var frames = await FlushAndReadFramesAsync(session, output);
+        Ensure(frames.Where(frame => frame.RequestId == requestId).Select(frame => frame.Type)
+                .SequenceEqual([ProtocolV2FrameType.WindowUpdate, ProtocolV2FrameType.Cancel]),
+            "final WindowUpdate must enter the writer before consumer Cancel");
+    }
+
+    private sealed class RetirementGateDispatcher : IStreamConsumptionAwareDispatcher, IStreamDispatchLease
+    {
+        private readonly TaskCompletionSource _completion = new();
+        private Action<long, ushort, int>? _consumed;
+        private long _requestId;
+        private ushort _streamId;
+        internal IStreamDispatchState State { get; private set; } = null!;
+        public void BindDispatchState(IStreamDispatchState state) => State = state;
+        public void OnDispatchesDrained() { }
+        public ValueTask DispatchAsync(ReadOnlySequence<byte> payload) => new(_completion.Task);
+        public ValueTask DispatchAsync(ReadOnlySequence<byte> payload, int encodedByteCount) => DispatchAsync(payload);
+        public ValueTask DispatchAcquiredAsync(ReadOnlySequence<byte> payload, int encodedByteCount) => DispatchAsync(payload);
+        internal void Release()
+        {
+            _consumed?.Invoke(_requestId, _streamId, 1);
+            _completion.SetResult();
+        }
+        public void Complete(bool isError, string? errorMessage) { }
+        public void Complete(Exception? exception) { }
+        public void SetBytesConsumedCallback(Action<long, ushort, int>? callback, long requestId, ushort streamId)
+        {
+            _consumed = callback;
+            _requestId = requestId;
+            _streamId = streamId;
+        }
+    }
+}
