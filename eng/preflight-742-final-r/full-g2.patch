+        Ensure(ReferenceEquals(current.State, stale.State) && current.Generation != stale.Generation,
+            "the test must reuse both the same key and pooled object with a new generation");
+        ExpectCode(() => controller.AcceptReceived(in stale, 1), SharpLinkErrorCode.ConnectionClosed);
+        Ensure(controller.RecordConsumed(in stale, 1) == 0 && controller.FlushConsumed(in stale) == 0,
+            "stale cleanup cannot refund or complete the replacement");
+        Ensure(Credit(controller) == 7, "replacement debit remains owned");
+        Ensure(controller.RecordConsumed(in current, 1) == 0 && controller.FlushConsumed(in current) == 1,
+            "replacement returns its own byte once at completion");
+    }
+
+    [Test]
+    public void ForeignOwnerAndForgedGenerationMustNotReachTheFirstDebit()
+    {
+        var controller = new StreamFlowController(2, 4, 1024);
+        var other = new StreamFlowController(2, 4, 1024);
+        var valid = controller.AcceptReceivedAndResolveCreditLease(1110, 0, 1);
+        StreamFlowController.ResolvedReceiveCreditLease[] invalid =
+        [
+            default,
+            new(other, 1110, 0, valid.State!, valid.Generation),
+            new(controller, 1110, 0, valid.State!, valid.Generation + 1),
+            new(controller, 1110, 0, new object(), valid.Generation),
+        ];
+        foreach (var lease in invalid)
+        {
+            ExpectCode(() => controller.AcceptReceived(in lease, 1), SharpLinkErrorCode.ConnectionClosed);
+            Ensure(controller.RecordConsumed(in lease, 1) == 0 && controller.FlushConsumed(in lease) == 0,
+                "an invalid handle must never return or retire the first debit");
+        }
+        ExpectCode(() => other.AcceptReceived(in valid, 1), SharpLinkErrorCode.ConnectionClosed);
+        Ensure(Credit(controller) == 3 && Credit(other) == 4, "foreign accesses preserve both ledgers");
+        Ensure(controller.RecordConsumed(in valid, 1) == 1, "valid captured ownership still works");
+    }
+
+    [Test]
+    [Arguments(false)]
+    [Arguments(true)]
+    public void FailedDictionaryInsertionShouldReturnRentedStateWithoutDebit(bool warmPool)
+    {
+        var controller = new StreamFlowController(2, 4, 1024);
+        object? pooled = null;
+        if (warmPool)
+        {
+            var warm = controller.AcceptReceivedAndResolveCreditLease(1111, 0, 1);
+            controller.RecordConsumed(in warm, 1);
+            controller.FlushConsumed(in warm);
+            pooled = warm.State;
+        }
+        var statesField = typeof(StreamFlowController).GetField("_receiveStates", BindingFlags.Instance | BindingFlags.NonPublic)!;
+        var original = statesField.GetValue(controller)!;
+        var generation = (long)Field(controller, "_receiveStateLeaseCounter")!;
+        var error = new InvalidOperationException("injected receive dictionary insert failure");
+        var factory = typeof(StreamFlowControllerFirstReceiveTests).GetMethod(
+            nameof(CreateThrowingDictionary), BindingFlags.Static | BindingFlags.NonPublic)!;
+        var replacement = factory.MakeGenericMethod(statesField.FieldType.GenericTypeArguments)
+            .Invoke(null, [error])!;
+        statesField.SetValue(controller, replacement);
+        try
+        {
+            ExpectSame(() => controller.AcceptReceivedAndResolveCreditLease(1112, 0, 1), error);
+            var returned = Field(controller, "_pooledReceiveStates");
+            Ensure(returned is not null && (!warmPool || ReferenceEquals(returned, pooled)),
+                "failed insertion must return exactly the rented state to the local pool");
+            Ensure((long)Field(controller, "_receiveStateLeaseCounter")! == generation + 1,
+                "the injected failure must occur after rent, not during the empty lookup");
+            Ensure(!(bool)Field(returned!, "Attached")! && (bool)Field(returned!, "Completed")! &&
+                StateCredit(returned!) == 2 && (long)Field(returned!, "PendingConsumed")! == 0,
+                "returned state must satisfy every pool invariant");
+            Ensure(States(controller).Count == 0 && Credit(controller) == 4 &&
+                (int)Field(controller, "_pooledReceiveStateOverflowCount")! == 0,
+                "failed insertion cannot consume capacity, credit or an extra pool slot");
+        }
+        finally { statesField.SetValue(controller, original); }
+        var admitted = controller.AcceptReceivedAndResolveCreditLease(1112, 0, 1);
+        Ensure(admitted.IsResolved && Credit(controller) == 3,
+            "restored ownership must allow the next ordinary first admission");
+    }
+
+    [Test]
+    public void TerminalWinningTheGateMustRejectWithoutPublishingALease()
+    {
+        var controller = new StreamFlowController(2, 4, 1024);
+        var terminal = new InvalidOperationException("first receive terminal");
+        var captured = default(StreamFlowController.ResolvedReceiveCreditLease);
+        Exception? failure = null;
+        using var started = new ManualResetEventSlim();
+        var worker = new Thread(() =>
+        {
+            started.Set();
+            try { captured = controller.AcceptReceivedAndResolveCreditLease(1113, 0, 1); }
+            catch (Exception error) { failure = error; }
+        })
+        { IsBackground = true };
+        using (((Lock)Field(controller, "_gate")!).EnterScope())
+        {
+            worker.Start();
+            Ensure(started.Wait(TimeSpan.FromSeconds(5)), "first DATA worker must start");
+            controller.Complete(terminal);
+        }
+        Ensure(worker.Join(TimeSpan.FromSeconds(5)), "first DATA must stop after terminal wins");
+        Ensure(ReferenceEquals(failure, terminal) && !captured.IsResolved,
+            "first DATA must preserve the first terminal and publish no lease");
+        Ensure(States(controller).Count == 0 && Credit(controller) == 4,
+            "a terminal admission cannot rent or debit state");
+        ExpectSame(() => controller.AcceptReceivedAndResolveCreditLease(1114, 0, 1), terminal);
+    }
+
+    [Test]
+    [Arguments(false)]
+    [Arguments(true)]
+    public void WarmFirstReceiveLifecycleShouldStayAllocationFree(bool fused)
+    {
+        var controller = new StreamFlowController(1, 1, 1024);
+        MeasureLifecycles(controller, fused, 1024);
+        var allocated = MeasureLifecycles(controller, fused, 10000);
+        Console.WriteLine($"first receive fused={fused}: {allocated} bytes / 10000 complete lifecycles");
+        Ensure(allocated == 0 && Credit(controller) == 1 && States(controller).Count == 0,
+            "fused admission must preserve the original warm lifecycle allocation budget");
+    }
+
+    private static long MeasureLifecycles(StreamFlowController controller, bool fused, int iterations)
+    {
+        var before = GC.GetAllocatedBytesForCurrentThread();
+        for (var index = 0; index < iterations; index++)
+        {
+            var lease = fused ? controller.AcceptReceivedAndResolveCreditLease(1115, 0, 1) :
+                controller.ResolveReceiveCreditLease(1115, 0);
+            if (!fused)
+                controller.AcceptReceived(in lease, 1);
+            if (controller.RecordConsumed(in lease, 1) != 1 || controller.FlushConsumed(in lease) != 0)
+                throw new InvalidOperationException("first receive lifecycle lost or duplicated a byte");
+        }
+        return GC.GetAllocatedBytesForCurrentThread() - before;
+    }
+
+    private static object CreateThrowingDictionary<TKey, TValue>(Exception error) where TKey : notnull
+        => new Dictionary<TKey, TValue>(new ThrowingHashComparer<TKey>(error));
+
+    private sealed class ThrowingHashComparer<T>(Exception error) : IEqualityComparer<T>
+    {
+        public bool Equals(T? left, T? right) => EqualityComparer<T>.Default.Equals(left, right);
+        public int GetHashCode(T value) => throw error;
+    }
+
+    private static IDictionary States(StreamFlowController controller)
+        => (IDictionary)Field(controller, "_receiveStates")!;
+    private static long Credit(StreamFlowController controller)
+        => (long)Field(controller, "_receiveConnectionCredit")!;
+    private static long StateCredit(object state) => (long)Field(state, "Credit")!;
+    private static object? Field(object owner, string name)
+        => owner.GetType().GetField(name, BindingFlags.Instance | BindingFlags.Public | BindingFlags.NonPublic)?.GetValue(owner);
+    private static void ExpectCode(Action action, SharpLinkErrorCode code)
+    {
+        try { action(); }
+        catch (SharpLinkException error) when (error.Code == code) { return; }
+        throw new InvalidOperationException($"expected {code}");
+    }
+    private static void ExpectSame(Action action, Exception expected)
+    {
+        try { action(); }
+        catch (Exception error) when (ReferenceEquals(error, expected)) { return; }
+        throw new InvalidOperationException("expected original exception");
+    }
+    private static void Ensure(bool condition, string message)
+    {
+        if (!condition)
+            throw new InvalidOperationException(message);
+    }
+}
