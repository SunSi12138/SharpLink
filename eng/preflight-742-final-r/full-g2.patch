+++ b/test/SharpLink.UnitTests/Runtime/StreamManagerRetainedPeerTerminalTests.cs
@@ -0,0 +1,51 @@
+namespace SharpLink.UnitTests.Runtime;
+
+public sealed class StreamManagerRetainedPeerTerminalTests
+{
+    [Test]
+    public async Task RetainedPeerTerminalMustWaitForAlreadyAcquiredDataBeforeReceiveFlush()
+    {
+        var timeout = TimeSpan.FromSeconds(10);
+        var controller = new StreamFlowController(4, 4, 1024, 1);
+        using var beforeDebit = new ManualResetEventSlim();
+        using var releaseDebit = new ManualResetEventSlim();
+        var terminalCalls = 0;
+        var returned = 0;
+        void Accept(in StreamFlowController.ResolvedReceiveCreditLease lease, int count)
+        {
+            beforeDebit.Set();
+            if (!releaseDebit.Wait(timeout)) throw new TimeoutException("Missing debit release.");
+            controller.AcceptReceived(in lease, count);
+        }
+        void Consume(in StreamFlowController.ResolvedReceiveCreditLease lease, int count)
+            => Interlocked.Add(ref returned, controller.RecordConsumed(in lease, count));
+        void Terminal(StreamFlowController.ResolvedReceiveCreditLease lease)
+        {
+            Interlocked.Increment(ref terminalCalls);
+            Interlocked.Add(ref returned, controller.FlushConsumed(in lease));
+        }
+        var manager = new StreamManager(new RuntimeConcurrencyOptions(), null, null, null, 1, null,
+            controller.ResolveReceiveCreditLease, Accept, Consume, Terminal);
+        var buffers = new SharpLinkBufferWriterPool(new BufferWriterPoolOptions());
+        manager.ReservePreAdmissionStreams(9620, 1, buffers, _ => true, _ => { },
+            () => throw new InvalidOperationException("Unexpected capacity exhaustion."),
+            retainUntilLocalCompletion: true);
+        var dispatch = Task.Run(async () => await manager.DispatchChunkAsync(9620, 1,
+            new ReadOnlySequence<byte>(new byte[] { 1 })));
+        var prematurelyPublished = false;
+        try
+        {
+            if (!beforeDebit.Wait(timeout)) throw new TimeoutException("Missing acquired DATA.");
+            manager.CompletePeerStream(9620, 1, exception: null);
+            prematurelyPublished = Volatile.Read(ref terminalCalls) != 0;
+        }
+        finally { releaseDebit.Set(); }
+        await dispatch.WaitAsync(timeout);
+        if (prematurelyPublished || terminalCalls != 1 || returned != 1)
+            throw new InvalidOperationException(
+                "Retained peer terminal must wait for acquired DATA, then return its exact credit once.");
+        manager.AbandonExistingRequestStreams(9620, 1);
+        if (manager.ActiveStreamCount != 0)
+            throw new InvalidOperationException("Local completion must retire the terminal retained route.");
+    }
+}
diff --git a/test/SharpLink.UnitTests/Runtime/StreamManagerRetirementFailureTests.cs b/test/SharpLink.UnitTests/Runtime/StreamManagerRetirementFailureTests.cs
new file mode 100644
index 00000000..88452e26
--- /dev/null
+++ b/test/SharpLink.UnitTests/Runtime/StreamManagerRetirementFailureTests.cs
@@ -0,0 +1,215 @@
+namespace SharpLink.UnitTests.Runtime;
+
+public sealed class StreamManagerRetirementFailureTests
+{
+    private static readonly TimeSpan Timeout = TimeSpan.FromSeconds(10);
+
+    [Test]
+    public async Task RequestRetirementMustObserveIdleFailureWhileJoiningPriorRetirement()
+    {
+        var expected = new InvalidOperationException("idle dispatcher drain failed");
+        var manager = new StreamManager();
+        var blocked = new DrainDispatcher(blockDispatch: true);
+        var idle = new DrainDispatcher(onDrained: () => throw expected);
+        manager.Register(9660, 1, blocked);
+        manager.Register(9660, 2, idle);
+        var dispatch = manager.DispatchChunkAsync(9660, 1, new ReadOnlySequence<byte>(new byte[] { 1 }));
+        manager.Unregister(9660, 1);
+        var retiring = manager.CompleteRequestStreamsAfterDispatchesAsync(9660, exception: null);
+        Require(!retiring.IsCompleted, "request retirement must join the prior stream retirement");
+        blocked.Release();
+        await dispatch.AsTask().WaitAsync(Timeout);
+        Exception? observed = null;
+        try { await retiring.AsTask().WaitAsync(Timeout); }
+        catch (Exception exception) { observed = exception; }
+        Require(ReferenceEquals(observed, expected), "the newly retired idle stream's error must not be lost");
+        Require(manager.ActiveStreamCount == 0 && blocked.DrainCount == 1 && idle.DrainCount == 1,
+            "both retirement owners must finish exactly once");
+    }
+
+    [Test]
+    public async Task RetirementCompletionMustWaitForDrainNotificationOutcome()
+    {
+        var expected = new InvalidOperationException("paused drain notification failed");
+        using var entered = new ManualResetEventSlim();
+        using var release = new ManualResetEventSlim();
+        var dispatcher = new DrainDispatcher(onDrained: () =>
+        {
+            entered.Set();
+            if (!release.Wait(Timeout)) throw new TimeoutException("Missing notification release.");
+            throw expected;
+        });
+        var manager = new StreamManager();
+        manager.Register(9661, dispatcher);
+        var retirement = Task.Run(async () => await manager.CompleteStreamAfterDispatchesAsync(9661, 0, null));
+        ValueTask joined = default;
+        try
+        {
+            Require(entered.Wait(Timeout), "notification must be executing");
+            // Duplicate finalization observations are harmless; started notification is not
+            // a completed outcome even when every other condition has become terminal.
+            ((StreamManager.DispatcherEntry)dispatcher.State).MarkReceiveRetired();
+            joined = dispatcher.State.WaitForReceiveRetirementAsync(CancellationToken.None);
+            Require(!joined.IsCompleted, "retirement must not publish success while notification can still fail");
+        }
+        finally { release.Set(); }
+        foreach (var wait in new[] { retirement, joined.AsTask() })
+        {
+            Exception? observed = null;
+            try { await wait.WaitAsync(Timeout); }
+            catch (Exception exception) { observed = exception; }
+            Require(ReferenceEquals(observed, expected), "all retirement waiters must observe the final error");
+        }
+        Require(dispatcher.DrainCount == 1, "notification must keep exactly one owner");
+    }
+
+    [Test]
+    [Arguments(false)]
+    [Arguments(true)]
+    public async Task ConcurrentRetirementJoinerMustObserveDirectCallbackCleanupFailure(bool failureDuringComplete)
+    {
+        var expected = new InvalidOperationException("direct callback cleanup failed");
+        using var entered = new ManualResetEventSlim();
+        using var release = new ManualResetEventSlim();
+        var manager = new StreamManager();
+        var dispatcher = new ClearingFailureDispatcher(() =>
+        {
+            entered.Set();
+            if (!release.Wait(Timeout)) throw new TimeoutException("Missing cleanup release.");
+            throw expected;
+        }, failureDuringComplete);
+        manager.Register(9662, dispatcher);
+        var first = Task.Run(async () => await manager.CompleteStreamAfterDispatchesAsync(9662, 0, null));
+        ValueTask second = default;
+        try
+        {
+            Require(entered.Wait(Timeout), "first retirement must be inside direct callback cleanup");
+            second = manager.CompleteStreamAfterDispatchesAsync(9662, 0, null);
+            Require(!second.IsCompleted, "second retirement must join the captured in-progress owner");
+        }
+        finally { release.Set(); }
+        foreach (var wait in new[] { first, second.AsTask() })
+        {
+            Exception? observed = null;
+            try { await wait.WaitAsync(Timeout); }
+            catch (Exception exception) { observed = exception; }
+            Require(ReferenceEquals(observed, expected), "owner and joiner must preserve the same cleanup failure");
+        }
+    }
+
+    [Test]
+    public async Task DeferredRequestRetirementMustReportEachDistinctFailureOnce()
+    {
+        var firstFailure = new InvalidOperationException("first cleanup failed");
+        var secondFailure = new InvalidOperationException("second cleanup failed");
+        var first = new ClearingFailureDispatcher(() => throw firstFailure, blockDispatch: true);
+        var second = new ClearingFailureDispatcher(() => throw secondFailure);
+        var manager = new StreamManager();
+        manager.Register(9663, 1, first);
+        manager.Register(9663, 2, second);
+        var dispatch = manager.DispatchChunkAsync(9663, 1, new ReadOnlySequence<byte>(new byte[] { 1 }));
+        var retirement = manager.CompleteRequestStreamsAfterDispatchesAsync(9663, exception: null);
+        first.Release();
+        await dispatch;
+        Exception? observed = null;
+        try { await retirement.AsTask().WaitAsync(Timeout); }
+        catch (Exception exception) { observed = exception; }
+        Require(observed is AggregateException, "two distinct cleanup failures must be aggregated");
+        var leaves = ((AggregateException)observed!).Flatten().InnerExceptions;
+        Require(leaves.Count == 2 && leaves.Contains(firstFailure) && leaves.Contains(secondFailure),
+            "group completion must not duplicate failures into the last entry's result");
+    }
+
+    [Test]
+    public void ClosedRetirementOwnerMustExcludeALatePeerPublicationRequest()
+    {
+        var publications = 0;
+        var manager = new StreamManager(new RuntimeConcurrencyOptions(), null, null,
+            (_, _) => publications++);
+        var dispatcher = new DrainDispatcher();
+        manager.Register(9664, dispatcher);
+        dispatcher.State.Close();
+        ((StreamManager.DispatcherEntry)dispatcher.State).RequestPeerReceiveTerminal();
+        Require(publications == 0, "a peer request after Close must defer to the actual retirement owner");
+        manager.Unregister(9664);
+        Require(publications == 1, "the actual retirement owner must publish exactly once");
+        manager.Register(9664, new DrainDispatcher());
+        manager.Unregister(9664);
+        Require(publications == 2, "the retired key must admit a distinct replacement generation");
+    }
+
+    [Test]
+    [Arguments(false)]
+    [Arguments(true)]
+    public async Task RequestRetirementMustRollBackAnIdlePinBeforeJoiningBlockedData(bool asynchronous)
+    {
+        var publications = 0;
+        var manager = new StreamManager(new RuntimeConcurrencyOptions(), null, null,
+            (_, _) => Interlocked.Increment(ref publications));
+        var idle = new DrainDispatcher();
+        var blocked = new DrainDispatcher(blockDispatch: true);
+        // BeginDrain always visits the inline default before named streams. The first
+        // quiescent runner claim must therefore roll back when the second claim is busy.
+        manager.Register(9665, 0, idle);
+        manager.Register(9665, 1, blocked);
+        var dispatch = manager.DispatchChunkAsync(9665, 1, new ReadOnlySequence<byte>(new byte[] { 1 }));
+        ValueTask retirement;
+        if (asynchronous)
+            retirement = manager.CompleteRequestStreamsAfterDispatchesAsync(9665, exception: null);
+        else
+        {
+            manager.CompleteRequestStreams(9665, exception: null);
+            retirement = new ValueTask(Task.WhenAll(
+                idle.State.WaitForReceiveRetirementAsync(CancellationToken.None).AsTask(),
+                blocked.State.WaitForReceiveRetirementAsync(CancellationToken.None).AsTask()));
+        }
+        Require(!retirement.IsCompleted && publications == 0,
+            "partial claim fallback must retain the whole-request publication barrier");
+        blocked.Release();
+        await dispatch.AsTask().WaitAsync(Timeout);
+        await retirement.AsTask().WaitAsync(Timeout);
+        Require(publications == 2 && idle.DrainCount == 1 && blocked.DrainCount == 1 &&
+                !idle.State.HasActiveDispatches && !blocked.State.HasActiveDispatches,
+            "every rolled-back or deferred pin must drain once without stranding retirement");
+    }
+
+    private sealed class ClearingFailureDispatcher(Action onFailure, bool failureDuringComplete = false,
+        bool blockDispatch = false) : IStreamConsumptionAwareDispatcher
+    {
+        private readonly TaskCompletionSource _completion = new(TaskCreationOptions.RunContinuationsAsynchronously);
+        public ValueTask DispatchAsync(ReadOnlySequence<byte> payload)
+            => blockDispatch ? new(_completion.Task) : ValueTask.CompletedTask;
+        public ValueTask DispatchAsync(ReadOnlySequence<byte> payload, int encodedByteCount) => DispatchAsync(payload);
+        public void Complete(bool isError, string? errorMessage) => Complete(exception: null);
+        public void Complete(Exception? exception)
+        {
+            if (failureDuringComplete) onFailure();
+        }
+        internal void Release() => _completion.TrySetResult();
+        public void SetBytesConsumedCallback(Action<long, ushort, int>? callback, long requestId, ushort streamId)
+        {
+            if (requestId == 0 && !failureDuringComplete) onFailure();
+        }
+    }
+
+    private sealed class DrainDispatcher(bool blockDispatch = false, Action? onDrained = null)
+        : IStreamDispatcher, IStreamDispatchLease
+    {
+        private readonly TaskCompletionSource _completion = new(TaskCreationOptions.RunContinuationsAsynchronously);
+        internal IStreamDispatchState State { get; private set; } = null!;
+        internal int DrainCount;
+        public void BindDispatchState(IStreamDispatchState state) => State = state;
+        public void OnDispatchesDrained() { DrainCount++; onDrained?.Invoke(); }
+        public ValueTask DispatchAsync(ReadOnlySequence<byte> payload)
+            => blockDispatch ? new(_completion.Task) : ValueTask.CompletedTask;
+        public ValueTask DispatchAcquiredAsync(ReadOnlySequence<byte> payload, int encodedByteCount) => DispatchAsync(payload);
+        internal void Release() => _completion.TrySetResult();
+        public void Complete(bool isError, string? errorMessage) { }
+        public void Complete(Exception? exception) { }
+    }
+
+    private static void Require(bool condition, string message)
+    {
+        if (!condition) throw new InvalidOperationException(message);
+    }
+}
diff --git a/test/SharpLink.UnitTests/Runtime/StreamManagerRetirementTransactionTests.cs b/test/SharpLink.UnitTests/Runtime/StreamManagerRetirementTransactionTests.cs
new file mode 100644
index 00000000..b571763b
--- /dev/null
+++ b/test/SharpLink.UnitTests/Runtime/StreamManagerRetirementTransactionTests.cs
@@ -0,0 +1,108 @@
+using System.Linq;
+using System.Reflection;
+using System.Reflection.Emit;
+
+namespace SharpLink.UnitTests.Runtime;
+
+public sealed class StreamManagerRetirementTransactionTests
+{
+    [Test]
+    [Arguments((ushort)0)]
+    [Arguments((ushort)7)]
+    public void FinalRouteRemovalMustSealWithinOneMonitorTransaction(ushort streamId)
+    {
+        const BindingFlags flags = BindingFlags.Instance | BindingFlags.Public | BindingFlags.NonPublic;
+        var type = typeof(StreamManager).GetNestedType("RequestDispatchers", BindingFlags.NonPublic)!;
+        var request = Activator.CreateInstance(type, nonPublic: true)!;
+        var entry = new StreamManager.DispatcherEntry(new Sink(), default);
+        var reserve = type.GetMethod("TryReserve", flags)!;
+        object?[] reservation = [streamId, entry, false];
+        Require((bool)reserve.Invoke(request, reservation)!, "fixture must reserve a live route");
+        var begin = type.GetMethods(flags).Single(method => method.Name == "TryBeginRetirement" && method.GetParameters().Length == 2);
+        object?[] retirement = [streamId, null];
+        Require((bool)begin.Invoke(request, retirement)!, "fixture must claim the original route");
+        var fused = type.GetMethod("FinishRetirementAndSeal", flags);
+        int gates;
+        bool sealedRequest;
+        if (fused is not null)
+        {
+            gates = MonitorEntries(fused);
+            sealedRequest = (bool)fused.Invoke(request, [streamId, entry])!;
+        }
+        else
+        {
+            // Portable exact-N negative: execute both original operations and inspect
+            // their compiled monitor entries, rather than failing on API absence.
+            var remove = type.GetMethod("FinishRetirement", flags)!;
+            var seal = type.GetMethod("TrySealIfEmpty", flags)!;
+            gates = MonitorEntries(remove) + MonitorEntries(seal);
+            Require((bool)remove.Invoke(request, [streamId, entry])!, "original removal must succeed");
+            sealedRequest = (bool)seal.Invoke(request, null)!;
+        }
+        Require(sealedRequest, "removing the last entry must seal its request container");
+        object?[] replacement = [streamId, new StreamManager.DispatcherEntry(new Sink(), default), false];
+        Require(!(bool)reserve.Invoke(request, replacement)! && (bool)replacement[2]!,
+            "a holder of the old container must retry the outer map, not publish into it");
+        Console.WriteLine($"final registry transaction monitor entries={gates}; stream={streamId}");
+        Require(gates == 1, $"final route removal and sealing use {gates} monitor transactions; expected one");
+    }
+
+    [Test]
+    public async Task TerminalCallbackCanRegisterAnotherRouteWithoutSealingOrRemovingIt()
+    {
+        StreamManager? manager = null;
+        var replacement = new Sink();
+        manager = new StreamManager(new RuntimeConcurrencyOptions(), null, null, (request, stream) =>
+        {
+            if (stream == 0) manager!.Register(request, 7, replacement);
+        });
+        manager.Register(9820, new Sink());
+        manager.Unregister(9820);
+        await manager.DispatchChunkAsync(9820, 7, new ReadOnlySequence<byte>(new byte[] { 1 }));
+        Require(replacement.Dispatches == 1 && manager.ActiveStreamCount == 1,
+            "publication callback registration remains live across old-entry remove-and-seal");
+        manager.Unregister(9820, 7);
+        Require(manager.ActiveStreamCount == 0, "the new route must still have one retirement owner");
+    }
+
+    private static int MonitorEntries(MethodInfo method)
+    {
+        var codes = typeof(OpCodes).GetFields(BindingFlags.Public | BindingFlags.Static)
+            .Where(field => field.FieldType == typeof(OpCode))
+            .Select(field => (OpCode)field.GetValue(null)!).ToDictionary(code => code.Value);
+        var body = method.GetMethodBody()!.GetILAsByteArray()!;
+        var count = 0;
+        for (var offset = 0; offset < body.Length;)
+        {
+            var first = body[offset++];
+            var value = first == 0xfe ? unchecked((short)(0xfe00 | body[offset++])) : (short)first;
+            var code = codes[value];
+            if (code.OperandType == OperandType.InlineMethod)
+            {
+                var target = method.Module.ResolveMethod(BitConverter.ToInt32(body, offset));
+                if (target?.DeclaringType == typeof(Monitor) && target.Name == "Enter") count++;
+            }
+            offset += code.OperandType switch
+            {
+                OperandType.InlineNone => 0,
+                OperandType.ShortInlineBrTarget or OperandType.ShortInlineI or OperandType.ShortInlineVar => 1,
+                OperandType.InlineVar => 2,
+                OperandType.InlineI8 or OperandType.InlineR => 8,
+                OperandType.InlineSwitch => 4 + 4 * BitConverter.ToInt32(body, offset),
+                _ => 4,
+            };
+        }
+        return count;
+    }
+    private static void Require(bool condition, string message)
+    {
+        if (!condition) throw new InvalidOperationException(message);
+    }
+    private sealed class Sink : IStreamDispatcher
+    {
+        internal int Dispatches;
+        public ValueTask DispatchAsync(ReadOnlySequence<byte> payload) { Dispatches++; return ValueTask.CompletedTask; }
+        public void Complete(bool isError, string? errorMessage) { }
+        public void Complete(Exception? exception) { }
+    }
+}
