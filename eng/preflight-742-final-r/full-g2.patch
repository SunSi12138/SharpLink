new file mode 100644
index 00000000..8120d052
--- /dev/null
+++ b/src/SharpLink.Runtime/StreamManager.Registration.cs
@@ -0,0 +1,130 @@
+namespace SharpLink.Runtime;
+
+internal sealed partial class StreamManager
+{
+    private void RegisterCore(long requestId, ushort streamId, IStreamDispatcher dispatcher, bool ignoreExisting)
+    {
+        ArgumentNullException.ThrowIfNull(dispatcher);
+        var termination = Volatile.Read(ref _termination);
+        if (termination is not null)
+        {
+            dispatcher.Complete(termination.Exception);
+            return;
+        }
+
+        var routes = GetOrCreateDispatchersByRequestId();
+        var request = routes.GetOrAdd(requestId, static _ => new RequestDispatchers());
+        if (dispatcher is not DiscardingStreamDispatcher &&
+            request.TryAttachPreAdmission(streamId, dispatcher, out var alreadyCompleted, out var attachedEntry))
+        {
+            if (alreadyCompleted)
+                Unregister(requestId, streamId, attachedEntry);
+            return;
+        }
+
+        if (Interlocked.Increment(ref _activeStreamCount) > _maxActiveStreams)
+        {
+            Interlocked.Decrement(ref _activeStreamCount);
+            var exception = new SharpLinkException(SharpLinkErrorCode.ResourceExhausted,
+                $"Active inbound stream routes exceeded the per-connection limit of {_maxActiveStreams}.");
+            try { dispatcher.Complete(exception); }
+            finally
+            {
+                RemoveEmptyRequest(requestId, request);
+                _activeStreamCapacityExceeded?.Invoke(exception);
+            }
+            if (ignoreExisting) return;
+            throw exception;
+        }
+
+        SharpLinkTelemetry.AddActiveStreams(1);
+        DispatcherEntry? entry = null;
+        var reserved = false;
+        try
+        {
+            // Bind first: a rejected second binding must never mutate the original owner.
+            entry = new DispatcherEntry(dispatcher, this, requestId, streamId);
+            while (!request.TryReserve(streamId, entry, out var sealedRequest))
+            {
+                if (!sealedRequest)
+                {
+                    if (ignoreExisting) return;
+                    throw new InvalidOperationException("The stream is already registered.");
+                }
+                // Empty containers are sealed before unlinking. A holder of an old reference
+                // must retry against the map, never publish into a detached container.
+                routes.TryRemove(requestId, request);
+                request = routes.GetOrAdd(requestId, static _ => new RequestDispatchers());
+            }
+            reserved = true;
+            if (_receiveCreditResolver is Func<long, ushort, int, StreamFlowController.ResolvedReceiveCreditLease> &&
+                dispatcher is IStreamReceiveCreditBoundDispatcher and not PreAdmissionStreamDispatcher)
+                entry.DeferFirstReceive();
+            else
+                entry.InitializeReceiveCredit(ResolveReceiveCreditForRegistration(requestId, streamId));
+            ConfigureReceiveBinding(entry);
+            entry.ActivateRegistration();
+        }
+        catch
+        {
+            if (reserved && request.TryBeginRetirement(streamId, entry!, out var retiring))
+            {
+                SharpLinkTelemetry.AddActiveStreams(-1);
+                Interlocked.Decrement(ref _activeStreamCount);
+                RetireStreamAfterDispatches(retiring, clearCallback: true);
+            }
+            throw;
+        }
+        finally
+        {
+            if (!reserved)
+            {
+                try
+                {
+                    entry?.MarkReceiveRetired();
+                    entry?.Detach();
+                }
+                finally
+                {
+                    SharpLinkTelemetry.AddActiveStreams(-1);
+                    Interlocked.Decrement(ref _activeStreamCount);
+                    RemoveEmptyRequest(requestId, request);
+                }
+            }
+            entry?.FinishRegistration();
+        }
+
+        termination = Volatile.Read(ref _termination);
+        if (termination is not null)
+            CompleteTerminatedRegistration(requestId, streamId, request, termination.Exception, entry);
+    }
+
+    private void ConfigureReceiveBinding(DispatcherEntry entry, IStreamDispatcher? dispatcher = null)
+    {
+        dispatcher ??= entry.Dispatcher;
+        if (dispatcher is IStreamReceiveCreditBoundDispatcher bound)
+        {
+            bound.SetReceiveCreditBinding(entry);
+            return;
+        }
+        if (dispatcher is not IStreamConsumptionAwareDispatcher consumptionAware)
+            return;
+
+        // Compatibility for simple non-pooled dispatchers. Runtime-owned dispatchers use
+        // the immutable entry binding and never switch callbacks after publication.
+        ref readonly var lease = ref entry.ReceiveCreditLease;
+        consumptionAware.SetBytesConsumedCallback(_bytesConsumed, lease.RequestId, lease.StreamId);
+        if (_resolvedBytesConsumed is not null && lease.IsResolved)
+            _ = consumptionAware.TrySetResolvedBytesConsumedCallback(_resolvedBytesConsumed, in lease);
+    }
+
+    [MethodImpl(MethodImplOptions.AggressiveInlining)]
+    private void RecordConsumed(DispatcherEntry entry, int encodedBytes)
+    {
+        ref readonly var lease = ref entry.ReceiveCreditLease;
+        if (_resolvedBytesConsumed is not null && lease.IsResolved)
+            _resolvedBytesConsumed(in lease, encodedBytes);
+        else
+            _bytesConsumed?.Invoke(lease.RequestId, lease.StreamId, encodedBytes);
+    }
+}
