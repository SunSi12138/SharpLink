+    [Test]
+    public void FirstReceiveShouldCaptureExactlyTheDebitedGeneration()
+    {
+        var controller = new StreamFlowController(4, 8, 1024);
+        var lease = controller.AcceptReceivedAndResolveCreditLease(1101, 2, 3);
+        var resolved = controller.ResolveReceiveCreditLease(1101, 2);
+        Ensure(lease.IsResolved && ReferenceEquals(lease.Owner, controller) &&
+            ReferenceEquals(lease.State, resolved.State) && lease.Generation == resolved.Generation,
+            "the first debit must return its exact owner and generation");
+        Ensure(lease.RequestId == 1101 && lease.StreamId == 2, "the captured key must be unchanged");
+        Ensure(Credit(controller) == 5 && StateCredit(lease.State!) == 1, "both ledgers debit exactly once");
+        Ensure(controller.RecordConsumed(in lease, 3) == 3, "the captured lease returns its own debit");
+        Ensure(controller.FlushConsumed(in lease) == 0 && States(controller).Count == 0,
+            "normal consumption and completion retire the state without duplicate credit");
+    }
+
