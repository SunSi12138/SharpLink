+using System.Reflection;
+using System.Threading;
+
+namespace SharpLink.UnitTests.Runtime;
+
+public partial class StreamFlowControllerTests
+{
+    [Test]
+    [Arguments(0, false)]
+    [Arguments(1, false)]
+    [Arguments(2, false)]
+    [Arguments(0, true)]
+    [Arguments(1, true)]
+    [Arguments(2, true)]
+    public async Task OrderedTailAdmissionShouldNotAllocateTransientWaiters(int admissionKind, bool cancellable)
+    {
+        const int iterations = 10_000;
+        var controller = new StreamFlowController(2, 4, 1024);
+        await controller.AcquireSendCreditAsync(940, 0, 2, CancellationToken.None);
+        await controller.AcquireSendCreditAsync(941, 0, 1, CancellationToken.None);
+        var lease = controller.ResolveSendCreditLease(941, 0);
+        controller.ReturnUnsentCredit(in lease, 1);
+        using var headCancellation = new CancellationTokenSource();
+        using var tailCancellation = new CancellationTokenSource();
+        var head = controller.AcquireSendCreditAsync(940, 0, 1, headCancellation.Token);
+        var token = cancellable ? tailCancellation.Token : CancellationToken.None;
+        MeasureOrderedTailAdmissions(controller, lease, admissionKind, token, 1_024);
+        var allocated = MeasureOrderedTailAdmissions(controller, lease, admissionKind, token, iterations);
+        Console.WriteLine($"Ordered tail kind {admissionKind}, cancellable {cancellable}: {allocated} bytes / {iterations} iterations");
+        Ensure(!head.IsCompleted && controller.SendConnectionCredit == 2,
+            "the measured tail must leave its predecessor pending and return every reserved byte");
+        headCancellation.Cancel();
+        await ExpectCancellation(head);
+        controller.ReturnUnsentCredit(940, 0, 2);
+        Ensure(allocated == 0,
+            $"ordered tail admissions allocated {allocated} bytes; no transient waiter should be created");
+    }
+
+    [Test]
+    public async Task OrderedTailShouldStopAtConnectionBlockedPredecessorBeforeCheckingItsStream()
+    {
+        var controller = new StreamFlowController(4, 8, 1024);
+        await controller.AcquireSendCreditAsync(942, 0, 4, CancellationToken.None);
+        await controller.AcquireSendCreditAsync(943, 0, 2, CancellationToken.None);
+        using var cancellation = new CancellationTokenSource();
+        var head = controller.AcquireSendCreditAsync(942, 0, 3, cancellation.Token);
+        var tail = controller.AcquireSendCreditAsync(944, 0, 1, CancellationToken.None);
+        Ensure(!head.IsCompleted && !tail.IsCompleted && controller.SendConnectionCredit == 2,
+            "a predecessor blocked on both credits must stop an independently eligible tail");
+        controller.ReturnUnsentCredit(943, 0, 2);
+        await tail.AsTask().WaitAsync(TimeSpan.FromSeconds(5));
+        Ensure(!head.IsCompleted && controller.SendConnectionCredit == 3,
+            "only after the predecessor fits connection credit may the tail pass its stream blockage");
+        cancellation.Cancel();
+        await ExpectCancellation(head);
+        controller.ReturnUnsentCredit(944, 0, 1);
+        controller.ReturnUnsentCredit(942, 0, 4);
+        Ensure(controller.SendConnectionCredit == 8, "all debits must be returned exactly once");
+    }
+
+    [Test]
+    public async Task OrderedTailShouldAllowSameKeySmallerRequestPastLargerStreamBlockedHead()
+    {
+        var controller = new StreamFlowController(4, 8, 1024);
+        await controller.AcquireSendCreditAsync(945, 0, 3, CancellationToken.None);
+        using var cancellation = new CancellationTokenSource();
+        var head = controller.AcquireSendCreditAsync(945, 0, 2, cancellation.Token);
+        var tail = controller.AcquireSendCreditAsync(945, 0, 1, CancellationToken.None);
+        Ensure(tail.IsCompletedSuccessfully && !head.IsCompleted && controller.SendConnectionCredit == 4,
+            "the existing scan allows a smaller same-key request past a stream-only-blocked head");
+        await tail;
+        cancellation.Cancel();
+        await ExpectCancellation(head);
+        controller.ReturnUnsentCredit(945, 0, 4);
+        Ensure(controller.SendConnectionCredit == 8, "same-key admissions must debit exactly four bytes");
+    }
+
+    [Test]
+    public async Task OrderedTailShouldCheckEveryStreamBlockedPredecessor()
+    {
+        var controller = new StreamFlowController(2, 8, 1024);
+        await controller.AcquireSendCreditAsync(946, 0, 2, CancellationToken.None);
+        await controller.AcquireSendCreditAsync(947, 0, 2, CancellationToken.None);
+        using var cancellation = new CancellationTokenSource();
+        var first = controller.AcquireSendCreditAsync(946, 0, 1, cancellation.Token);
+        var second = controller.AcquireSendCreditAsync(947, 0, 1, cancellation.Token);
+        var tail = controller.AcquireSendCreditAsync(948, 0, 1, CancellationToken.None);
+        Ensure(tail.IsCompletedSuccessfully && !first.IsCompleted && !second.IsCompleted,
+            "the tail may pass a queue consisting entirely of stream-only-blocked waiters");
+        await tail;
+        Ensure(controller.SendConnectionCredit == 3, "only the tail must reserve credit");
+        cancellation.Cancel();
+        await ExpectCancellation(first);
+        await ExpectCancellation(second);
+        controller.ReturnUnsentCredit(946, 0, 2);
+        controller.ReturnUnsentCredit(947, 0, 2);
+        controller.ReturnUnsentCredit(948, 0, 1);
+    }
+
+    [Test]
+    public async Task OrderedTailShouldStopAtLaterConnectionBlockedPredecessor()
+    {
+        var controller = new StreamFlowController(4, 12, 1024);
+        await controller.AcquireSendCreditAsync(964, 0, 4, CancellationToken.None);
+        await controller.AcquireSendCreditAsync(965, 0, 4, CancellationToken.None);
+        await controller.AcquireSendCreditAsync(966, 0, 1, CancellationToken.None);
+        using var cancellation = new CancellationTokenSource();
+        var first = controller.AcquireSendCreditAsync(964, 0, 1, cancellation.Token);
+        var second = controller.AcquireSendCreditAsync(965, 0, 4, cancellation.Token);
+        var tail = controller.AcquireSendCreditAsync(967, 0, 1, CancellationToken.None);
+        Ensure(!tail.IsCompleted && controller.SendConnectionCredit == 3,
+            "a later connection-blocked predecessor must stop the tail even after a safely skipped head");
+        controller.ReturnUnsentCredit(966, 0, 1);
+        await tail.AsTask().WaitAsync(TimeSpan.FromSeconds(5));
+        Ensure(!first.IsCompleted && !second.IsCompleted && controller.SendConnectionCredit == 3,
+            "the tail may pass only after both predecessors become connection-eligible");
+        cancellation.Cancel();
+        await ExpectCancellation(first);
+        await ExpectCancellation(second);
+        controller.ReturnUnsentCredit(964, 0, 4);
+        controller.ReturnUnsentCredit(965, 0, 4);
+        controller.ReturnUnsentCredit(967, 0, 1);
+    }
+
+    [Test]
+    public async Task OrderedTailShouldFallBackWhenPredecessorHasNoCapturedState()
+    {
+        var controller = new StreamFlowController(2, 4, 1024);
+        await controller.AcquireSendCreditAsync(968, 0, 2, CancellationToken.None);
+        await controller.AcquireSendCreditAsync(969, 0, 1, CancellationToken.None);
+        controller.ReturnUnsentCredit(969, 0, 1);
+        using var cancellation = new CancellationTokenSource();
+        var head = controller.AcquireSendCreditAsync(968, 0, 1, cancellation.Token);
+        var waiters = (System.Collections.IEnumerable)GetPrivateField<object>(controller, "_waiters");
+        foreach (var waiter in waiters)
