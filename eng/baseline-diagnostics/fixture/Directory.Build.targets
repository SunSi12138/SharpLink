<Project>
  <Target Name="ValidateComparisonArm" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(Arm)' != 'BASELINE'" Text="Arm must explicitly be BASELINE." />
    <Error Condition="'$(LibraryRoot)' == ''" Text="LibraryRoot must be the independently materialized package arm." />
    <Error Condition="!Exists('$(LibraryRoot)/SharpLink.Abstractions.dll')" Text="Arm libraries missing." />
  </Target>
</Project>
