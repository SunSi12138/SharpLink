<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
    <EnablePackageValidation>false</EnablePackageValidation>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <CompilerGeneratedFilesOutputPath>obj/Generated</CompilerGeneratedFilesOutputPath>
  </PropertyGroup>
  <ItemGroup Condition="'$(EvidenceSourceRoot)' == ''">
    <Reference Include="$(ArmPath)/*.dll" />
    <Analyzer Include="$(GeneratorPath)" />
  </ItemGroup>
  <ItemGroup Condition="'$(EvidenceSourceRoot)' != ''">
    <ProjectReference Include="$(EvidenceSourceRoot)/src/SharpLink.Server/SharpLink.Server.csproj" />
    <ProjectReference Include="$(EvidenceSourceRoot)/src/SharpLink.Client/SharpLink.Client.csproj" />
    <ProjectReference Include="$(EvidenceSourceRoot)/src/SharpLink.Sdk/SharpLink.Sdk.csproj" />
    <ProjectReference Include="$(EvidenceSourceRoot)/src/SharpLink.Generator/SharpLink.Generator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>
</Project>
