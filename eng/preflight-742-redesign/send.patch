@@ -0,0 +1,374 @@
+using System.Buffers;
+using System.Collections.Generic;
+using System.IO.Pipelines;
+using System.Reflection;
+using System.Runtime.CompilerServices;
+using System.Threading;
+
+namespace SharpLink.UnitTests.Runtime;
+
+public class ResolvedStreamPublicationTests
+{
+    [Test]
+    [Arguments(false)]
+    [Arguments(true)]
+    public async Task FirstAndRetainedSendsShouldUseTheSameGeneration(bool sized)
+    {
+        await using var fixture = new Fixture(window: 8);
+        var codec = new CountingCodec(sized);
+        var first = fixture.First(codec, 4);
+        Ensure(first.IsCompletedSuccessfully, "first admission should complete synchronously");
+        var lease = await first;
+        var retained = fixture.Retained(codec, 4, lease);
+        Ensure(retained.IsCompletedSuccessfully, "retained publication should complete synchronously");
+        await retained;
+        Ensure(fixture.Controller.SendConnectionCredit == 0, "both sends must debit exactly four bytes");
+        var current = fixture.Controller.ResolveSendCreditLease(1, 0);
+        Ensure(ReferenceEquals(lease.State, current.State) && lease.Generation == current.Generation,
+            "retained publication must use the original generation");
+        Ensure(codec.SerializeCount == 2 && codec.ReleaseCount == (sized ? 2 : 0),
+            "each item and sized snapshot must be handled once");
+        fixture.ReturnCredit(8);
+    }
+
+    [Test]
+    [Arguments(false)]
+    [Arguments(true)]
+    public async Task RetainedSendShouldWaitWithoutRebindingAndResumeOnce(bool sized)
+    {
+        await using var fixture = new Fixture(window: 4);
+        var codec = new CountingCodec(sized);
+        var lease = await fixture.First(codec, 4);
+        var send = fixture.Retained(codec, 4, lease);
+        Ensure(!send.IsCompleted, "retained send must wait for exhausted credit");
+        Ensure(codec.SerializeCount == (sized ? 1 : 2), "sized serialization must remain after credit");
+        Ensure(fixture.Session.PreCreditSerializedBytes == (sized ? 0 : 4),
+            "only unsized waiting publication owns serialized budget");
+        fixture.ReturnCredit(4);
+        await send.AsTask().WaitAsync(TimeSpan.FromSeconds(5));
+        Ensure(codec.SerializeCount == 2 && codec.ReleaseCount == (sized ? 2 : 0),
+            "resumption must publish and release the snapshot once");
+        Ensure(fixture.Session.PreCreditSerializedBytes == 0 && fixture.Controller.SendConnectionCredit == 0,
+            "ownership must transfer from serialized bytes to one protocol debit");
+        fixture.ReturnCredit(4);
+    }
+
+    [Test]
+    [Arguments(false)]
+    [Arguments(true)]
+    public async Task RetainedSendCancellationShouldLeaveOnlyTheFirstDebit(bool sized)
+    {
+        await using var fixture = new Fixture(window: 4);
+        var codec = new CountingCodec(sized);
+        var lease = await fixture.First(codec, 4);
+        using var cancellation = new CancellationTokenSource();
+        var send = fixture.Retained(codec, 4, lease, cancellation.Token);
+        Ensure(!send.IsCompleted, "the cancellation control must suspend");
+        cancellation.Cancel();
+        await ExpectCancellation(send);
+        Ensure(fixture.Controller.SendConnectionCredit == 0, "cancellation must not refund the first published item");
+        Ensure(fixture.Session.PreCreditSerializedBytes == 0 && fixture.Session.PreCreditSerializedWaiterCount == 0,
+            "cancellation must leave no serialized owner or waiter");
+        Ensure(codec.ReleaseCount == (sized ? 2 : 0), "cancellation must release the captured sized snapshot");
+        fixture.ReturnCredit(4);
+    }
+
+    [Test]
+    [Arguments(false)]
+    [Arguments(true)]
+    public async Task RetainedSendQueueRejectionShouldRefundExactlyOnce(bool sized)
+    {
+        const int bytes = 30 * 1024;
+        await using var fixture = new Fixture(window: bytes, sendQueueBytes: 32 * 1024);
+        var codec = new CountingCodec(sized);
+        var lease = await fixture.First(codec, 1);
+        fixture.ReturnCredit(1);
+        // Normal DATA cannot consume the pump's reserved 4 KiB protocol-progress capacity.
+        await ExpectFailure(() => fixture.Retained(codec, bytes, lease), SharpLinkErrorCode.ResourceExhausted);
+        Ensure(fixture.Controller.SendConnectionCredit == bytes && fixture.Session.PreCreditSerializedBytes == 0,
+            "rejected unsent DATA must refund its debit and local budget exactly once");
+        try
+        {
+            fixture.Controller.ReturnUnsentCredit(in lease, bytes);
+            throw new Exception("duplicate refund should fail");
+        }
+        catch (InvalidOperationException exception) when (exception.Message.Contains("returned more than once", StringComparison.Ordinal))
+        {
+        }
+        Ensure(codec.ReleaseCount == (sized ? 2 : 0), "queue rejection must not retain snapshots");
+    }
+
+    [Test]
+    [Arguments(false)]
+    [Arguments(true)]
+    public async Task RetainedClientSerializationCrossingDeadlineShouldNotKeepADebit(bool sized)
+    {
+        await using var fixture = new Fixture(window: 8);
+        var codec = new CountingCodec(sized);
+        var lease = await fixture.First(codec, 4);
+        var time = new ManualTimeProvider();
+        var deadline = RpcDeadline.Create(TimeSpan.FromSeconds(1), time);
+        codec.AfterSerialize = () => time.AdvanceWithoutRunningTimers(TimeSpan.FromSeconds(2));
+        await ExpectFailure(() => fixture.Session.SendClientStreamChunkResolvedAsync(
+            1, 0, new Payload(4), codec, sized ? codec : null,
+            deadline, time, CancellationToken.None, lease), SharpLinkErrorCode.DeadlineExceeded);
+        Ensure(fixture.Controller.SendConnectionCredit == 4, "expired retained publication must leave only the first debit");
+        Ensure(codec.ReleaseCount == (sized ? 2 : 0), "deadline failure must release the snapshot exactly once");
+        fixture.ReturnCredit(4);
+    }
+
+    [Test]
+    [Arguments(false)]
+    [Arguments(true)]
+    public async Task RetainedSendShouldRejectAReusedGeneration(bool sized)
+    {
+        await using var fixture = new Fixture(window: 4);
+        var codec = new CountingCodec(sized);
+        var stale = await fixture.First(codec, 4);
+        fixture.ReturnCredit(4);
+        fixture.Session.CompleteSendStream(1, 0);
