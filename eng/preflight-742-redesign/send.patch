+                    ThrowIfStreamPublicationRejected(deadline, deadlineTimeProvider, cancellationToken, clientPublication, beforePublication: true);
+                    ownsWriter = false;
+                    SendPacket(writer);
+                }
+                catch
+                {
+                    if (creditAcquired)
+                        ReturnUnsentStreamCredit(creditLease, requestId, streamId, encodedBytes);
+                    throw;
+                }
