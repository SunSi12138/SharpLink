+        await controller.AcquireSendCreditAsync(949, 0, 4, CancellationToken.None);
+        await controller.AcquireSendCreditAsync(950, 0, 1, CancellationToken.None);
+        controller.CompleteSendStream(949, 0);
+        using var cancellation = new CancellationTokenSource();
+        var pending = controller.AcquireSendCreditAsync(951, 0, 1, cancellation.Token);
+        Ensure(!pending.IsCompleted && !controller.ResolveSendCreditLease(951, 0).IsResolved,
+            "the completed tombstone must keep the pending state unpublished");
+        var before = GC.GetAllocatedBytesForCurrentThread();
+        var tail = controller.AcquireSendCreditAsync(950, 0, 1, CancellationToken.None);
+        var allocated = GC.GetAllocatedBytesForCurrentThread() - before;
+        Ensure(tail.IsCompletedSuccessfully && allocated > 0,
+            "a pending-capacity predecessor must use the existing waiter scan even when the tail fits");
+        await tail;
+        Ensure(GetPrivateField<int>(controller, "_pendingSendStateWaiterCount") == 1,
+            "tail admission must preserve pending-capacity accounting");
+        try
+        {
+            _ = controller.AcquireSendCreditAsync(952, 0, 1, CancellationToken.None);
+            throw new Exception("expected the pending state capacity limit");
+        }
+        catch (SharpLinkException exception) when (exception.Code == SharpLinkErrorCode.ResourceExhausted)
+        {
+        }
+        cancellation.Cancel();
+        await ExpectCancellation(pending);
+        Ensure(GetPrivateField<int>(controller, "_pendingSendStateWaiterCount") == 0,
+            "cancellation must release the original pending-capacity slot exactly once");
+        controller.ApplyWindowUpdate(949, 0, 4);
+        controller.ReturnUnsentCredit(950, 0, 2);
+        Ensure(controller.SendConnectionCredit == 12, "pending state rejection must not reserve credit");
+    }
