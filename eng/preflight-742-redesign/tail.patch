+    private bool TryReserveOrderedSendCredit(SendState state, int encodedBytes)
+    {
+        if (!CanReserve(state.Credit, _sendConnectionCredit, encodedBytes))
+            return false;
+        // Match an AdmitWaiters scan that leaves every predecessor untouched.
+        for (var node = _waiters.First; node is not null; node = node.Next)
+        {
+            var waiter = node.Value;
+            if (waiter.CanCreateState ||
+                waiter.ExpectedState is not { Attached: true, Completed: false, AbortException: null } earlier ||
+                earlier.Lease != waiter.ExpectedLease ||
+                !HasConnectionCredit(_sendConnectionCredit, waiter.EncodedBytes) ||
+                HasStreamCredit(earlier.Credit, waiter.EncodedBytes))
+                return false;
+        }
+        Reserve(state, encodedBytes);
+        return true;
