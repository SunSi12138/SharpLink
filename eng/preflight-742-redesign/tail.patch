+    [Test]
+    [Arguments(0, false)]
+    [Arguments(1, false)]
+    [Arguments(2, false)]
+    [Arguments(0, true)]
+    [Arguments(1, true)]
+    [Arguments(2, true)]
+    public async Task OrderedTailAdmissionShouldNotAllocateTransientWaiters(int admissionKind, bool cancellable)
+    {
+        const int iterations = 10_000;
+        var controller = new StreamFlowController(2, 4, 1024);
+        await controller.AcquireSendCreditAsync(940, 0, 2, CancellationToken.None);
+        await controller.AcquireSendCreditAsync(941, 0, 1, CancellationToken.None);
+        var lease = controller.ResolveSendCreditLease(941, 0);
+        controller.ReturnUnsentCredit(in lease, 1);
+        using var headCancellation = new CancellationTokenSource();
+        using var tailCancellation = new CancellationTokenSource();
+        var head = controller.AcquireSendCreditAsync(940, 0, 1, headCancellation.Token);
+        var token = cancellable ? tailCancellation.Token : CancellationToken.None;
+        MeasureOrderedTailAdmissions(controller, lease, admissionKind, token, 1_024);
+        var allocated = MeasureOrderedTailAdmissions(controller, lease, admissionKind, token, iterations);
+        Console.WriteLine($"Ordered tail kind {admissionKind}, cancellable {cancellable}: {allocated} bytes / {iterations} iterations");
+        Ensure(!head.IsCompleted && controller.SendConnectionCredit == 2,
+            "the measured tail must leave its predecessor pending and return every reserved byte");
+        headCancellation.Cancel();
+        await ExpectCancellation(head);
+        controller.ReturnUnsentCredit(940, 0, 2);
+        Ensure(allocated == 0,
+            $"ordered tail admissions allocated {allocated} bytes; no transient waiter should be created");
+    }
