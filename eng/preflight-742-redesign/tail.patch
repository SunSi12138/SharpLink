+    [Test]
+    [Arguments("Attached")]
+    [Arguments("Lease")]
+    [Arguments("Completed")]
+    [Arguments("AbortException")]
+    public async Task OrderedTailShouldLetExistingScanRejectInvalidPredecessors(string invalidField)
+    {
+        var controller = new StreamFlowController(2, 6, 1024);
+        await controller.AcquireSendCreditAsync(953, 0, 2, CancellationToken.None);
+        var head = controller.AcquireSendCreditAsync(953, 0, 1, CancellationToken.None);
+        var state = GetSendState(controller, 953, 0);
+        var rejection = new SharpLinkException(SharpLinkErrorCode.Cancelled, "invalid queued predecessor");
+        // Public lifecycle methods remove these waiters eagerly. Inject each defensive
+        // scan case deterministically; no production hook or timing race is required.
+        object invalidValue = invalidField switch
+        {
+            "Attached" => false,
+            "Lease" => GetPrivateField<long>(state, "Lease") + 1,
+            "Completed" => true,
+            _ => rejection,
+        };
+        SetTailTestField(state, invalidField, invalidValue);
+        var tail = controller.AcquireSendCreditAsync(954, 0, 1, CancellationToken.None);
+        Ensure(tail.IsCompletedSuccessfully, "the existing scan must reject the predecessor and admit the tail");
+        await tail;
+        try
+        {
+            await head.AsTask().WaitAsync(TimeSpan.FromSeconds(5));
+            throw new Exception("expected the invalid predecessor to be rejected");
+        }
+        catch (SharpLinkException exception)
+        {
+            Ensure(invalidField == "AbortException" ? ReferenceEquals(exception, rejection) :
+                exception.Code == SharpLinkErrorCode.ConnectionClosed,
+                "the fallback must preserve the predecessor's exact rejection semantics");
+        }
+        Ensure(controller.SendConnectionCredit == 3,
+            "invalid predecessor removal must not debit or refund its outstanding credit");
+    }
