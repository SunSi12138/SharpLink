+    [Test]
+    public async Task OrderedTailShouldStopAtConnectionBlockedPredecessorBeforeCheckingItsStream()
+    {
+        var controller = new StreamFlowController(4, 8, 1024);
+        await controller.AcquireSendCreditAsync(942, 0, 4, CancellationToken.None);
+        await controller.AcquireSendCreditAsync(943, 0, 2, CancellationToken.None);
+        using var cancellation = new CancellationTokenSource();
+        var head = controller.AcquireSendCreditAsync(942, 0, 3, cancellation.Token);
+        var tail = controller.AcquireSendCreditAsync(944, 0, 1, CancellationToken.None);
+        Ensure(!head.IsCompleted && !tail.IsCompleted && controller.SendConnectionCredit == 2,
+            "a predecessor blocked on both credits must stop an independently eligible tail");
+        controller.ReturnUnsentCredit(943, 0, 2);
+        await tail.AsTask().WaitAsync(TimeSpan.FromSeconds(5));
+        Ensure(!head.IsCompleted && controller.SendConnectionCredit == 3,
+            "only after the predecessor fits connection credit may the tail pass its stream blockage");
+        cancellation.Cancel();
+        await ExpectCancellation(head);
+        controller.ReturnUnsentCredit(944, 0, 1);
+        controller.ReturnUnsentCredit(942, 0, 4);
+        Ensure(controller.SendConnectionCredit == 8, "all debits must be returned exactly once");
+    }
