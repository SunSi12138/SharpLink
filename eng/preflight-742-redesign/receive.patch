@@ -0,0 +1,56 @@
+namespace SharpLink.UnitTests.Runtime;
+
+public sealed class StreamManagerPeerPublicationBarrierTests
+{
+    [Test]
+    [Arguments(false)]
+    [Arguments(true)]
+    public async Task AsyncRetirementMustJoinAnAlreadyRunningPeerPublication(bool wholeRequest)
+    {
+        var timeout = TimeSpan.FromSeconds(10);
+        var flow = new StreamFlowController(4, 4, 1024, 1);
+        var manager = new StreamManager(new RuntimeConcurrencyOptions(), null, null, null, 2, null,
+            flow.ResolveReceiveCreditLease, resolvedStreamCompleted: lease => flow.FlushConsumed(in lease));
+        var buffers = new SharpLinkBufferWriterPool(new BufferWriterPoolOptions());
+        manager.ReservePreAdmissionStreams(9640, 1, buffers, _ => true, _ => { }, static () => { },
+            retainUntilLocalCompletion: true);
+        using var publishing = new ManualResetEventSlim();
+        using var release = new ManualResetEventSlim();
+        var peer = Task.Run(() =>
+        {
+            StreamManagerTestHooks.BeforeReceiveTerminalPublish = (_, _) =>
+            {
+                publishing.Set();
+                if (!release.Wait(timeout)) throw new TimeoutException("Missing terminal release.");
+            };
+            try { manager.CompletePeerStream(9640, 1, exception: null); }
+            finally { StreamManagerTestHooks.BeforeReceiveTerminalPublish = null; }
+        });
+        ValueTask retiring = default;
+        var keyRejected = false;
+        try
+        {
+            if (!publishing.Wait(timeout)) throw new TimeoutException("Missing peer publication.");
+            retiring = wholeRequest
+                ? manager.CompleteRequestStreamsAfterDispatchesAsync(9640, exception: null)
+                : manager.CompleteStreamAfterDispatchesAsync(9640, 1, exception: null);
+            if (retiring.IsCompleted) throw new InvalidOperationException("Async close overtook peer publication.");
+            try { manager.Register(9640, 1, new SinkDispatcher()); }
+            catch (InvalidOperationException) { keyRejected = true; }
+            if (!keyRejected) throw new InvalidOperationException("Key became reusable before old publication.");
+        }
+        finally { release.Set(); }
+        await peer.WaitAsync(timeout);
+        await retiring.AsTask().WaitAsync(timeout);
+        manager.Register(9640, 1, new SinkDispatcher());
+        if (manager.ActiveStreamCount != 1) throw new InvalidOperationException("Replacement accounting failed.");
+        manager.Unregister(9640, 1);
+    }
+
+    private sealed class SinkDispatcher : IStreamDispatcher
+    {
+        public ValueTask DispatchAsync(ReadOnlySequence<byte> payload) => ValueTask.CompletedTask;
+        public void Complete(bool isError, string? errorMessage) { }
+        public void Complete(Exception? exception) { }
+    }
+}
