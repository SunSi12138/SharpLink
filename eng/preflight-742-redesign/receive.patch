@@ -0,0 +1,84 @@
+using System.Reflection;
+
+namespace SharpLink.UnitTests.Runtime;
+
+[NotInParallel("dispatcher-pool")]
+public sealed class StreamManagerImmutableBindingTests
+{
+    [Test]
+    public async Task DelayedConsumptionMustKeepItsGenerationAcrossDispatcherAndStateReuse()
+    {
+        PooledAsyncStreamDispatcher<string>.ClearPoolForTests();
+        var controller = new StreamFlowController(4, 4, 1024, 1);
+        var returned = 0;
+        void Consume(in StreamFlowController.ResolvedReceiveCreditLease lease, int bytes)
+            => returned += controller.RecordConsumed(in lease, bytes);
+        void Accept(in StreamFlowController.ResolvedReceiveCreditLease lease, int bytes)
+            => controller.AcceptReceived(in lease, bytes);
+        var manager = new StreamManager(new RuntimeConcurrencyOptions(), null, null, null, 1, null,
+            controller.ResolveReceiveCreditLease, Accept, Consume, lease => returned += controller.FlushConsumed(in lease));
+        var dispatcher = PooledAsyncStreamDispatcher<string>.Rent(default, TextCodec.Instance);
+        var payload = new ReadOnlySequence<byte>(new byte[4]);
+        manager.Register(9611, dispatcher);
+        var field = typeof(PooledAsyncStreamDispatcher<string>).GetField("_receiveCreditBinding",
+            BindingFlags.Instance | BindingFlags.NonPublic)!;
+        var oldBinding = (StreamManager.DispatcherEntry)field.GetValue(dispatcher)!;
+        await manager.DispatchChunkAsync(9611, payload);
+        manager.CompleteStream(9611, exception: null);
+        Require(returned == 0, "peer terminal must not return buffered bytes before consumption");
+        var consumer = dispatcher.GetAsyncEnumerator();
+        Require(await consumer.MoveNextAsync(), "the completed route must keep its buffered item");
+        Require(returned == 4, "delayed consumption must return the old generation's exact credit");
+        await consumer.DisposeAsync();
+        Require(!dispatcher.HasRetainedReferencesForTests, "pool entry must release both binding references");
+
+        var replacement = PooledAsyncStreamDispatcher<string>.Rent(default, TextCodec.Instance);
+        Require(ReferenceEquals(replacement, dispatcher), "fixture must reuse the same pooled dispatcher");
+        manager.Register(9612, replacement);
+        var newBinding = (StreamManager.DispatcherEntry)field.GetValue(replacement)!;
+        Require(ReferenceEquals(oldBinding.ReceiveCreditLease.State, newBinding.ReceiveCreditLease.State) &&
+                oldBinding.ReceiveCreditLease.Generation != newBinding.ReceiveCreditLease.Generation,
+            "fixture must reuse the flow-state object with a new generation");
+        await manager.DispatchChunkAsync(9612, payload);
+        oldBinding.RecordConsumed(4);
+        Require(returned == 4, "a retained old binding must never credit a newly rented flow generation");
+        manager.CompleteStream(9612, exception: null);
+        await replacement.DisposeAsync();
+        Require(returned == 8 && !replacement.HasRetainedReferencesForTests,
+            "new-generation disposal must return its four bytes exactly once and clear roots");
+        PooledAsyncStreamDispatcher<string>.ClearPoolForTests();
+    }
+
+    [Test]
+    public async Task AlreadyCompletedDispatcherRegistrationMustKeepOwnershipUntilExplicitDetach()
+    {
+        PooledAsyncStreamDispatcher<string>.ClearPoolForTests();
+        var manager = new StreamManager();
+        var dispatcher = PooledAsyncStreamDispatcher<string>.Rent(default, TextCodec.Instance);
+        dispatcher.Complete(new OperationCanceledException("terminal won registration"));
+        manager.Register(9613, dispatcher);
+        Require(manager.ActiveStreamCount == 1, "late registration retains its explicitly owned route");
+        manager.Unregister(9613);
+        await dispatcher.DisposeAsync();
+        Require(!dispatcher.HasRetainedReferencesForTests &&
+                PooledAsyncStreamDispatcher<string>.RetainedCountForTests == 1,
+            "registration retention must end only after closed-route cleanup permits pool return");
+        PooledAsyncStreamDispatcher<string>.ClearPoolForTests();
+    }
+
+    private sealed class TextCodec : IRpcCodec<string>
+    {
+        internal static readonly TextCodec Instance = new();
+        public string Deserialize(in ReadOnlySequence<byte> payload) => "item";
+        public void Serialize(in string value, IBufferWriter<byte> writer)
+        {
+            writer.GetSpan(4)[..4].Clear();
+            writer.Advance(4);
+        }
+    }
+
+    private static void Require(bool condition, string message)
+    {
+        if (!condition) throw new InvalidOperationException(message);
+    }
+}
