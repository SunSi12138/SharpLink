<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <IsPackable>false</IsPackable>
        <EnablePackageValidation>false</EnablePackageValidation>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="Microsoft.Build.Locator" PrivateAssets="all" />
        <!-- Transitive workspace dependency: use the registered SDK at runtime. -->
        <PackageReference Include="Microsoft.Build.Framework" VersionOverride="17.11.31" ExcludeAssets="runtime" PrivateAssets="all" />
        <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" PrivateAssets="all" />
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" PrivateAssets="all" />
        <!-- Match the 5.0 workspace and the compiler in the pinned SDK. -->
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" VersionOverride="5.0.0" PrivateAssets="all" />
    </ItemGroup>
</Project>
