@@ -0,0 +1,134 @@
+using System.Reflection;
+
+namespace SharpLink.UnitTests.Runtime;
+
+[NotInParallel("dispatcher-pool")]
+public sealed class StreamManagerQuiescentIdentityTests
+{
+    [Test]
+    public async Task SelectedDefaultIdentityCannotCompleteAReplacementAfterLockedClaimFails()
+    {
+        var manager = new StreamManager();
+        var old = new Sink(); var replacement = new Sink();
+        manager.Register(9850, old);
+        manager.Register(9850, 7, new Sink()); // Keep the same request container live.
+        var request = GetRequest(manager, 9850);
+        var expected = old.Entry!;
+        Require(expected.CanClaimQuiescentDirectCompletion, "the optimistic snapshot must have selected a live quiescent route");
+        manager.Unregister(9850);
+        manager.Register(9850, replacement);
+        Require(!TryClaim(request, expected), "the locked phase must reject the replaced default identity");
+        CompleteCaptured(manager, request, expected);
+        await manager.DispatchChunkAsync(9850, new ReadOnlySequence<byte>(new byte[] { 1 }));
+        Require(replacement.Completes == 0 && replacement.Dispatches == 1 && manager.ActiveStreamCount == 2,
+            "failed optimistic claim must not restart by key and retire the replacement");
+        manager.CompleteAll(null);
+    }
+
+    [Test]
+    public void DataAcquisitionAfterSelectionUsesTheCapturedDeferredRetirementOwner()
+    {
+        var manager = new StreamManager(); var sink = new Sink();
+        manager.Register(9851, sink);
+        var request = GetRequest(manager, 9851); var expected = sink.Entry!;
+        Require(expected.CanClaimQuiescentDirectCompletion, "the initial snapshot must be eligible");
+        Require(expected.TryAcquire(), "an already-existing acquisition must race in before the locked recheck");
+        var acquired = true;
+        try
+        {
+            Require(!TryClaim(request, expected), "the locked phase cannot steal a busy entry");
+            CompleteCaptured(manager, request, expected);
+            Require(sink.Completes == 1 && expected.IsDetached && !expected.IsReceiveRetired,
+                "captured fallback keeps the existing immediate-detach/deferred-retirement contract");
+            acquired = false; expected.Release();
+            Require(expected.IsReceiveRetired && manager.ActiveStreamCount == 0,
+                "the original acquisition releases the same generation's deferred retirement");
+        }
+        finally { if (acquired) expected.Release(); manager.CompleteAll(null); }
+    }
+
+    [Test]
+    public void CloseAfterOpenSelectionMayRetireOnlyThatCapturedEntry()
+    {
+        var manager = new StreamManager(); var sink = new Sink();
+        manager.Register(9852, sink);
+        var request = GetRequest(manager, 9852); var expected = sink.Entry!;
+        Require(expected.CanClaimQuiescentDirectCompletion, "selection must precede Close");
+        expected.Close();
+        Require(!TryClaim(request, expected), "a late Close prevents the quiescent claim");
+        CompleteCaptured(manager, request, expected);
+        Require(sink.Completes == 1 && expected.IsReceiveRetired && manager.ActiveStreamCount == 0,
+            "an open selection preserves F's later expected-entry retirement after a concurrent Close");
+    }
+
+    [Test]
+    public async Task SelectedEntryCannotRetireAReplacementUsingTheSamePooledDispatcher()
+    {
+        PooledAsyncStreamDispatcher<string>.ClearPoolForTests();
+        var manager = new StreamManager();
+        var dispatcher = PooledAsyncStreamDispatcher<string>.Rent(default, TextCodec.Instance);
+        manager.Register(9853, dispatcher);
+        manager.Register(9853, 7, new Sink());
+        var request = GetRequest(manager, 9853);
+        var field = typeof(PooledAsyncStreamDispatcher<string>).GetField("_receiveCreditBinding", Flags)!;
+        var expected = (StreamManager.DispatcherEntry)field.GetValue(dispatcher)!;
+        Require(expected.CanClaimQuiescentDirectCompletion, "old route must be selected while open");
+        manager.CompleteStream(9853, null);
+        await dispatcher.DisposeAsync();
+        var replacement = PooledAsyncStreamDispatcher<string>.Rent(default, TextCodec.Instance);
+        try
+        {
+            Require(ReferenceEquals(dispatcher, replacement), "the fixture must reuse the exact pooled object");
+            manager.Register(9853, replacement);
+            var current = (StreamManager.DispatcherEntry)field.GetValue(replacement)!;
+            Require(!ReferenceEquals(expected, current) && !TryClaim(request, expected),
+                "the locked claim must compare entry identity, never pooled dispatcher identity");
+            CompleteCaptured(manager, request, expected);
+            await manager.DispatchChunkAsync(9853, new ReadOnlySequence<byte>(new byte[] { 1 }));
+            var consumer = replacement.GetAsyncEnumerator();
+            Require(await consumer.MoveNextAsync() && manager.ActiveStreamCount == 2 && !current.IsDetached,
+                "the replacement generation remains active and dispatchable after old selection resumes");
+            manager.CompleteStream(9853, null);
+            await consumer.DisposeAsync();
+        }
+        finally
+        {
+            manager.CompleteAll(null);
+            replacement.Complete(null); await replacement.DisposeAsync();
+            PooledAsyncStreamDispatcher<string>.ClearPoolForTests();
+        }
+    }
+
+    private static object GetRequest(StreamManager manager, long requestId)
+    {
+        var map = typeof(StreamManager).GetField("_dispatchersByRequestId", Flags)!.GetValue(manager)!;
+        object?[] args = [requestId, null];
+        Require((bool)map.GetType().GetMethod("TryGetValue", Flags)!.Invoke(map, args)!, "request must be mapped");
+        return args[1]!;
+    }
+    private static bool TryClaim(object request, StreamManager.DispatcherEntry expected)
