+namespace SharpLink.Runtime;
+
+internal sealed partial class StreamManager
+{
+    private void CompleteQuiescentDirectStream(DispatcherEntry entry, Exception? exception)
+    {
+        SharpLinkTelemetry.AddActiveStreams(-1);
+        Interlocked.Decrement(ref _activeStreamCount);
+        try { CompleteDispatcher(entry, exception); }
+        finally { RetireQuiescentDirectStream(entry); }
+    }
+
+    private void CompleteCapturedDirectStream(RequestDispatchers request, ushort streamId,
+        DispatcherEntry expected, Exception? exception)
+    {
+        // Once the optimistic path selected an identity, never restart by key. A DATA
+        // race uses the original deferred owner; a replaced route is a handled no-op.
+        if (!request.TryBeginRetirement(streamId, expected, out var entry)) return;
+        SharpLinkTelemetry.AddActiveStreams(-1);
+        Interlocked.Decrement(ref _activeStreamCount);
+        try { CompleteDispatcher(entry, exception); }
+        finally { RetireStreamAfterDispatches(entry, clearCallback: false); }
+    }
+
+    // The request transaction already owns the same runner pin used by deferred
+    // retirement. No acquisition or delayed peer publisher can enter a Closed entry.
+    private void RetireQuiescentDirectStream(DispatcherEntry entry)
+    {
+        ref readonly var lease = ref entry.ReceiveCreditLease;
+        try
+        {
+            try { PublishReceiveTerminal(lease.RequestId, lease.StreamId, entry); }
+            finally
+            {
+                try
+                {
+                    var map = Volatile.Read(ref _dispatchersByRequestId);
+                    if (map is not null && map.TryGetValue(lease.RequestId, out var request) &&
+                        request.FinishRetirementAndSeal(lease.StreamId, entry))
+                        map.TryRemove(lease.RequestId, request);
+                }
+                catch (Exception error)
+                {
+                    entry.RecordReceiveRetirementFailure(error);
+                    throw;
+                }
+                finally { entry.MarkReceiveReadyAndDetach(); }
+            }
+        }
+        catch (Exception error)
+        {
+            // Joiners observe the result only after the runner and notification finish.
+            entry.RecordReceiveRetirementFailure(error);
+            throw;
+        }
+        finally { entry.ExitDrainedRequestRetirement(); }
+    }
+
+    private sealed partial class RequestDispatchers
+    {
+        public bool TryBeginQuiescentDirectCompletion(ushort streamId, out DispatcherEntry entry)
+        {
+            entry = null!;
+            if (streamId != 0) return false;
+            var candidate = Volatile.Read(ref _defaultDispatcher);
+            if (candidate is null || candidate.Dispatcher is PreAdmissionStreamDispatcher ||
+                !candidate.CanClaimQuiescentDirectCompletion)
+                return false;
+
+            // False after selection must keep this identity for the caller's fallback.
+            entry = candidate;
+            return TryClaimQuiescentDefaultCompletion(candidate);
+        }
+
+        private bool TryClaimQuiescentDefaultCompletion(DispatcherEntry expected)
+        {
+            lock (this)
+                return ReferenceEquals(_defaultDispatcher, expected) && expected.TryClaimQuiescentDirectCompletion();
+        }
+    }
+
+    internal sealed partial class DispatcherEntry
+    {
+        private const long QuiescentCompletionExcludedMask = ClosedMask | InitializingMask |
+            RetirementClaimedMask | CountMask | CleanupMask;
+
+        internal bool CanClaimQuiescentDirectCompletion
+            => (Volatile.Read(ref _state) & QuiescentCompletionExcludedMask) == 0;
+
+        internal bool TryClaimQuiescentDirectCompletion()
+        {
+            while (true)
+            {
+                var state = Volatile.Read(ref _state);
+                // CompleteStream, unlike Unregister, cannot acquire a Closed/initializing
+                // route. A failed probe changes nothing and uses the existing slow path.
+                if ((state & QuiescentCompletionExcludedMask) != 0)
+                    return false;
+                var claimed = state | RetirementClaimedMask | ClosedMask | DrainWorkRunningMask;
+                if (Interlocked.CompareExchange(ref _state, claimed, state) == state)
+                    return true;
+            }
+        }
+
+        internal void MarkReceiveReadyAndDetach()
+        {
+            // The exclusive runner remains set through both publications. Logical detach
+            // may wake its waiter now; actual retirement still joins OnDispatchesDrained.
+            var previous = Interlocked.Or(ref _state, ReceiveRetirementReadyMask | ClosedMask | DetachedMask);
+            if ((previous & DetachedMask) == 0)
+                Volatile.Read(ref _completions)?.SignalDetached();
+        }
+    }
+}
