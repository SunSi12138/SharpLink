+            AfterConsume = _ => { if (fails) throw expected; }
+        };
+        fixture.Manager.Register(9803, consumer);
+        var first = fixture.Manager.DispatchChunkAsync(9803, Payload(1)).AsTask();
+        var follower = fixture.Manager.DispatchChunkAsync(9803, Payload(2)).AsTask();
