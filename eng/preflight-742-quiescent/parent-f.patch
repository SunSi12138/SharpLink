+using System.Collections;
+using System.Reflection;
+
+namespace SharpLink.UnitTests.Runtime;
+
+public class StreamFlowControllerFirstReceiveTests
+{
+    [Test]
+    public void FirstReceiveShouldCaptureExactlyTheDebitedGeneration()
+    {
+        var controller = new StreamFlowController(4, 8, 1024);
+        var lease = controller.AcceptReceivedAndResolveCreditLease(1101, 2, 3);
+        var resolved = controller.ResolveReceiveCreditLease(1101, 2);
+        Ensure(lease.IsResolved && ReferenceEquals(lease.Owner, controller) &&
+            ReferenceEquals(lease.State, resolved.State) && lease.Generation == resolved.Generation,
+            "the first debit must return its exact owner and generation");
+        Ensure(lease.RequestId == 1101 && lease.StreamId == 2, "the captured key must be unchanged");
+        Ensure(Credit(controller) == 5 && StateCredit(lease.State!) == 1, "both ledgers debit exactly once");
+        Ensure(controller.RecordConsumed(in lease, 3) == 3, "the captured lease returns its own debit");
+        Ensure(controller.FlushConsumed(in lease) == 0 && States(controller).Count == 0,
+            "normal consumption and completion retire the state without duplicate credit");
+    }
+
+    [Test]
+    public void ExistingLiveStateShouldKeepItsCapturedGeneration()
+    {
+        var controller = new StreamFlowController(4, 8, 1024);
+        var existing = controller.ResolveReceiveCreditLease(1121, 0);
+        var first = controller.AcceptReceivedAndResolveCreditLease(1121, 0, 1);
+        var second = controller.AcceptReceivedAndResolveCreditLease(1121, 0, 2);
+        Ensure(ReferenceEquals(first.State, existing.State) && first.Generation == existing.Generation &&
+            second.Generation == existing.Generation && States(controller).Count == 1,
+            "fused admission must preserve a live state rather than rent a replacement");
+        Ensure(Credit(controller) == 5 && StateCredit(existing.State!) == 1,
+            "each successful call debits exactly its supplied byte count");
+        Ensure(controller.RecordConsumed(in existing, 3) == 3 && controller.FlushConsumed(in existing) == 0,
+            "the same existing generation owns all three admitted bytes");
+    }
+
+    [Test]
+    public void AcceptedFirstLeaseShouldBecomeInertAfterTerminalPublication()
+    {
+        var controller = new StreamFlowController(2, 4, 1024);
+        var lease = controller.AcceptReceivedAndResolveCreditLease(1122, 0, 1);
+        var terminal = new InvalidOperationException("terminal after first debit");
+        controller.Complete(terminal);
+        ExpectSame(() => controller.AcceptReceived(in lease, 1), terminal);
+        ExpectSame(() => controller.AcceptReceivedAndResolveCreditLease(1122, 0, 1), terminal);
+        Ensure(controller.RecordConsumed(in lease, 1) == 0 && controller.FlushConsumed(in lease) == 0,
+            "terminal cleanup must leave an earlier successful lease inert");
+        Ensure(Credit(controller) == 3 && States(controller).Count == 0,
+            "late cleanup must not refund or reconstruct terminal receive state");
+    }
+
+    [Test]
+    [Arguments(0)]
+    [Arguments(-1)]
+    [Arguments(15)]
+    public void InvalidFirstReceiveShouldPublishNeitherStateNorLease(int encodedBytes)
+    {
+        var controller = new StreamFlowController(2, 4, 16);
+        var captured = default(StreamFlowController.ResolvedReceiveCreditLease);
+        Exception? failure = null;
+        try { captured = controller.AcceptReceivedAndResolveCreditLease(1102, 0, encodedBytes); }
+        catch (Exception error) { failure = error; }
+        Ensure(encodedBytes <= 0 ? failure is ArgumentOutOfRangeException :
+            failure is SharpLinkException { Code: SharpLinkErrorCode.ResourceExhausted },
+            "first admission must preserve encoded-length error behavior");
+        Ensure(!captured.IsResolved && States(controller).Count == 0 && Credit(controller) == 4,
+            "invalid first DATA must not publish a lease, consume quota or debit credit");
+        Ensure(Field(controller, "_pooledReceiveStates") is null,
+            "validation must fail before renting a state");
+    }
+
+    [Test]
+    public void ExhaustedConnectionShouldNotRentOrPublishANewFirstState()
+    {
+        var controller = new StreamFlowController(2, 2, 1024);
+        var holder = controller.AcceptReceivedAndResolveCreditLease(1103, 0, 2);
+        var generation = (long)Field(controller, "_receiveStateLeaseCounter")!;
+        ExpectCode(() => controller.AcceptReceivedAndResolveCreditLease(1104, 0, 1),
+            SharpLinkErrorCode.ProtocolViolation);
+        Ensure(States(controller).Count == 1 && Credit(controller) == 0 &&
+            (long)Field(controller, "_receiveStateLeaseCounter")! == generation,
+            "a failed fresh debit must not rent a generation or occupy another state slot");
+        Ensure(controller.RecordConsumed(in holder, 2) == 2, "the original owner retains its debit");
+        controller.FlushConsumed(in holder);
+        var admitted = controller.AcceptReceivedAndResolveCreditLease(1104, 0, 1);
+        Ensure(Credit(controller) == 1 && admitted.IsResolved, "released credit permits a new first DATA");
+    }
+
+    [Test]
+    public void StreamWindowAndConcurrentLimitFailuresShouldLeaveCreditUnchanged()
+    {
+        var controller = new StreamFlowController(2, 4, 1024, maxConcurrentStreams: 1);
+        var lease = controller.AcceptReceivedAndResolveCreditLease(1105, 0, 2);
+        ExpectCode(() => controller.AcceptReceivedAndResolveCreditLease(1105, 0, 1),
