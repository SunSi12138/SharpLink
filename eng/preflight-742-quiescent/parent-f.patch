@@ -0,0 +1,45 @@
+namespace SharpLink.UnitTests.Runtime;
+
+public sealed class StreamManagerFirstReceiveSignalTests
+{
+    [Test]
+    [Arguments(false)]
+    [Arguments(true)]
+    public async Task StickyFirstFailureMustReachWaitersInstalledBeforeOrAfterPublication(bool failFirst)
+    {
+        var entry = new StreamManager.DispatcherEntry(new DiscardingStreamDispatcher(), default);
+        var expected = new InvalidOperationException("first outcome publication");
+        if (failFirst) entry.FailFirstReceive(expected);
+        var wait = entry.WaitForFirstReceiveAsync();
+        if (!failFirst)
+        {
+            if (wait.IsCompleted) throw new InvalidOperationException("the unsignaled waiter must really be installed");
+            entry.FailFirstReceive(expected);
+        }
+        await RequireExactFailure(wait, expected);
+        await RequireExactFailure(entry.WaitForFirstReceiveAsync(), expected);
+    }
+
+    [Test]
+    public async Task FirstFailureRacingCompletionInstallationMustNeverLoseItsSignal()
+    {
+        var expected = new InvalidOperationException("racing first outcome publication");
+        for (var iteration = 0; iteration < 1024; iteration++)
+        {
+            var entry = new StreamManager.DispatcherEntry(new DiscardingStreamDispatcher(), default);
+            var publish = Task.Run(() => entry.FailFirstReceive(expected));
+            var wait = entry.WaitForFirstReceiveAsync();
+            await publish.WaitAsync(TimeSpan.FromSeconds(10));
+            await RequireExactFailure(wait, expected);
+        }
+    }
+
+    private static async Task RequireExactFailure(ValueTask wait, Exception expected)
+    {
+        Exception? actual = null;
+        try { await wait.AsTask().WaitAsync(TimeSpan.FromSeconds(10)); }
+        catch (Exception failure) { actual = failure; }
+        if (!ReferenceEquals(actual, expected))
+            throw new InvalidOperationException("first failure was lost or replaced during waiter installation", actual);
+    }
+}
