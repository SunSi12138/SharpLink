+
+    private static ReadOnlySequence<byte> Payload(int length) => new(new byte[length]);
+    private static ReadOnlySequence<byte> OversizedSequence()
+    {
+        var first = new Segment(new byte[1], 0);
+        var last = new Segment(new byte[1], (long)int.MaxValue);
+        first.SetNext(last);
+        return new ReadOnlySequence<byte>(first, 0, last, 1);
+    }
+    private sealed class Segment : ReadOnlySequenceSegment<byte>
+    {
+        internal Segment(byte[] memory, long offset) { Memory = memory; RunningIndex = offset; }
+        internal void SetNext(Segment next) => Next = next;
+    }
+    private static Exception Reject(Action action)
+    {
+        try { action(); } catch (Exception error) { return error; }
+        throw new InvalidOperationException("expected rejection");
+    }
+    private static async Task<Exception> RejectAsync(Task task)
+    {
+        try { await task.WaitAsync(Bound); } catch (Exception error) { return error; }
+        throw new InvalidOperationException("expected rejection");
+    }
+    private static Task<Exception> RejectDispatch(StreamManager manager, long request, ReadOnlySequence<byte> payload)
+    {
+        try { return RejectAsync(manager.DispatchChunkAsync(request, payload).AsTask()); }
+        catch (Exception error) { return Task.FromResult(error); }
+    }
+    private static void Require(bool condition, string message)
+    {
+        if (!condition) throw new InvalidOperationException(message);
+    }
+
+    private sealed class FourByteTextCodec : IRpcCodec<string>
+    {
+        internal static readonly FourByteTextCodec Instance = new();
+        public string Deserialize(in ReadOnlySequence<byte> payload) => "item";
+        public void Serialize(in string value, IBufferWriter<byte> writer)
+        {
+            writer.GetSpan(4)[..4].Clear();
+            writer.Advance(4);
+        }
+    }
+
+    private sealed class Fixture : IDisposable
+    {
+        internal readonly StreamFlowController Controller = new(8, 8, 1024, 1);
+        internal readonly StreamManager Manager;
+        internal Action? BeforeFirst, AfterFirst;
+        internal int FirstCalls, ResolveCalls, NextCalls, Consumed, Returned, Terminals, KeyedTerminals;
+        internal Fixture(bool noFlow = false)
+        {
+            Manager = new StreamManager(new RuntimeConcurrencyOptions(),
+                (_, _, _) => Interlocked.Increment(ref NextCalls),
+                (_, _, bytes) => Interlocked.Add(ref Consumed, bytes),
+                (_, _) => Interlocked.Increment(ref KeyedTerminals), 4, null,
+                null, Accept, Consume, Terminal,
+                (request, stream, bytes) =>
+                {
+                    if (bytes == 0)
+                    {
+                        ResolveCalls++;
+                        return noFlow ? default : Controller.ResolveReceiveCreditLease(request, stream);
+                    }
+                    Interlocked.Increment(ref FirstCalls);
+                    BeforeFirst?.Invoke();
+                    var lease = noFlow ? default : Controller.AcceptReceivedAndResolveCreditLease(request, stream, bytes);
+                    AfterFirst?.Invoke();
+                    return lease;
+                });
+        }
+        private void Accept(in StreamFlowController.ResolvedReceiveCreditLease lease, int bytes)
+        {
+            Interlocked.Increment(ref NextCalls);
+            Controller.AcceptReceived(in lease, bytes);
+        }
+        private void Consume(in StreamFlowController.ResolvedReceiveCreditLease lease, int bytes)
+        {
+            Interlocked.Add(ref Consumed, bytes);
+            Interlocked.Add(ref Returned, Controller.RecordConsumed(in lease, bytes));
+        }
+        private void Terminal(StreamFlowController.ResolvedReceiveCreditLease lease)
+        {
+            Interlocked.Increment(ref Terminals);
+            Interlocked.Add(ref Returned, Controller.FlushConsumed(in lease));
+        }
+        internal void ProveCapacity()
+        {
+            var next = Controller.AcceptReceivedAndResolveCreditLease(9899, 0, 8);
+            Require(Controller.RecordConsumed(in next, 8) == 8, "full connection credit must remain usable");
+            _ = Controller.FlushConsumed(in next);
+        }
+        public void Dispose()
+        {
+            Manager.CompleteAll(new OperationCanceledException("fixture cleanup"));
+            Controller.Complete(new OperationCanceledException("fixture cleanup"));
+        }
+    }
+
+    private sealed class Consumer : IStreamReceiveCreditBoundDispatcher, IStreamDispatchLease
+    {
+        internal StreamManager.DispatcherEntry? Binding;
+        internal Func<int, ValueTask>? BeforeConsume;
+        internal Action<int>? AfterConsume;
+        internal int Installs, Clears, Dispatches, Drained;
+        internal readonly List<int> Order = [];
+        public void SetReceiveCreditBinding(StreamManager.DispatcherEntry? binding)
+        {
+            Binding = binding;
+            if (binding is null) Clears++; else Installs++;
+        }
+        public void BindDispatchState(IStreamDispatchState state) { }
+        public void OnDispatchesDrained()
+        {
+            Interlocked.Increment(ref Drained);
+            SetReceiveCreditBinding(null);
+        }
+        public ValueTask DispatchAcquiredAsync(ReadOnlySequence<byte> payload, int count) => DispatchAsync(payload, count);
+        public ValueTask DispatchAsync(ReadOnlySequence<byte> payload) => DispatchAsync(payload, checked((int)payload.Length));
+        public async ValueTask DispatchAsync(ReadOnlySequence<byte> payload, int count)
+        {
+            var binding = Binding;
+            Interlocked.Increment(ref Dispatches);
+            lock (Order) Order.Add(count);
+            if (BeforeConsume is { } before) await before(count);
+            binding?.RecordConsumed(count);
+            AfterConsume?.Invoke(count);
+        }
+        public void Complete(bool isError, string? errorMessage) { }
+        public void Complete(Exception? exception) { }
+    }
+}
