+    [Test]
+    [Arguments(false, false)]
+    [Arguments(true, false)]
+    [Arguments(false, true)]
+    public async Task PendingFirstDeliveryPublishesOnlyAfterCompletionAndFailureStaysSticky(bool fails, bool noFlow)
+    {
