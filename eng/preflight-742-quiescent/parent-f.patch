+            {
+                Require(ReferenceEquals(await RejectAsync(first), expected) &&
+                        ReferenceEquals(await RejectAsync(follower), expected), "both callers must see the exact first failure");
+                Require(ReferenceEquals(await RejectDispatch(fixture.Manager, 9803, Payload(3)), expected),
