+        fixture.ProveCapacity();
+    }
+
+    [Test]
+    public async Task EmptyLazyRouteCannotFlushAnOlderOutstandingTombstone()
+    {
+        using var fixture = new Fixture();
+        var old = fixture.Controller.AcceptReceivedAndResolveCreditLease(9805, 0, 8);
+        _ = fixture.Controller.FlushConsumed(in old);
+        fixture.Manager.Register(9805, new Consumer());
+        fixture.Manager.Unregister(9805);
+        Require(fixture.Terminals == 0 && fixture.KeyedTerminals == 0 && fixture.FirstCalls == 0,
+            "an empty new route does not own a previous receive generation");
+        Require(fixture.Controller.RecordConsumed(in old, 8) == 8, "old debt stays consumable by its captured generation");
+        fixture.ProveCapacity();
+        await Task.CompletedTask;
+    }
+
+    [Test]
+    public async Task PreAdmissionRemainsEagerAndCompressedDiscardReturnsOriginalCredit()
+    {
+        using var fixture = new Fixture();
+        fixture.Manager.ReservePreAdmissionStreams(9806, 1,
+            new SharpLinkBufferWriterPool(new BufferWriterPoolOptions()), _ => true, _ => { },
+            () => throw new InvalidOperationException("unexpected retained limit"), retainUntilLocalCompletion: true);
+        Require(fixture.ResolveCalls == 1 && fixture.FirstCalls == 0, "mailbox registration keeps its eager binding");
+        fixture.Manager.AbandonExistingRequestStreams(9806, 1);
+        Require(fixture.Manager.TryDispatchPreAdmissionCompressed(9806, 1, Payload(2), 1, out var dispatch),
+            "the retained abandoned mailbox must still absorb peer DATA");
+        await dispatch;
+        fixture.Manager.CompletePeerStream(9806, 1, null);
+        Require(fixture.Consumed == 1 && fixture.Returned == 1 && fixture.FirstCalls == 0,
+            "wire compression length must not replace original flow-controlled bytes");
+        fixture.ProveCapacity();
+    }
+
+    [Test]
+    public async Task PooledLocalAbortBeforeFirstDebitKeepsBindingUntilAcquiredDataDrains()
+    {
+        PooledAsyncStreamDispatcher<string>.ClearPoolForTests();
+        using var fixture = new Fixture();
+        using var entered = new ManualResetEventSlim();
+        using var resume = new ManualResetEventSlim();
+        fixture.BeforeFirst = () =>
+        {
+            entered.Set();
+            Require(resume.Wait(Bound), "missing local-abort first debit release");
+        };
+        var dispatcher = PooledAsyncStreamDispatcher<string>.Rent(default, FourByteTextCodec.Instance);
+        fixture.Manager.Register(9807, dispatcher);
+        var first = Task.Run(async () => await fixture.Manager.DispatchChunkAsync(9807, Payload(4)));
+        var abort = (IStreamLocalAbortDispatcher)dispatcher;
+        try
+        {
+            Require(entered.Wait(Bound), "pooled first DATA must hold its route before debit");
+            abort.CompleteLocalAbort(new OperationCanceledException("first debit local abort"));
+            fixture.Manager.Unregister(9807);
+            Require(fixture.Terminals == 0 && PooledAsyncStreamDispatcher<string>.RetainedCountForTests == 0,
+                "local abort cannot return a dispatcher while first debit still owns its entry");
+            resume.Set();
+            await first.WaitAsync(Bound);
+            abort.RetireLocalAbortBuffer();
+            await dispatcher.DisposeAsync();
+            Require(fixture.Consumed == 4 && fixture.Returned == 4 && fixture.Terminals == 1 &&
+                    !dispatcher.HasRetainedReferencesForTests,
+                "acquired first DATA returns old-generation credit through the retained abort binding");
+            var replacement = PooledAsyncStreamDispatcher<string>.Rent(default, FourByteTextCodec.Instance);
+            Require(ReferenceEquals(replacement, dispatcher), "the test must actually reuse the dispatcher");
+            fixture.BeforeFirst = null;
+            fixture.Manager.Register(9808, replacement);
+            await fixture.Manager.DispatchChunkAsync(9808, Payload(4));
+            fixture.Manager.CompleteStream(9808, exception: null);
+            await replacement.DisposeAsync();
+            Require(fixture.Consumed == 8 && fixture.Returned == 8 && !replacement.HasRetainedReferencesForTests,
+                "reuse gets its own binding and returns its own bytes exactly once");
+            fixture.ProveCapacity();
+        }
+        finally
+        {
+            resume.Set();
+            try { await first.WaitAsync(Bound); } catch (Exception) { }
+            abort.RetireLocalAbortBuffer();
+            await dispatcher.DisposeAsync();
+            PooledAsyncStreamDispatcher<string>.ClearPoolForTests();
+        }
+    }
+
+    [Test]
+    public async Task CompressedDiscardRejectsZeroCreditInsteadOfSelectingRegistrationResolution()
+    {
+        using var fixture = new Fixture();
+        fixture.Manager.Register(9809, new DiscardingStreamDispatcher());
+        Exception? failure = null;
+        try { fixture.Manager.TryDispatchPreAdmissionCompressed(9809, 0, Payload(2), 0, out _); }
+        catch (Exception error) { failure = error; }
+        Require(failure is ArgumentOutOfRangeException && fixture.ResolveCalls == 0 && fixture.FirstCalls == 0,
+            "the zero-byte resolver selector must never be reachable from compressed DATA");
+        Require(ReferenceEquals(await RejectDispatch(fixture.Manager, 9809, Payload(1)), failure),
