+namespace SharpLink.Runtime;
+
+internal sealed partial class RpcSession
+{
+    // Zero is the registration-only resolution operation. DATA callers normalize an
+    // empty payload to one encoded byte before reaching this combined boundary.
+    private StreamFlowController.ResolvedReceiveCreditLease ResolveOrAcceptReceivedStreamBytes(
+        long requestId, ushort streamId, int encodedBytes)
+    {
+        var controller = Volatile.Read(ref _protocolState).FlowController;
+        return controller is null ? default : encodedBytes == 0
+            ? controller.ResolveReceiveCreditLease(requestId, streamId)
+            : controller.AcceptReceivedAndResolveCreditLease(requestId, streamId, encodedBytes);
+    }
+}
