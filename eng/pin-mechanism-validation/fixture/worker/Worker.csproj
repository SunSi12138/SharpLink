<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework><AssemblyName>SharpLink.Benchmarks</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable><TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Version>3.0.0</Version><AssemblyVersion>3.0.0.0</AssemblyVersion><FileVersion>3.0.0.0</FileVersion>
    <NuGetAudit>true</NuGetAudit><NuGetAuditMode>all</NuGetAuditMode><Deterministic>true</Deterministic>
    <SourceTree Condition="'$(Arm)' == 'baseline'">410fdb911cf7120ccabbbd10c820b0c9a73d9223</SourceTree>
    <SourceTree Condition="'$(Arm)' == 'candidate'">c1a2709f7282d38feb7661614d52bf6098d20b07</SourceTree>
  </PropertyGroup>
  <Target Name="ValidateInputs" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(FrozenProductBin)' == '' or '$(FrozenGenerator)' == '' or '$(SourceTree)' == '' or '$(ProductCommit)' == ''" Text="FrozenProductBin, FrozenGenerator, ProductCommit and Arm=baseline|candidate required." />
  </Target>
  <ItemGroup>
    <AssemblyMetadata Include="Arm" Value="$(Arm)" /><AssemblyMetadata Include="SourceTree" Value="$(SourceTree)" />
    <AssemblyMetadata Include="ExpectedProductCommit" Value="$(ProductCommit)" />
    <Reference Include="SharpLink.Abstractions"><HintPath>$(FrozenProductBin)/SharpLink.Abstractions.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="SharpLink.Runtime"><HintPath>$(FrozenProductBin)/SharpLink.Runtime.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="SharpLink.Server"><HintPath>$(FrozenProductBin)/SharpLink.Server.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="SharpLink.Sdk"><HintPath>$(FrozenProductBin)/SharpLink.Sdk.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="Microsoft.Extensions.DependencyInjection"><HintPath>$(FrozenProductBin)/Microsoft.Extensions.DependencyInjection.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="Microsoft.Extensions.DependencyInjection.Abstractions"><HintPath>$(FrozenProductBin)/Microsoft.Extensions.DependencyInjection.Abstractions.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="Microsoft.Extensions.Logging.Abstractions"><HintPath>$(FrozenProductBin)/Microsoft.Extensions.Logging.Abstractions.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="System.Threading.RateLimiting"><HintPath>$(FrozenProductBin)/System.Threading.RateLimiting.dll</HintPath><Private>true</Private></Reference>
    <ProjectReference Include="../module/Module.csproj" />
  </ItemGroup>
  <Target Name="RecordFrozenReferences" BeforeTargets="CoreCompile">
    <WriteLinesToFile File="$(IntermediateOutputPath)references.txt" Lines="@(ReferencePathWithRefAssemblies->'%(FullPath)')" Overwrite="true" />
  </Target>
</Project>
