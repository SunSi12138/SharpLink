+    [Test]
+    [Arguments(false)]
+    [Arguments(true)]
+    public async Task ExpiredDeadlineShouldBeatAlreadyCompletedFirstBindingFaultOrCancellation(bool cancel)
+    {
+        await using var fixture = new Fixture("generated-deadline");
+        using var cancellation = new CancellationTokenSource();
+        var codec = new ProbeCodec(sized: true)
+        {
+            BeforeCredit = cancel ? () =>
+            {
+                fixture.Time.AdvanceWithoutRunningTimers(TimeSpan.FromSeconds(1));
+                cancellation.Cancel();
+            } : null,
+            BeforeSend = cancel ? null : () =>
+            {
+                fixture.Time.AdvanceWithoutRunningTimers(TimeSpan.FromSeconds(1));
+                throw new InvalidOperationException("already completed send fault");
+            }
+        };
+        var stream = new ProbeStream(itemCount: 2);
+        // Exact sizing returns an already faulted/canceled async ValueTask here. The timer
+        // must still arbitrate it, even though no suspension or timer callback is needed.
+        var failure = await CaptureFailureAsync(fixture.Start(stream, codec, cancellation.Token));
+        Ensure(failure is SharpLinkException { Code: SharpLinkErrorCode.DeadlineExceeded },
+            "expiry must beat an already completed unsuccessful first-send task");
+        Ensure(stream.MoveCount == 1 && stream.ConsumptionCount == 1 && stream.DisposeCount == 1,
+            "already completed failure must stop first binding and dispose once");
+        Ensure(codec.ReleaseCount == 1 && fixture.Controller.SendConnectionCredit == 8,
+            "deadline arbitration must release the first snapshot and any debit");
+        fixture.AssertPumpTimersDisposed("deadline arbitration must not leak a timer");
+        Ensure(await fixture.CountDataFramesAsync() == 0, "expired completed failure must not publish DATA");
+    }
