+            _connection = new ClientConnection(_owner, Session, _lifetime, 8, context);
+            _ = _connection.PendingCalls.Rent(context.Codecs.GetCodec<int>(), PendingCallKind.ClientStreaming,
+                default, CancellationToken.None, out var requestId, hasResponsePayload: true, responseNullable: false);
+            RequestId = requestId;
+            // PendingDeadlineScheduler owns one infinite/disarmed timer for this live
+            // connection. Pump cleanup must return to that known owner, not drain it.
