+    public async Task AlreadyFailedFirstBindingShouldNotBecomeSuccessOrAggregateException(
+        string mode, bool sized, bool cancel)
+    {
+        await using var fixture = new Fixture(mode);
+        using var cancellation = new CancellationTokenSource();
+        var expected = new InvalidOperationException("first serialization failed");
+        var codec = new ProbeCodec(sized)
+        {
+            BeforeCredit = cancel && sized ? () => cancellation.Cancel() : null,
+            BeforeSend = () =>
+            {
+                if (cancel)
+                {
+                    if (!sized) cancellation.Cancel();
+                }
+                else throw expected;
+            }
+        };
+        var stream = new ProbeStream(itemCount: 2);
+        var failure = await CaptureFailureAsync(fixture.Start(stream, codec, cancellation.Token));
+        Ensure(cancel
+                ? failure is OperationCanceledException canceled && canceled.CancellationToken == stream.EnumerationToken
+                : ReferenceEquals(failure, expected),
+            "a synchronously completed fault/cancellation must keep its original exception and token");
+        Ensure(stream.MoveCount == 1 && stream.ConsumptionCount == 1 && stream.DisposeCount == 1,
+            "the first failure must not read another item or duplicate disposal");
+        Ensure(fixture.Controller.SendConnectionCredit == 8 && fixture.Session.PreCreditSerializedBytes == 0,
+            "an immediately failed first send must leave no debit or serialized budget");
+        Ensure(codec.ReleaseCount == (sized ? 1 : 0), "immediate failure must release its captured snapshot once");
+        Ensure(await fixture.CountDataFramesAsync() == 0, "immediate failure must not publish DATA");
+    }
