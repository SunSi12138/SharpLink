+    public async Task PendingFirstBindingShouldPreserveFaultOrCancellationAndReleaseOwnership(
+        string mode, bool sized, bool cancel)
+    {
+        await using var fixture = new Fixture(mode);
+        using var cancellation = new CancellationTokenSource();
+        var codec = new ProbeCodec(sized);
+        var stream = new ProbeStream(itemCount: 2);
+        var expected = new InvalidOperationException("first credit wait failed");
+        await fixture.BlockConnectionCreditAsync();
+        var pump = fixture.Start(stream, codec, cancellation.Token);
+        Ensure(!pump.IsCompleted && stream.MoveCount == 1, "the first send must really be waiting for credit");
+
+        if (cancel)
+            cancellation.Cancel();
+        else
+            fixture.Session.CompleteSendStream(fixture.RequestId, 0, expected);
+        var failure = await CaptureFailureAsync(pump);
+        Ensure(cancel
+                ? failure is OperationCanceledException canceled && canceled.CancellationToken == stream.EnumerationToken
+                : ReferenceEquals(failure, expected),
+            "the first-send awaiter must preserve the original fault or producer cancellation token");
+        await fixture.WaitForCleanupAsync(codec, sized);
+        Ensure(stream.MoveCount == 1 && stream.ConsumptionCount == 1 && stream.DisposeCount == 1,
+            "a failed first binding must stop production and dispose once");
+        Ensure(codec.ReleaseCount == (sized ? 1 : 0), "the blocked first snapshot must be released once");
+        fixture.AssertPumpTimersDisposed("a failed first binding must dispose its timer");
+        fixture.ReleaseBlockerCredit();
+        Ensure(fixture.Controller.SendConnectionCredit == 8,
+            "late credit must not admit an abandoned first send or perform a duplicate refund");
+        Ensure(await fixture.CountDataFramesAsync() == 0, "a failed first binding must not publish DATA");
+    }
