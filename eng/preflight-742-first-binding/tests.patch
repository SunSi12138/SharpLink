+    [Test]
+    [Arguments(false, false, "pending")]
+    [Arguments(false, true, "pending")]
+    [Arguments(true, false, "pending")]
+    [Arguments(true, true, "pending")]
+    [Arguments(false, false, "success")]
+    [Arguments(false, true, "success")]
+    [Arguments(true, false, "success")]
+    [Arguments(true, true, "success")]
+    [Arguments(false, false, "fault")]
+    [Arguments(false, true, "fault")]
+    [Arguments(true, false, "fault")]
+    [Arguments(true, true, "fault")]
+    [Arguments(false, false, "cancel")]
+    [Arguments(false, true, "cancel")]
+    [Arguments(true, false, "cancel")]
+    [Arguments(true, true, "cancel")]
+    public async Task ActualFirstSendHelperShouldReuseItsTaskWithoutConversionAllocation(
+        bool generated, bool sized, string completionBeforeConversion)
+    {
+        await using var fixture = new Fixture(generated ? "generated" : "client");
+        using var cancellation = new CancellationTokenSource();
+        var codec = new ProbeCodec(sized);
+        var expected = new InvalidOperationException("conversion race fault");
+        await fixture.BlockConnectionCreditAsync();
+        var send = fixture.First(codec, cancellation.Token);
+        Ensure(!send.IsCompletedSuccessfully && !send.IsCompleted,
+            "the real first-send helper must take its suspended path before the conversion race");
+        var backing = typeof(ValueTask<StreamFlowController.ResolvedSendCreditLease>)
+            .GetField("_obj", BindingFlags.Instance | BindingFlags.NonPublic)!.GetValue(send);
+        Ensure(backing is Task<StreamFlowController.ResolvedSendCreditLease>,
+            "this allocation optimization requires the actual helper to wrap a Task, not a reusable source");
+        var backingTask = (Task<StreamFlowController.ResolvedSendCreditLease>)backing!;
+
+        if (completionBeforeConversion != "pending")
+        {
+            if (completionBeforeConversion == "success") fixture.ReleaseBlockerCredit();
+            else if (completionBeforeConversion == "cancel") cancellation.Cancel();
+            else fixture.Session.CompleteSendStream(fixture.RequestId, 0, expected);
+            // Complete after the false check but before AsTask. Inspecting Task completion
+            // does not consume the ValueTask, including a future source-backed regression.
+            await WaitForCompletionAsync(backingTask).WaitAsync(TimeSpan.FromSeconds(5));
+        }
+
+        var warmTask = Task.FromResult(default(StreamFlowController.ResolvedSendCreditLease));
+        _ = ConvertOnce(new ValueTask<StreamFlowController.ResolvedSendCreditLease>(warmTask));
+        var before = GC.GetAllocatedBytesForCurrentThread();
+        var converted = ConvertOnce(send);
+        var conversionBytes = GC.GetAllocatedBytesForCurrentThread() - before;
+        Ensure(ReferenceEquals(converted, backingTask), "AsTask must return the helper's existing Task");
+        Ensure(conversionBytes == 0, $"first-binding conversion allocated {conversionBytes} bytes");
+        if (completionBeforeConversion == "pending") fixture.ReleaseBlockerCredit();
+        var failure = await CaptureFailureAsync(converted);
+        Ensure(completionBeforeConversion switch
+        {
+            "fault" => ReferenceEquals(failure, expected),
+            "cancel" => failure is OperationCanceledException canceled && canceled.CancellationToken == cancellation.Token,
+            _ => failure is null
+        }, "conversion must preserve the completion that raced the status check");
+        await fixture.WaitForCleanupAsync(codec, sized);
+        if (failure is null)
+        {
+            var lease = converted.GetAwaiter().GetResult();
+            Ensure(lease.IsResolved && fixture.Controller.SendConnectionCredit == 4,
+                "the task's successful result must carry the one published binding");
+            fixture.ReturnPublishedCredit(4);
+        }
+        else
+        {
+            fixture.ReleaseBlockerCredit();
+            Ensure(fixture.Controller.SendConnectionCredit == 8, "failed conversion must not retain send credit");
+        }
+    }
+
+    [MethodImpl(MethodImplOptions.NoInlining)]
+    private static Task<StreamFlowController.ResolvedSendCreditLease> ConvertOnce(
+        ValueTask<StreamFlowController.ResolvedSendCreditLease> send) => send.AsTask();
+
+    private static async Task WaitForCompletionAsync(Task task)
+    {
+        while (!task.IsCompleted) await Task.Yield();
+    }
+
+    private static async Task<Exception?> CaptureFailureAsync(Task task)
+    {
+        try { await task.WaitAsync(TimeSpan.FromSeconds(5)); return null; }
+        catch (Exception exception) when (exception is not TimeoutException) { return exception; }
+    }
+
+    private static void Ensure(bool condition, string message)
+    {
+        if (!condition) throw new InvalidOperationException(message);
+    }
+
+    private sealed class ProbeCodec(bool sized) : IRpcCodec<int>, IRpcSizedCodec<int>
+    {
+        internal Action? BeforeCredit { get; init; }
+        internal Action? BeforeSend { get; init; }
+        internal int SerializeCount { get; private set; }
+        internal int ReleaseCount { get; private set; }
+        internal TaskCompletionSource FirstSnapshotReleased { get; } = new(TaskCreationOptions.RunContinuationsAsynchronously);
+        public bool CanExactSize => sized;
+        public void Serialize(in int value, IBufferWriter<byte> buffer)
+        {
+            BeforeSend?.Invoke();
+            SerializeCount++;
+            BitConverter.TryWriteBytes(buffer.GetSpan(sizeof(int)), value);
+            buffer.Advance(sizeof(int));
+        }
+        public int Deserialize(in ReadOnlySequence<byte> buffer) => BitConverter.ToInt32(buffer.FirstSpan);
+        public bool TryGetEncodedSize(in int value, out int size) { size = sizeof(int); return sized; }
+        public bool TryGetEncodedSize(in int value, out int size, out IRpcSizedCodecSnapshot? snapshot)
+        {
+            size = sizeof(int);
+            snapshot = new Snapshot();
+            BeforeCredit?.Invoke();
+            return sized;
+        }
+        public void SerializeSized(in int value, IBufferWriter<byte> buffer, int size, IRpcSizedCodecSnapshot? snapshot)
+        {
+            Ensure(snapshot is Snapshot { Released: false } && size == sizeof(int), "serialization needs a live snapshot");
+            Serialize(in value, buffer);
+        }
+        public void ReleaseSnapshot(IRpcSizedCodecSnapshot? snapshot)
+        {
+            Ensure(snapshot is Snapshot { Released: false }, "a snapshot may only be released once");
+            ((Snapshot)snapshot!).Released = true;
+            ReleaseCount++;
+            FirstSnapshotReleased.TrySetResult();
+        }
+        private sealed class Snapshot : IRpcSizedCodecSnapshot { internal bool Released; }
+    }
+
+    private sealed class ProbeStream(int itemCount) : IAsyncEnumerable<int>, IAsyncEnumerator<int>, IValueTaskSource<bool>
+    {
+        private ManualResetValueTaskSourceCore<bool> _move = new();
+        internal SingleConsumptionDispose? DeferredDisposal { get; init; }
+        internal int MoveCount { get; private set; }
+        internal int ConsumptionCount { get; private set; }
+        internal int CurrentCount { get; private set; }
+        internal int DisposeCount { get; private set; }
+        internal CancellationToken EnumerationToken { get; private set; }
+        public int Current { get { CurrentCount++; return MoveCount; } }
+        public IAsyncEnumerator<int> GetAsyncEnumerator(CancellationToken cancellationToken = default)
+        {
+            EnumerationToken = cancellationToken;
+            return this;
+        }
+        public ValueTask<bool> MoveNextAsync()
+        {
+            Ensure(MoveCount == ConsumptionCount, "the previous reusable MoveNext source must be consumed first");
+            MoveCount++;
+            _move.SetResult(MoveCount <= itemCount);
+            return new ValueTask<bool>(this, _move.Version);
+        }
+        public bool GetResult(short token)
+        {
+            var result = _move.GetResult(token);
+            ConsumptionCount++;
+            _move.Reset(); // Invalidate the consumed token so a second GetResult is a real failure.
+            return result;
+        }
+        public ValueTaskSourceStatus GetStatus(short token) => _move.GetStatus(token);
+        public void OnCompleted(Action<object?> continuation, object? state, short token, ValueTaskSourceOnCompletedFlags flags)
+            => _move.OnCompleted(continuation, state, token, flags);
+        public ValueTask DisposeAsync()
+        {
+            DisposeCount++;
+            return DeferredDisposal is null ? ValueTask.CompletedTask : DeferredDisposal.Value;
+        }
+    }
+
+    private sealed class SingleConsumptionDispose : IValueTaskSource
+    {
+        private ManualResetValueTaskSourceCore<bool> _core = new() { RunContinuationsAsynchronously = true };
+        internal TaskCompletionSource Consumed { get; } = new(TaskCreationOptions.RunContinuationsAsynchronously);
+        internal int ConsumptionCount { get; private set; }
+        internal ValueTask Value => new(this, _core.Version);
+        internal void Fail(Exception exception) => _core.SetException(exception);
+        public void GetResult(short token)
+        {
+            try { _core.GetResult(token); }
+            finally
+            {
+                ConsumptionCount++;
+                _core.Reset();
+                Consumed.TrySetResult();
+            }
+        }
+        public ValueTaskSourceStatus GetStatus(short token) => _core.GetStatus(token);
+        public void OnCompleted(Action<object?> continuation, object? state, short token, ValueTaskSourceOnCompletedFlags flags)
+            => _core.OnCompleted(continuation, state, token, flags);
+    }
