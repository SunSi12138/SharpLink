+        internal async Task<int> CountDataFramesAsync()
+        {
+            // A marker makes the zero-DATA cases readable without waiting for a nonexistent frame.
+            Session.SendRpcErrorAsync(999, new SharpLinkException(SharpLinkErrorCode.Internal, "marker"));
+            await Session.FlushSendQueueAsync().AsTask().WaitAsync(TimeSpan.FromSeconds(5));
