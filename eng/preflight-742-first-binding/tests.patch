+public sealed class FirstBindingStreamPumpTests
+{
+    [Test]
+    [Arguments("client", false, false)]
+    [Arguments("client", true, false)]
+    [Arguments("generated", false, false)]
+    [Arguments("generated", true, false)]
+    [Arguments("generated-deadline", false, false)]
+    [Arguments("generated-deadline", true, false)]
+    [Arguments("client", false, true)]
+    [Arguments("client", true, true)]
+    [Arguments("generated", false, true)]
+    [Arguments("generated", true, true)]
+    [Arguments("generated-deadline", false, true)]
+    [Arguments("generated-deadline", true, true)]
+    public async Task FirstBindingShouldPublishEachItemOnceAndPreserveEnumeratorConsumption(
+        string mode, bool sized, bool blocked)
+    {
+        await using var fixture = new Fixture(mode);
+        var codec = new ProbeCodec(sized);
+        var stream = new ProbeStream(itemCount: 2);
+        if (blocked)
+            await fixture.BlockConnectionCreditAsync();
+
+        var pump = fixture.Start(stream, codec);
+        if (blocked)
+        {
+            Ensure(!pump.IsCompleted && stream.MoveCount == 1 && stream.ConsumptionCount == 1,
+                "the first send must suspend after consuming the first MoveNext result once");
+            Ensure(codec.SerializeCount == (sized ? 0 : 1),
+                "the blocked first send must retain sized/unsized serialization order");
+            fixture.ReleaseBlockerCredit();
+        }
+        await pump.WaitAsync(TimeSpan.FromSeconds(5));
+
+        Ensure(stream.MoveCount == 3 && stream.ConsumptionCount == 3 && stream.CurrentCount == 2,
+            "first binding and retained sends must consume each reusable source result and item once");
+        Ensure(stream.DisposeCount == 1 && codec.SerializeCount == 2 && codec.ReleaseCount == (sized ? 2 : 0),
+            "each item, sized snapshot, and enumerator must have one owner");
+        Ensure(fixture.Controller.SendConnectionCredit == 0 && fixture.Session.PreCreditSerializedBytes == 0,
+            "two publications must own exactly eight wire bytes and no serialized budget");
+        Ensure(await fixture.CountDataFramesAsync() == 2, "the writer must receive exactly two DATA frames");
+        fixture.AssertPumpTimersDisposed("successful first binding must dispose its deadline timer");
+        fixture.ReturnPublishedCredit(8);
+    }
