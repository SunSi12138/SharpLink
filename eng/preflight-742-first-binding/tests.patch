+    [Test]
+    [Arguments(false, false)]
+    [Arguments(true, false)]
+    [Arguments(false, true)]
+    [Arguments(true, true)]
+    public async Task ExpiredFirstBindingShouldBeatLateFaultOrCancellationAndObserveAbandonedDispose(
+        bool sized, bool cancel)
+    {
+        await using var fixture = new Fixture("generated-deadline");
+        using var cancellation = new CancellationTokenSource();
+        var codec = new ProbeCodec(sized);
+        var disposal = new SingleConsumptionDispose();
+        var stream = new ProbeStream(itemCount: 2) { DeferredDisposal = disposal };
+        await fixture.BlockConnectionCreditAsync();
+        var pump = fixture.Start(stream, codec, cancellation.Token);
+        Ensure(!pump.IsCompleted && fixture.Time.ActiveTimerCount == fixture.BaselineTimerCount + 1 && stream.MoveCount == 1,
+            "the deadline race must be at the first-send wait, not MoveNext or a retained send");
+
+        // Hold timer callbacks back: the monotonic boundary must still beat the late source
+        // terminal. This deterministically tests arbitration rather than scheduler ordering.
+        fixture.Time.AdvanceWithoutRunningTimers(TimeSpan.FromSeconds(1));
+        if (cancel)
+            cancellation.Cancel();
+        else
+            fixture.Session.CompleteSendStream(fixture.RequestId, 0, new InvalidOperationException("late send fault"));
+        var failure = await CaptureFailureAsync(pump);
+        Ensure(failure is SharpLinkException { Code: SharpLinkErrorCode.DeadlineExceeded },
+            "an expired deadline must retain priority over first-send fault/cancellation");
+        Ensure(stream.DisposeCount == 1 && !disposal.Consumed.Task.IsCompleted,
+            "the deadline terminal must not await a producer's still-pending disposal");
+        disposal.Fail(new InvalidOperationException("late disposal fault"));
+        await disposal.Consumed.Task.WaitAsync(TimeSpan.FromSeconds(5));
+        Ensure(disposal.ConsumptionCount == 1,
+            "the detached cleanup observer must consume and observe the faulted disposal exactly once");
+        await fixture.WaitForCleanupAsync(codec, sized);
+        await fixture.WaitForPumpTimerCleanupAsync();
+        Ensure(stream.ConsumptionCount == 1 && codec.ReleaseCount == (sized ? 1 : 0),
+            "deadline abandonment must not duplicate first-item or snapshot consumption");
+        fixture.ReleaseBlockerCredit();
+        Ensure(fixture.Controller.SendConnectionCredit == 8 && await fixture.CountDataFramesAsync() == 0,
+            "late credit must leave the abandoned first item unpublished and fully refunded");
+    }
