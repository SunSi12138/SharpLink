+    [Test]
+    public async Task InvalidResolvedReceiveLeasesShouldNotMutateLiveCredit()
+    {
+        var controller = new StreamFlowController(2, 4, 1024);
+        var current = controller.ResolveReceiveCreditLease(720, 1);
+        var detached = controller.ResolveReceiveCreditLease(721, 1);
+        controller.FlushConsumed(in detached);
+        controller.AcceptReceived(in current, 1);
+
+        StreamFlowController.ResolvedReceiveCreditLease[] invalidLeases =
+        [
+            default,
+            new(new StreamFlowController(2, 4, 1024), 720, 1, current.State!, current.Generation),
+            new(controller, 720, 1, null!, current.Generation),
+            new(controller, 720, 1, new object(), current.Generation),
+            new(controller, 720, 1, current.State!, current.Generation - 1),
+            detached,
+        ];
+        foreach (var invalid in invalidLeases)
+        {
+            try
+            {
+                controller.AcceptReceived(in invalid, 1);
+                throw new Exception("expected the invalid receive lease to be rejected");
+            }
+            catch (SharpLinkException exception)
+            {
+                Ensure(exception.Code == SharpLinkErrorCode.ConnectionClosed,
+                    "invalid receive leases must preserve the stream-closed error");
+            }
+
+            Ensure(controller.RecordConsumed(in invalid, 1) == 0,
+                "invalid receive leases must not return live credit");
+            Ensure(controller.FlushConsumed(in invalid) == 0,
+                "invalid receive leases must not complete the live stream");
+        }
+
+        controller.AcceptReceived(in current, 1);
+        Ensure(controller.RecordConsumed(in current, 2) == 2,
+            "the live receive lease must retain both bytes after invalid accesses");
+        await Task.CompletedTask;
+    }
