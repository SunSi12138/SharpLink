diff --git a/test/SharpLink.RouteCountProbe/Program.cs b/test/SharpLink.RouteCountProbe/Program.cs
new file mode 100644
index 0000000..934488c
--- /dev/null
+++ b/test/SharpLink.RouteCountProbe/Program.cs
@@ -0,0 +1,244 @@
+using System.Diagnostics;
+using System.IO.Pipelines;
+using System.Net;
+using System.Text.Json;
+using SharpLink.Abstractions;
+using SharpLink.Client;
+using SharpLink.Runtime;
+using SharpLink.Server;
+using SharpLink.StreamLoadTest;
+
+namespace SharpLink.RouteCountProbe;
+
+internal static class Program
+{
+    private const int WarmupCalls = 8;
+    private const int MeasuredCalls = 64;
+    private static readonly List<object> Stages = [];
+    private static Dictionary<string, Dictionary<string, long>> _previous = [];
+    private static Dictionary<string, Dictionary<string, long>> _previousFrames = [];
+
+    private static async Task Main()
+    {
+        PooledAsyncStreamDispatcher<int>.ClearPoolForTests();
+        var toServer = new Pipe();
+        var toClient = new Pipe();
+        var clientConnection = new MemoryConnection("client", toClient.Reader, toServer.Writer);
+        var serverConnection = new MemoryConnection("server", toServer.Reader, toClient.Writer);
+        using var serverCts = new CancellationTokenSource();
+        var server = (SharpLinkServer)SharpLinkServerBuilder.Create()
+            .UseTransport(new MemoryListener(serverConnection))
+            .UseHeartbeat(TimeSpan.FromHours(1), TimeSpan.FromHours(2)).Build();
+        var serverTask = ((ISharpLinkServer)server).RunUntilStoppedAsync(serverCts.Token).AsTask();
+        var client = (SharpLinkClient)SharpClientBuilder.Create().DisableRequestTimeout()
+            .UseTransport(new MemoryFactory(clientConnection))
+            .UseConnectionPool(options => { options.MinConnections = 1; options.MaxConnections = 1; })
+            .UseHeartbeat(TimeSpan.FromHours(1), TimeSpan.FromHours(2)).Build();
+        await client.ConnectAsync().AsTask().WaitAsync(TimeSpan.FromSeconds(10));
+        var service = client.Get<IStreamLoadService>();
+        Require(service.GetType().FullName!.Contains("Proxy", StringComparison.Ordinal), "real generated client proxy");
+        Snapshot("connected", 0, client, server);
+
+        await Unary("unary.warmup", WarmupCalls);
+        await Unary("unary.measured", MeasuredCalls);
+        Require(RouteDiagnosticCounters.Managers.Values.All(m => m.RouteCounts.Snapshot().Values.All(value => value == 0)),
+            "pure successful unary must not enter any instrumented stream route method before any stream exists");
+        Require(PooledAsyncStreamDispatcher<int>.RetainedCountForTests == 0, "pure unary must not rent a stream dispatcher");
+        await Server1("server1.warmup", WarmupCalls);
+        await Server1("server1.measured", MeasuredCalls);
+        await Unary("post-stream.unary-fence", 1);
+        await Drain(client, server);
+        Snapshot("pre-teardown", 0, client, server);
+
+        await client.DisposeAsync();
+        await serverCts.CancelAsync();
+        await server.DisposeAsync();
+        try { await serverTask.WaitAsync(TimeSpan.FromSeconds(10)); }
+        catch (OperationCanceledException) { }
+        Snapshot("teardown", 0, client, server);
+        Require(client.FrameworkTaskSnapshotForDiagnostics.IsDrained &&
+                server.FrameworkTaskSnapshotForDiagnostics.IsDrained &&
+                client.FrameworkTaskSnapshotForDiagnostics.RetainedFailures == 0 &&
+                server.FrameworkTaskSnapshotForDiagnostics.RetainedFailures == 0,
+                "client and server framework tasks fully drained without retained failure");
+        var clientFrames = RouteDiagnosticCounters.Managers["Client"].RouteCounts.FrameSnapshot();
+        var serverFrames = RouteDiagnosticCounters.Managers["Server"].RouteCounts.FrameSnapshot();
+        Require(clientFrames.GetValueOrDefault("Response") == 2 * (WarmupCalls + MeasuredCalls) + 1,
+                "one response frame per successful RPC, including streaming acknowledgements and the separated unary fence");
+        Require(clientFrames.GetValueOrDefault("StreamData") == WarmupCalls + MeasuredCalls &&
+                clientFrames.GetValueOrDefault("StreamComplete") == WarmupCalls + MeasuredCalls,
+                "one data and one terminal frame per server1 operation");
+        Require(serverFrames.GetValueOrDefault("Request") == 2 * (WarmupCalls + MeasuredCalls) + 1,
+                "one server-received request frame per generated RPC");
+        Require(clientFrames.GetValueOrDefault("ErrorFlag") == 0 && serverFrames.GetValueOrDefault("ErrorFlag") == 0 &&
+                clientFrames.GetValueOrDefault("Cancel") == 0 && serverFrames.GetValueOrDefault("Cancel") == 0,
+                "no error or cancel frames");
+        var counters = RouteDiagnosticCounters.Managers.ToDictionary(pair => pair.Key, pair => pair.Value.RouteCounts.Snapshot());
+        var enabled = QuiescentCompletionDiagnostic.IsEnabled();
+        var totals = counters.Values.SelectMany(x => x).GroupBy(x => x.Key).ToDictionary(g => g.Key, g => g.Sum(x => x.Value));
+        Require(totals.GetValueOrDefault("RegisterCore") == WarmupCalls + MeasuredCalls, "one route per server stream");
+        Require(totals.GetValueOrDefault("DispatchChunk") == WarmupCalls + MeasuredCalls, "one StreamData dispatch per server stream");
+        Require(totals.GetValueOrDefault("CompleteStream") == WarmupCalls + MeasuredCalls, "one CompleteStream per server stream");
+        Require(totals.GetValueOrDefault("TryBeginQuiescentDirectCompletion") == (enabled ? WarmupCalls + MeasuredCalls : 0), "mode-specific helper entry count");
+        Require(totals.GetValueOrDefault("QuiescentClaimSucceeded") == (enabled ? WarmupCalls + MeasuredCalls : 0), "mode-specific successful claims");
+        Require(totals.GetValueOrDefault("QuiescentCompletionSucceeded") == (enabled ? WarmupCalls + MeasuredCalls : 0), "mode-specific successful completions");
+        Require(totals.GetValueOrDefault("DispatchesDrainedNotification") == WarmupCalls + MeasuredCalls, "one drain notification per entry");
+        Console.WriteLine(JsonSerializer.Serialize(new
+        {
+            diagnosticOnly = true,
+            timingClaims = false,
+            mode = enabled ? "ON" : "OFF",
+            transport = "paired in-memory System.IO.Pipelines; no OS sockets or pipes",
+            proxyType = service.GetType().FullName,
+            warmupCalls = WarmupCalls,
+            measuredCalls = MeasuredCalls,
+            stages = Stages,
+            totals,
+            passed = true
+        }, new JsonSerializerOptions { WriteIndented = true }));
+
+        async Task Unary(string name, int count)
+        {
+            for (var i = 0; i < count; i++) Require(await service.AddAsync(7, 9) == 16, "AddAsync(7,9) == 16");
+            await Drain(client, server);
+            Snapshot(name, count, client, server);
+        }
+        async Task Server1(string name, int count)
+        {
+            for (var i = 0; i < count; i++)
+            {
+                var values = new List<int>();
+                await foreach (var value in service.DownloadAsync(1)) values.Add(value);
+                Require(values.SequenceEqual([0]), "DownloadAsync(1) yields exactly [0]");
+                // Quiesce each operation so snapshots and retained dispatcher reuse are exact.
+                await Drain(client, server);
+            }
+            Snapshot(name, count, client, server);
+        }
+    }
+
+    private static async Task Drain(SharpLinkClient client, SharpLinkServer server)
+    {
+        var timeout = Stopwatch.StartNew();
+        while (client.PendingCallCount != 0 || client.ActiveClientCallCount != 0 ||
+               server.ActiveCallCountForDiagnostics != 0 ||
+               RouteDiagnosticCounters.Managers.Values.Any(m => !m.RouteCounts.Entries.IsEmpty) &&
+                   PooledAsyncStreamDispatcher<int>.RetainedCountForTests != 1 ||
+               RouteDiagnosticCounters.Managers.Values.Any(m => m.ActiveStreamCount != 0 ||
+                   m.RouteCounts.Entries.Any(e => !e.IsReceiveRetired || !e.IsDetached || e.HasActiveDispatches ||
+                       e.Dispatcher is PooledAsyncStreamDispatcher<int> d && RetainedRpcReferences(d).Length != 0)))
+        {
+            if (timeout.Elapsed > TimeSpan.FromSeconds(10))
+            {
+                Snapshot("timeout", 0, client, server);
+                Console.Error.WriteLine(JsonSerializer.Serialize(Stages, new JsonSerializerOptions { WriteIndented = true }));
+                throw new TimeoutException("RPC route and pool drain did not finish");
+            }
+            await Task.Delay(1);
+        }
+    }
+
+    private static void Snapshot(string stage, int calls, SharpLinkClient client, SharpLinkServer server)
+    {
+        var current = RouteDiagnosticCounters.Managers.ToDictionary(pair => pair.Key, pair => pair.Value.RouteCounts.Snapshot());
+        var delta = current.ToDictionary(pair => pair.Key, pair => pair.Value.ToDictionary(
+            item => item.Key, item => item.Value - (_previous.GetValueOrDefault(pair.Key)?.GetValueOrDefault(item.Key) ?? 0)));
+        var frames = RouteDiagnosticCounters.Managers.ToDictionary(pair => pair.Key, pair => pair.Value.RouteCounts.FrameSnapshot());
+        var frameDelta = frames.ToDictionary(pair => pair.Key, pair => pair.Value.ToDictionary(
+            item => item.Key, item => item.Value - (_previousFrames.GetValueOrDefault(pair.Key)?.GetValueOrDefault(item.Key) ?? 0)));
+        var states = RouteDiagnosticCounters.Managers.ToDictionary(pair => pair.Key, pair => new
+        {
+            activeStreams = pair.Value.ActiveStreamCount,
+            totalEntries = pair.Value.RouteCounts.Entries.Count,
+            retiredEntries = pair.Value.RouteCounts.Entries.Count(e => e.IsReceiveRetired),
+            detachedEntries = pair.Value.RouteCounts.Entries.Count(e => e.IsDetached),
+            busyEntries = pair.Value.RouteCounts.Entries.Count(e => e.HasActiveDispatches),
+            pooledDispatcherReferencesClean = pair.Value.RouteCounts.Entries.All(e =>
+                e.Dispatcher is not PooledAsyncStreamDispatcher<int> d || RetainedRpcReferences(d).Length == 0)
+        });
+        Stages.Add(new { stage, calls, delta, cumulative = current, frameDelta, frames, states,
+            clientFrameworkTasks = client.FrameworkTaskSnapshotForDiagnostics,
+            serverFrameworkTasks = server.FrameworkTaskSnapshotForDiagnostics,
+            clientPendingCalls = client.PendingCallCount, clientActiveCalls = client.ActiveClientCallCount,
+            serverActiveCalls = server.ActiveCallCountForDiagnostics,
+            pooledIntDispatchers = PooledAsyncStreamDispatcher<int>.RetainedCountForTests });
+        _previous = current;
+        _previousFrames = frames;
+    }
+
+    private static string[] RetainedRpcReferences(PooledAsyncStreamDispatcher<int> dispatcher)
+    {
+        // The existing HasRetainedReferencesForTests predicate unconditionally tests
+        // `_current is not null`, which is always true for int. Inspect the same RPC
+        // reference/token fields directly. int data slots cannot retain object graphs.
+        string[] names = ["_codec", "_error", "_dispatchState", "_receiveCreditBinding",
+            "_localAbortReceiveCreditBinding", "_consumerAbandoned", "_consumerAbandonedAsync",
+            "_disposeCompletion", "_remoteTerminalPublication",
+            "_beforeConcurrentDisposeCompletionInstallForTests",
+            "_beforeRemoteTerminalPublicationPublishForTests",
+            "_beforeRemoteTerminalPublicationCompletionInstallForTests",
+            "_afterRemoteTerminalPublicationCompletionInstallForTests",
+            "_beforeProducerOperationAcquireForTests", "_beforeConsumerWaitOwnerAcquireForTests",
+            "_afterConsumerWaitResultForTests", "_beforeReturnTransitionForTests", "_afterReturnTransitionForTests"];
+        var type = dispatcher.GetType();
+        object? Read(string name) => (type.GetField(name,
+            System.Reflection.BindingFlags.Instance | System.Reflection.BindingFlags.NonPublic)
+            ?? throw new InvalidOperationException("Missing reference-check field " + name)).GetValue(dispatcher);
+        var retained = names.Where(name => Read(name) is not null).ToList();
+        foreach (var name in new[] { "_enumerationToken", "_additionalEnumerationToken" })
+            if (((CancellationToken)Read(name)!).CanBeCanceled) retained.Add(name);
+        foreach (var name in new[] { "_enumerationCancellationRegistration", "_additionalEnumerationCancellationRegistration" })
+            if (!((CancellationTokenRegistration)Read(name)!).Equals(default(CancellationTokenRegistration))) retained.Add(name);
+        return retained.ToArray();
+    }
+
+    private static void Require(bool condition, string reason)
+    {
+        if (!condition)
+        {
+            Console.Error.WriteLine(JsonSerializer.Serialize(Stages, new JsonSerializerOptions { WriteIndented = true }));
+            throw new InvalidOperationException("Proof failed: " + reason);
+        }
+    }
+}
+
+internal sealed class MemoryConnection(string id, PipeReader input, PipeWriter output) : ITransportConnection
+{
+    private int _disposed;
+    public string Id => id;
+    public PipeReader Input => input;
+    public PipeWriter Output => output;
+    public EndPoint? LocalEndPoint => null;
+    public EndPoint? RemoteEndPoint => null;
+    public async ValueTask DisposeAsync()
+    {
+        if (Interlocked.Exchange(ref _disposed, 1) != 0) return;
+        await Output.CompleteAsync();
+        await Input.CompleteAsync();
+    }
+}
+
+internal sealed class MemoryListener(ITransportConnection connection) : IServerTransportListener
+{
+    private int _accepted;
+    public EndPoint? LocalEndPoint => null;
+    public async ValueTask<ITransportConnection> AcceptAsync(CancellationToken cancellationToken = default)
+    {
+        if (Interlocked.Exchange(ref _accepted, 1) == 0) return connection;
+        await Task.Delay(Timeout.InfiniteTimeSpan, cancellationToken);
+        throw new UnreachableException();
+    }
+    public ValueTask DisposeAsync() => ValueTask.CompletedTask;
+}
+
+internal sealed class MemoryFactory(ITransportConnection connection) : IClientTransportFactory
+{
+    private int _connected;
+    public ValueTask<ITransportConnection> ConnectAsync(CancellationToken cancellationToken = default)
+    {
+        cancellationToken.ThrowIfCancellationRequested();
+        if (Interlocked.Exchange(ref _connected, 1) != 0) throw new InvalidOperationException("Only one in-memory connection is available");
+        return ValueTask.FromResult(connection);
+    }
+    public ValueTask DisposeAsync() => ValueTask.CompletedTask;
+}
