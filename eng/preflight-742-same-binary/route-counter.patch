@@ -0,0 +1,55 @@
+namespace SharpLink.Runtime;
+
+// Counter-only local route proof. This file and every hit are excluded from timed binaries.
+internal sealed partial class StreamManager
+{
+    internal readonly RouteDiagnosticCounters RouteCounts = new();
+}
+
+internal sealed class RouteDiagnosticCounters
+{
+    internal static readonly ConcurrentDictionary<string, StreamManager> Managers = new();
+    private static readonly string[] Names =
+    [
+        "RegisterCore",
+        "DispatchChunk",
+        "CompleteStream",
+        "CompleteStream.NullMap",
+        "CompleteStream.LookupMiss",
+        "TryBeginQuiescentDirectCompletion",
+        "QuiescentClaimSucceeded",
+        "QuiescentCompletionSucceeded",
+        "CompleteRequestStreams",
+        "CompleteRequestStreams.NullMap",
+        "CompleteRequestStreams.LookupMiss",
+        "CompleteRequestStreams.EmptyDrain",
+        "CompleteRequestStreams.DrainedEntries",
+        "CompleteRequestStreamsAfterDispatches",
+        "CompleteRequestStreamsAfterDispatches.NullMap",
+        "CompleteRequestStreamsAfterDispatches.LookupMiss",
+        "CompleteRequestStreamsAfterDispatches.EmptyDrain",
+        "CompleteRequestStreamsAfterDispatches.DrainedEntries",
+        "DispatchesDrainedNotification",
+        "CompleteAll",
+        "CompleteAll.Repeated",
+        "CompleteAll.NullMap",
+        "CompleteAll.DrainedEntries"
+    ];
+    private readonly long[] _counts = new long[Names.Length];
+    internal readonly ConcurrentQueue<StreamManager.DispatcherEntry> Entries = new();
+    private readonly ConcurrentDictionary<string, long> _frames = new();
+    internal void Frame(ProtocolV2FrameType type, ProtocolV2FrameFlags flags)
+    {
+        _frames.AddOrUpdate(type.ToString(), 1, static (_, count) => count + 1);
+        if ((flags & ProtocolV2FrameFlags.Error) != 0)
+            _frames.AddOrUpdate("ErrorFlag", 1, static (_, count) => count + 1);
+    }
+    internal Dictionary<string, long> FrameSnapshot() => new(_frames);
+    internal void Hit(string name, long amount = 1) => Interlocked.Add(ref _counts[Array.IndexOf(Names, name)], amount);
+    internal Dictionary<string, long> Snapshot()
+    {
+        var result = new Dictionary<string, long>();
+        for (var i = 0; i < Names.Length; i++) result.Add(Names[i], Volatile.Read(ref _counts[i]));
+        return result;
+    }
+}
