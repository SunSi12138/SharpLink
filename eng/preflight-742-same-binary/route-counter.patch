@@ -0,0 +1,18 @@
+#!/usr/bin/env bash
+# Diagnostic counts only. Invoke after activating the normal .NET SDK.
+set -euo pipefail
+root=$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)
+cd "$root"
+out=${1:-evidence}
+mkdir -p "$out"
+dotnet build test/SharpLink.RouteCountProbe/SharpLink.RouteCountProbe.csproj -c Release -m:1 -v minimal > "$out/build-final.log" 2>&1
+bin=test/SharpLink.RouteCountProbe/bin/Release/net10.0
+sha256sum "$bin"/SharpLink*.dll > "$out/binary-sha256-before.txt"
+for round in 1 2 3; do
+  for mode in 0 1; do
+    SHARPLINK_DIAGNOSTIC_QUIESCENT=$mode dotnet "$bin/SharpLink.UnitTests.dll" \
+      > "$out/mode-$mode-run-$round.json" 2> "$out/mode-$mode-run-$round.err"
+  done
+done
+sha256sum "$bin"/SharpLink*.dll > "$out/binary-sha256-after.txt"
+diff -u "$out/binary-sha256-before.txt" "$out/binary-sha256-after.txt"
