new file mode 100644
index 00000000..564744ab
--- /dev/null
+++ b/test/SharpLink.UnitTests/Runtime/QuiescentDiagnosticModeTests.cs
@@ -0,0 +1,25 @@
+namespace SharpLink.UnitTests.Runtime;
+
+[NotInParallel("quiescent-diagnostic-environment")]
+public sealed class QuiescentDiagnosticModeTests
+{
+    [Test]
+    public void ModeMustBeFixedAtModuleInitializationAndCannotBeReconfigured()
+    {
+        var initial = QuiescentCompletionDiagnostic.IsEnabled();
+        var key = QuiescentCompletionDiagnostic.EnvironmentVariable;
+        var previous = Environment.GetEnvironmentVariable(key);
+        try
+        {
+            Environment.SetEnvironmentVariable(key, initial ? "0" : "1");
+            if (QuiescentCompletionDiagnostic.IsEnabled() != initial)
+                throw new InvalidOperationException("The process diagnostic mode changed after module initialization.");
+            Exception? actual = null;
+            try { QuiescentCompletionDiagnostic.InitializeForProcess(); }
+            catch (Exception error) { actual = error; }
+            if (actual is not InvalidOperationException || QuiescentCompletionDiagnostic.IsEnabled() != initial)
+                throw new InvalidOperationException("The diagnostic adapter allowed reconfiguration.");
+        }
+        finally { Environment.SetEnvironmentVariable(key, previous); }
+    }
+}
