index 00000000..376bec62
--- /dev/null
+++ b/src/SharpLink.Runtime/QuiescentCompletionDiagnostic.cs
@@ -0,0 +1,26 @@
+namespace SharpLink.Runtime;
+
+// Disposable experiment adapter only. This file is never part of shipping F/G2.
+internal static class QuiescentCompletionDiagnostic
+{
+    internal const string EnvironmentVariable = "SHARPLINK_DIAGNOSTIC_QUIESCENT";
+    private static int s_initialized;
+    // Deliberately not readonly: the JIT must load the same field in both process modes.
+    private static int s_enabled;
+
+    internal static void InitializeForProcess()
+    {
+        if (Interlocked.CompareExchange(ref s_initialized, 1, 0) != 0)
+            throw new InvalidOperationException("The diagnostic mode is fixed at process module initialization.");
+        var mode = Environment.GetEnvironmentVariable(EnvironmentVariable);
+        Volatile.Write(ref s_enabled, mode switch
+        {
+            null or "1" => 1,
+            "0" => 0,
+            _ => throw new InvalidOperationException("SHARPLINK_DIAGNOSTIC_QUIESCENT must be 0 or 1.")
+        });
+    }
+
+    [MethodImpl(MethodImplOptions.NoInlining)]
+    internal static bool IsEnabled() => Volatile.Read(ref s_enabled) != 0;
+}
