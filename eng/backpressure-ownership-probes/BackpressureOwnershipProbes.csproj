<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Reuses the existing friend assembly; no production visibility change. -->
    <AssemblyName>SharpLink.Benchmarks</AssemblyName>
    <IsPackable>false</IsPackable>
    <Optimize>true</Optimize>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="SharpLink.Runtime">
      <HintPath>$(RuntimeDir)/SharpLink.Runtime.dll</HintPath>
    </Reference>
    <Reference Include="SharpLink.Abstractions">
      <HintPath>$(RuntimeDir)/SharpLink.Abstractions.dll</HintPath>
    </Reference>
  </ItemGroup>
  <Target Name="RequireRuntimeSnapshot" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(RuntimeDir)/SharpLink.Runtime.dll')"
           Text="Set RuntimeDir to a built repository src/SharpLink.Runtime/bin/Release/net10.0 directory." />
  </Target>
</Project>
