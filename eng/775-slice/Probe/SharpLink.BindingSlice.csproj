<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../../test/SharpLink.UnitTests/Runtime/ManualTimeProvider.cs" Link="ManualTimeProvider.cs" />
    <ProjectReference Include="../../../src/SharpLink.Client/SharpLink.Client.csproj" />
    <ProjectReference Include="../../../src/SharpLink.Server/SharpLink.Server.csproj" />
    <ProjectReference Include="../../../src/SharpLink.Generator/SharpLink.Generator.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <Target Name="RequireNonshippingProfile" BeforeTargets="BeforeBuild"
          Condition="'$(SharpLink775StaticSlice)' != 'true'">
    <Error Text="This nonshipping probe requires -p:SharpLink775StaticSlice=true." />
  </Target>
</Project>
