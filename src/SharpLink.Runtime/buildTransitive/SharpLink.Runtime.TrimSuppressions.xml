<?xml version="1.0" encoding="utf-8"?>
<linker>
  <assembly fullname="SharpLink.Runtime">
    <!--
      PackageReference + TrimMode=partial keeps SharpLink.Runtime as a copy assembly.
      The packaged RuntimeHostConfigurationOption disables this fallback at runtime,
      but ILLink still analyzes the copied method bodies and reports the guarded RUC calls.
      These suppressions are imported only by the packaged partial-trim target.
    -->
    <attribute fullname="System.Diagnostics.CodeAnalysis.UnconditionalSuppressMessageAttribute">
      <argument>ILLink</argument>
      <argument>IL2026</argument>
      <property name="Scope">member</property>
      <property name="Target">M:SharpLink.Runtime.RpcUnsafeBlitPlatform.EnsureSupported(System.Type)</property>
    </attribute>
    <attribute fullname="System.Diagnostics.CodeAnalysis.UnconditionalSuppressMessageAttribute">
      <argument>ILLink</argument>
      <argument>IL2026</argument>
      <property name="Scope">member</property>
      <property name="Target">M:SharpLink.Runtime.RpcUnsafeBlitPlatform.IsSupported(System.Type,System.Int32,System.Boolean)</property>
    </attribute>
    <!--
      The manifest locator constructor parameter already carries
      DynamicallyAccessedMembers(PublicParameterlessConstructor). CustomAttributeData
      does not preserve that dataflow fact when exposing ConstructorArguments.Value,
      so copy-action analysis reports IL2072 even though the generated locator roots
      the public parameterless constructor.
    -->
    <attribute fullname="System.Diagnostics.CodeAnalysis.UnconditionalSuppressMessageAttribute">
      <argument>ILLink</argument>
      <argument>IL2072</argument>
      <property name="Scope">member</property>
      <property name="Target">M:SharpLink.Runtime.SharpLinkAssemblyManifestLoader.TryLoad(System.Reflection.Assembly,SharpLink.Abstractions.ISharpLinkGeneratedAssemblyManifest@)</property>
    </attribute>
  </assembly>
</linker>
