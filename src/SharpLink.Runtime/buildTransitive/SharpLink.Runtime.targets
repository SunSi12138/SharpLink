<Project>
  <!--
    PublishTrimmed is not guaranteed to be known during project evaluation. Apple workloads,
    for example, compute it in _ComputePublishTrimmed. Configure the final-consumer switch at
    target execution time, after that late computation when present, and before both runtimeconfig
    generation and ILLink consume RuntimeHostConfigurationOption.
  -->
  <Target Name="SharpLinkConfigureUnsafeBlitTrimming"
          AfterTargets="_ComputePublishTrimmed"
          BeforeTargets="_GenerateRuntimeConfigurationFilesInputCache;_PrepareTrimConfiguration"
          Condition="'$(PublishTrimmed)' == 'true' or '$(PublishAot)' == 'true'">
    <ItemGroup>
      <RuntimeHostConfigurationOption Remove="SharpLink.Runtime.UnsafeBlitReflectionFallback" />
      <RuntimeHostConfigurationOption Include="SharpLink.Runtime.UnsafeBlitReflectionFallback"
                                      Value="false"
                                      Trim="true" />
      <_ILLinkSuppressions Include="$(MSBuildThisFileDirectory)SharpLink.Runtime.TrimSuppressions.xml"
                           Condition="'$(PublishTrimmed)' == 'true' and '$(TrimMode)' == 'partial'" />
    </ItemGroup>
    <PropertyGroup>
      <SharpLinkUnsafeBlitTrimConfigurationApplied>true</SharpLinkUnsafeBlitTrimConfigurationApplied>
    </PropertyGroup>
  </Target>
</Project>
