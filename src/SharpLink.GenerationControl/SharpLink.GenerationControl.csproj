<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- This package first ships after 2.0.0, so there is no published 2.0.0 NuGet baseline to compare against. -->
    <PackageValidationBaselineVersion />
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\SharpLink.Abstractions\SharpLink.Abstractions.csproj" />
    <ProjectReference Include="..\SharpLink.Generator\SharpLink.Generator.csproj"
                      Condition="'$(PublishAot)' != 'true'"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"
                      GlobalPropertiesToRemove="RuntimeIdentifier;SelfContained;PublishAot;PublishSingleFile" />
  </ItemGroup>
</Project>
