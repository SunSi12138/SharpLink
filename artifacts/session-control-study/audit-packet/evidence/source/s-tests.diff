+                {
+                    ["oldSessionId"] = oldSessionId,
+                    ["notificationHeld"] = true
+                });
+            }
+            else
+            {
+                // P has no cut hook. The manifest publish worker runs only after the registry
+                // commit; holding its barrier proves the commit happened while the client still
