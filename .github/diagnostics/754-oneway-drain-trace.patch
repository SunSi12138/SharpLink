diff --git a/test/SharpLink.IntegrationTests/OneWayDrainTrace.cs b/test/SharpLink.IntegrationTests/OneWayDrainTrace.cs
new file mode 100644
index 0000000..31ce764
--- /dev/null
+++ b/test/SharpLink.IntegrationTests/OneWayDrainTrace.cs
@@ -0,0 +1,240 @@
+using System.Reflection;
+using System.Text;
+using SharpLink.Client;
+using SharpLink.Server;
+
+namespace SharpLink.IntegrationTests;
+
+// Temporary, test-only diagnostic. No hooks, production locks, timers, or background polling.
+// All reads are deliberately non-atomic observations; absence is NOT proof of non-publication.
+internal sealed class OneWayDrainTrace
+{
+    private const BindingFlags Fields = BindingFlags.Instance | BindingFlags.Public | BindingFlags.NonPublic;
+    private const int MaxEntries = 16;
+    private readonly List<string> _observations = new(8);
+    private readonly long _started = System.Diagnostics.Stopwatch.GetTimestamp();
+    private int _yielded;
+
+    // Same iteration/cancellation/Task.Yield schedule as the original ToAsyncEnumerable.
+    internal async IAsyncEnumerable<int> Produce(
+        [System.Runtime.CompilerServices.EnumeratorCancellation] CancellationToken cancellationToken)
+    {
+        foreach (var value in Enumerable.Range(1, 256))
+        {
+            cancellationToken.ThrowIfCancellationRequested();
+            Interlocked.Increment(ref _yielded);
+            yield return value;
+            await Task.Yield();
+        }
+    }
+
+    internal void Capture(string stage, ISharpLinkClient client, ISharpLinkServer server, Task? sender)
+    {
+        try
+        {
+            CaptureCore(stage, client, server, sender);
+        }
+        catch (Exception)
+        {
+            // Diagnostics must never replace the original test outcome, even on formatting failure.
+        }
+    }
+
+    private void CaptureCore(string stage, ISharpLinkClient client, ISharpLinkServer server, Task? sender)
+    {
+        if (_observations.Count >= 8)
+            return;
+        var text = new StringBuilder(2048);
+        text.Append($"stage={stage} startMs={Elapsed():F3} yielded={Volatile.Read(ref _yielded)} sender={sender?.Status.ToString() ?? "not-started"}");
+        Observe(text, "client-discovery", () =>
+        {
+            // The ready array is published as a replacement array; never enumerate _connections.
+            var ready = Read(client, "_readyConnections") as Array;
+            text.Append($" clientReady={ready?.Length}");
+            if (ready is not null)
+                for (var index = 0; index < Math.Min(ready.Length, MaxEntries); index++)
+                    Observe(text, "client-session", () =>
+                        Session(text, "client", Read(ready.GetValue(index), "<Session>k__BackingField")));
+        });
+        Observe(text, "server-discovery", () =>
+        {
+            // ConcurrentDictionary enumeration is safe and does not acquire its global locks.
+            var serverCount = 0;
+            foreach (var pair in ServerRegistryTestAccessor.ActiveConnections((SharpLinkServer)server).Take(MaxEntries))
+            {
+                serverCount++;
+                Observe(text, "server-session", () =>
+                    Session(text, "server", Read(pair.Value, "<Session>k__BackingField")));
+            }
+            text.Append($" serverSessionsObserved={serverCount}");
+        });
+        text.Append($" endMs={Elapsed():F3}");
+        _observations.Add(text.ToString());
+    }
+
+    private static void Observe(StringBuilder text, string scope, Action observation)
+    {
+        try
+        {
+            observation();
+        }
+        catch (Exception error)
+        {
+            text.Append($" snapshot-error[{scope}]={error.GetType().Name}:{error.Message}");
+        }
+    }
+
+    internal void Dump()
+    {
+        // Called only after the test outcome, before harness teardown changes the evidence.
+        try
+        {
+            foreach (var observation in _observations)
+                Console.WriteLine("ONEWAY-DRAIN " + observation);
+        }
+        catch (Exception)
+        {
+            // Output failure (including a disposed writer) must not replace the original test result.
+        }
+        try
+        {
+            var path = Environment.GetEnvironmentVariable("SHARPLINK_ONEWAY_DRAIN_TRACE_OUTPUT");
+            if (!string.IsNullOrWhiteSpace(path))
+            {
+                var directory = Path.GetDirectoryName(path);
+                if (!string.IsNullOrEmpty(directory))
+                    Directory.CreateDirectory(directory);
+                File.WriteAllLines(path, _observations.Select(static item => "ONEWAY-DRAIN " + item));
+            }
+        }
+        catch (Exception)
+        {
+            // Optional artifact output is independent of console output and observational only.
+        }
+    }
+
+    private double Elapsed() => System.Diagnostics.Stopwatch.GetElapsedTime(_started).TotalMilliseconds;
+
+    private static void Session(StringBuilder text, string side, object? session)
+    {
+        text.Append($"\n {side} session={Read(session, "<Id>k__BackingField")}");
+        var manager = Read(session, "<StreamManager>k__BackingField");
+        Values(text, manager, "_activeStreamCount", "_droppedStreamFrames", "_termination");
+        var routes = Read(manager, "_dispatchersByRequestId");
+        text.Append($" routingMaterialized={routes is not null}");
+        var maps = Read(routes, "_maps") as Array;
+        if (maps is not null)
+        {
+            text.Append($" stripes={maps.Length}");
+            for (var stripe = 0; stripe < Math.Min(maps.Length, 64); stripe++)
+            {
+                var map = maps.GetValue(stripe);
+                if ((int)Read(map, "_count")! > MaxEntries)
+                    text.Append($" stripe={stripe}:entry-prefix-truncated");
+                foreach (var (key, request) in Entries(map))
+                {
+                    text.Append($"\n  route request={key} stripe={stripe}");
+                    Entry(text, "default", Read(request, "_defaultDispatcher"));
+                    var streams = Read(request, "_byStreamId");
+                    text.Append(" streams");
+                    Values(text, streams, "_count", "_freeCount");
+                    foreach (var (stream, entry) in Entries(streams))
+                        Entry(text, $"stream={stream}", entry);
+                }
+            }
+            if (maps.Length > 64)
+                text.Append(" stripes-truncated");
+        }
+        var flow = Read(Read(session, "_protocolState"), "<FlowController>k__BackingField");
+        text.Append($"\n  flow={flow is not null}");
+        if (flow is null)
+            return;
+        Values(text, flow, "_sendConnectionCredit", "_receiveConnectionCredit", "_pendingConnectionConsumed",
+            "_activeSendStreamCount", "_pendingSendStateWaiterCount", "_terminalException");
+        foreach (var name in new[] { "_sendStates", "_receiveStates" })
+        {
+            var dictionary = Read(flow, name);
+            text.Append($"\n   {name}");
+            Values(text, dictionary, "_count", "_freeCount");
+            if ((int)Read(dictionary, "_count")! > MaxEntries)
+                text.Append(" entry-prefix-truncated");
+            foreach (var (key, state) in Entries(dictionary))
+            {
+                text.Append($" [{key}");
+                Values(text, state, "Credit", "Completed");
+                if (name == "_sendStates")
+                    Values(text, state, "Lease", "AbortException");
+                else
+                    Values(text, state, "PendingConsumed");
+                text.Append(']');
+            }
+        }
+        var waiters = Read(flow, "_waiters");
+        text.Append($"\n   waiters={Read(waiters, "count")}");
+        var head = Read(waiters, "head");
+        var node = head;
+        for (var index = 0; node is not null && index < MaxEntries; index++)
+        {
+            var waiter = Read(node, "item");
+            text.Append(" [waiter");
+            Values(text, waiter, "Key", "EncodedBytes", "CanCreateState", "Rejection");
+            text.Append(']');
+            node = Read(node, "next");
+            if (ReferenceEquals(node, head))
+                break;
+        }
+    }
+
+    private static void Entry(StringBuilder text, string label, object? entry)
+    {
+        text.Append($" {label}:entry={entry is not null}");
+        if (entry is null)
+            return;
+        Values(text, entry, "_state", "_detached", "_receiveTerminalPublished", "_peerTerminalReceived");
+        var dispatcher = Read(entry, "<Dispatcher>k__BackingField");
+        text.Append($" dispatcher={dispatcher?.GetType().Name}");
+        if (dispatcher?.GetType().Name != "PreAdmissionStreamDispatcher")
+            return;
+        Values(text, dispatcher, "_requestId", "_streamId", "_retainedBytes", "_discarding", "_completed",
+            "_completionForwarded", "_localAbandonRequested", "_retainUntilLocalCompletion", "_attachmentInProgress",
+            "_childClosed", "_childDetached", "_activeChildDispatches");
+        text.Append($" queuedItems={Read(Read(dispatcher, "_items"), "_size")}");
+    }
+
+    // Do not enumerate mutable Dictionary instances or invoke getters that may lock.
+    // Inspect a bounded prefix of their backing arrays instead. .NET 10 private layout is
+    // intentional here; concurrent resizing/recycling can make this view stale/inconsistent.
+    private static IEnumerable<(object? Key, object? Value)> Entries(object? dictionary)
+    {
+        if (dictionary is null)
+            yield break;
+        var entries = Read(dictionary, "_entries") as Array;
+        var count = (int)Read(dictionary, "_count")!;
+        if (entries is null)
+            yield break;
+        for (var index = 0; index < Math.Min(Math.Min(count, entries.Length), MaxEntries); index++)
+        {
+            var entry = entries.GetValue(index);
+            if ((int)Read(entry, "next")! >= -1)
+                yield return (Read(entry, "key"), Read(entry, "value"));
+        }
+    }
+
+    private static void Values(StringBuilder text, object? owner, params string[] names)
+    {
+        foreach (var name in names)
+        {
+            var value = Read(owner, name);
+            text.Append($" {name}={(value is Exception error ? error.GetType().Name : value ?? "null")}");
+        }
+    }
+
+    private static object? Read(object? owner, string field)
+    {
+        if (owner is null)
+            return null;
+        var info = owner.GetType().GetField(field, Fields)
+            ?? throw new MissingFieldException(owner.GetType().FullName, field);
+        return info.GetValue(owner);
+    }
+}
