<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
    <EnablePackageValidation>false</EnablePackageValidation>
    <RuntimeFrameworkVersion>10.0.14</RuntimeFrameworkVersion>
    <RollForward>Disable</RollForward>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <CompilerGeneratedFilesOutputPath>obj/Generated</CompilerGeneratedFilesOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(EvidenceSourceRoot)/src/SharpLink.Server/SharpLink.Server.csproj" />
    <ProjectReference Include="$(EvidenceSourceRoot)/src/SharpLink.Client/SharpLink.Client.csproj" />
    <ProjectReference Include="$(EvidenceSourceRoot)/src/SharpLink.Sdk/SharpLink.Sdk.csproj" />
    <ProjectReference Include="$(EvidenceSourceRoot)/src/SharpLink.Generator/SharpLink.Generator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <Target Name="RequireEvidenceSourceRoot" BeforeTargets="ResolveReferences" Condition="'$(EvidenceSourceRoot)' == ''">
    <Error Text="EvidenceSourceRoot must name the exact reviewed product worktree." />
  </Target>
</Project>
