<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <ApplicationId>com.sharplink.codeccompat</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <AssemblyName>SharpLink.CodecCompatibility</AssemblyName>
    <RootNamespace>SharpLink.CodecCompatibility</RootNamespace>
    <SupportedOSPlatformVersion>24.0</SupportedOSPlatformVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RunAOTCompilation>false</RunAOTCompilation>
    <PublishTrimmed>false</PublishTrimmed>
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
    <AndroidPackageFormats>apk</AndroidPackageFormats>
    <IsPackable>false</IsPackable>
    <UseMonoRuntime Condition="'$(CodecRuntime)' != 'coreclr'">true</UseMonoRuntime>
    <UseMonoRuntime Condition="'$(CodecRuntime)' == 'coreclr'">false</UseMonoRuntime>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/SharpLink.Runtime/SharpLink.Runtime.csproj" />
    <Compile Include="../SharpLink.CodecCompatibility/AutoLayoutEvidenceFixtures.cs" Link="Shared/AutoLayoutEvidenceFixtures.cs" />
    <Compile Include="../SharpLink.CodecCompatibility/CompatibilityPolicy.cs" Link="Shared/CompatibilityPolicy.cs" />
    <Compile Include="../SharpLink.CodecCompatibility/Fixtures.cs" Link="Shared/Fixtures.cs" />
    <Compile Include="../SharpLink.CodecCompatibility/Models.cs" Link="Shared/Models.cs" />
    <Compile Include="../SharpLink.CodecCompatibility/PortableModels.cs" Link="Shared/PortableModels.cs" />
    <Compile Include="../SharpLink.CodecCompatibility/PortableProbe.cs" Link="Shared/PortableProbe.cs" />
    <Compile Include="../SharpLink.CodecCompatibility/UnsafeBlitLayoutEvidence.cs" Link="Shared/UnsafeBlitLayoutEvidence.cs" />
    <Compile Include="../SharpLink.CodecCompatibility/UnsafeBlitLayoutEvidence.Matrix.cs" Link="Shared/UnsafeBlitLayoutEvidence.Matrix.cs" />
    <Compile Include="../SharpLink.CodecCompatibility/UnsafeBlitLayoutEvidence.StringCompatibility.cs" Link="Shared/UnsafeBlitLayoutEvidence.StringCompatibility.cs" />
  </ItemGroup>
</Project>