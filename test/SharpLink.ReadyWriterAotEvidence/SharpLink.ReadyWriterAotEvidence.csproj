<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <PublishAot>true</PublishAot>
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
    <AssemblyName>SharpLink.Benchmarks</AssemblyName>
    <RootNamespace>SharpLink.Benchmarks</RootNamespace>
    <DefineConstants>$(DefineConstants);SHARPLINK_READY_WRITER_EXPERIMENT</DefineConstants>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/SharpLink.Runtime/SharpLink.Runtime.csproj" />
    <Compile Include="../SharpLink.Benchmarks/PhaseBTransportSample.cs" Link="PhaseBTransportSample.cs" />
    <Compile Include="../SharpLink.Benchmarks/PhaseBTransportCase.cs" Link="PhaseBTransportCase.cs" />
    <Compile Include="../SharpLink.Benchmarks/PhaseBTransportPair.cs" Link="PhaseBTransportPair.cs" />
    <Compile Include="../SharpLink.Benchmarks/ReadyWriter*.cs" Link="%(Filename)%(Extension)" />
    <Compile Include="../SharpLink.FlowStatePhaseB/GrantAuthority.cs" Link="GrantAuthority.cs" />
    <Compile Include="../SharpLink.FlowStatePhaseB/GrantAuthority.Commands.cs" Link="GrantAuthority.Commands.cs" />
    <Compile Include="../SharpLink.FlowStatePhaseB/GrantAuthority.Publication.cs" Link="GrantAuthority.Publication.cs" />
    <Compile Include="../SharpLink.FlowStatePhaseB/GrantAuthority.Wire.cs" Link="GrantAuthority.Wire.cs" />
    <Compile Include="../SharpLink.FlowStatePhaseB/ReusableOwnerCommand.cs" Link="ReusableOwnerCommand.cs" />
    <Using Include="System" />
    <Using Include="System.IO" />
    <Using Include="System.Threading" />
    <Using Include="System.Threading.Tasks" />
    <Using Include="System.Collections.Generic" />
  </ItemGroup>
</Project>
