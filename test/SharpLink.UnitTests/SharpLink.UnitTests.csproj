<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\SharpLink.Abstractions\SharpLink.Abstractions.csproj" />
    <ProjectReference Include="..\..\src\SharpLink.Client\SharpLink.Client.csproj" />
    <ProjectReference Include="..\..\src\SharpLink.Hosting\SharpLink.Hosting.csproj" />
    <ProjectReference Include="..\..\src\SharpLink.Runtime\SharpLink.Runtime.csproj" />
    <ProjectReference Include="..\..\src\SharpLink.Compression.Zstd\SharpLink.Compression.Zstd.csproj" />
    <ProjectReference Include="..\..\src\SharpLink.Sdk\SharpLink.Sdk.csproj" />
    <ProjectReference Include="..\..\src\SharpLink.Serializer.SharpPack\SharpLink.Serializer.SharpPack.csproj" />
    <ProjectReference Include="..\..\src\SharpLink.Server\SharpLink.Server.csproj" />
    <ProjectReference Include="..\SharpLink.MultiClusterTest.Contracts\SharpLink.MultiClusterTest.Contracts.csproj" />
    <ProjectReference Include="..\SharpLink.RollbackPlugin\SharpLink.RollbackPlugin.csproj" />
    <ProjectReference Include="..\SharpLink.DynamicServices\SharpLink.DynamicServices.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\SharpLink.StaticCodecOwnerTest.Contracts\SharpLink.StaticCodecOwnerTest.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../SharpLink.ReadOwnershipAllocationProbe/SharpLink.ReadOwnershipAllocationProbe.csproj"
                      ReferenceOutputAssembly="false" OutputItemType="ReadOwnershipAllocationProbeOutput" />
  </ItemGroup>

  <Target Name="CopyReadOwnershipAllocationProbe" AfterTargets="Build">
    <ItemGroup>
      <ReadOwnershipAllocationProbeFile Include="@(ReadOwnershipAllocationProbeOutput)" />
      <ReadOwnershipAllocationProbeFile Include="@(ReadOwnershipAllocationProbeOutput->'%(RootDir)%(Directory)%(Filename).deps.json')" />
      <ReadOwnershipAllocationProbeFile Include="@(ReadOwnershipAllocationProbeOutput->'%(RootDir)%(Directory)%(Filename).runtimeconfig.json')" />
    </ItemGroup>
    <Error Condition="'@(ReadOwnershipAllocationProbeFile)' == ''" Text="The standalone read allocation probe was not built." />
    <Copy SourceFiles="@(ReadOwnershipAllocationProbeFile)" DestinationFolder="$(OutDir)allocation-probe" SkipUnchangedFiles="true" />
  </Target>

  <ItemGroup>
    <PackageReference Include="TUnit" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../SharpLink.Benchmarks/AllocationReadProbe.cs" Link="BenchmarkFixtures/AllocationReadProbe.cs" />
  </ItemGroup>

  <ItemGroup>
    <TestingPlatformBuilderHook Remove="98058041-B5B6-4A75-9834-58E6DF796A22" />
  </ItemGroup>
</Project>
