<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <PublishAot>true</PublishAot>
    <IsPackable>false</IsPackable>
    <StreamCodecEvidenceShape Condition="'$(StreamCodecEvidenceShape)' == ''">interface</StreamCodecEvidenceShape>
  </PropertyGroup>

  <PropertyGroup Condition="'$(StreamCodecEvidenceShape)' == 'interface'">
    <DefineConstants>$(DefineConstants);STREAM_CODEC_INTERFACE</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(StreamCodecEvidenceShape)' == 'hoisted'">
    <DefineConstants>$(DefineConstants);STREAM_CODEC_HOISTED</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(StreamCodecEvidenceShape)' == 'generic-class'">
    <DefineConstants>$(DefineConstants);STREAM_CODEC_GENERIC_CLASS</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(StreamCodecEvidenceShape)' == 'generic-struct'">
    <DefineConstants>$(DefineConstants);STREAM_CODEC_GENERIC_STRUCT</DefineConstants>
  </PropertyGroup>

  <Target Name="ValidateStreamCodecEvidenceShape" BeforeTargets="CoreCompile">
    <Error
      Condition="'$(StreamCodecEvidenceShape)' != 'interface' and
                 '$(StreamCodecEvidenceShape)' != 'hoisted' and
                 '$(StreamCodecEvidenceShape)' != 'generic-class' and
                 '$(StreamCodecEvidenceShape)' != 'generic-struct'"
      Text="Unsupported StreamCodecEvidenceShape '$(StreamCodecEvidenceShape)'." />
  </Target>

  <ItemGroup>
    <ProjectReference Include="..\..\src\SharpLink.Abstractions\SharpLink.Abstractions.csproj" />
  </ItemGroup>
</Project>
