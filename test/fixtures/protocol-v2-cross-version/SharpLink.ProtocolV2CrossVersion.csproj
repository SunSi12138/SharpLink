<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <SharpLinkVersion Condition="'$(SharpLinkVersion)' == ''">2.0.0</SharpLinkVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="SharpLink.Client" Version="[$(SharpLinkVersion)]" />
    <PackageReference Include="SharpLink.Server" Version="[$(SharpLinkVersion)]" />
    <PackageReference Include="SharpLink.Sdk" Version="[$(SharpLinkVersion)]" />
  </ItemGroup>
</Project>
