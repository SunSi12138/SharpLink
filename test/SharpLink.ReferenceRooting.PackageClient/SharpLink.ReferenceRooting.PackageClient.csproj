<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <SharpLinkPackageVersion Condition="'$(SharpLinkPackageVersion)' == '' and '$(VersionSuffix)' == ''">$(VersionPrefix)</SharpLinkPackageVersion>
    <SharpLinkPackageVersion Condition="'$(SharpLinkPackageVersion)' == '' and '$(VersionSuffix)' != ''">$(VersionPrefix)-$(VersionSuffix)</SharpLinkPackageVersion>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\SharpLink.PackageSmoke\SmokeFailureCollector.cs" Link="SmokeFailureCollector.cs" />
    <ProjectReference Include="..\SharpLink.ReferenceRooting.PackageContracts\SharpLink.ReferenceRooting.PackageContracts.csproj" />
    <PackageReference Include="SharpLink.Client" Version="$(SharpLinkPackageVersion)" />
  </ItemGroup>
</Project>
