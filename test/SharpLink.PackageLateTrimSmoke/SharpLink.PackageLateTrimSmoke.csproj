<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <TrimMode>partial</TrimMode>
    <SharpLinkPackageVersion Condition="'$(SharpLinkPackageVersion)' == '' and '$(VersionSuffix)' == ''">$(VersionPrefix)</SharpLinkPackageVersion>
    <SharpLinkPackageVersion Condition="'$(SharpLinkPackageVersion)' == '' and '$(VersionSuffix)' != ''">$(VersionPrefix)-$(VersionSuffix)</SharpLinkPackageVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SharpLink.Runtime" Version="$(SharpLinkPackageVersion)" />
  </ItemGroup>

  <!-- Simulates Apple workloads, which compute PublishTrimmed during target execution. -->
  <Target Name="_ComputePublishTrimmed">
    <PropertyGroup>
      <PublishTrimmed>true</PublishTrimmed>
    </PropertyGroup>
  </Target>

  <Target Name="VerifySharpLinkLateTrimConfiguration"
          DependsOnTargets="_ComputePublishTrimmed">
    <ItemGroup>
      <_SharpLinkUnsafeBlitSwitch Include="@(RuntimeHostConfigurationOption)"
                                  Condition="'%(Identity)' == 'SharpLink.Runtime.UnsafeBlitReflectionFallback'" />
    </ItemGroup>
    <Error Condition="'$(SharpLinkUnsafeBlitTrimConfigurationApplied)' != 'true'"
           Text="SharpLink trim configuration target did not run after late PublishTrimmed computation." />
    <Error Condition="'@(_SharpLinkUnsafeBlitSwitch)' == ''"
           Text="SharpLink UnsafeBlit reflection fallback switch was not added after late PublishTrimmed computation." />
    <Error Condition="'@(_SharpLinkUnsafeBlitSwitch->'%(Value)')' != 'false'"
           Text="SharpLink UnsafeBlit reflection fallback switch must be false for late trimming." />
    <Error Condition="'@(_SharpLinkUnsafeBlitSwitch->'%(Trim)')' != 'true'"
           Text="SharpLink UnsafeBlit reflection fallback switch must participate in trimming." />
    <Error Condition="'@(_ILLinkSuppressions)' == ''"
           Text="SharpLink partial-trim package suppression was not added after late PublishTrimmed computation." />
    <Message Importance="high" Text="PACKAGE_LATE_TRIM_CONFIGURATION_PASS" />
  </Target>
</Project>
