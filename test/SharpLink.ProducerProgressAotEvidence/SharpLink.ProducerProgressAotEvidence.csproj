<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <PublishAot Condition="'$(PublishAot)' == ''">true</PublishAot>
    <AssemblyName>SharpLink.Benchmarks</AssemblyName>
    <RootNamespace>SharpLink.Benchmarks</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- Compile the exact same generated RPC workloads in JIT and NativeAOT without pulling in
       BenchmarkDotNet or its reflection-heavy runtime measurement infrastructure. -->
  <ItemGroup>
    <Compile Include="../SharpLink.Benchmarks/BenchmarkEnvironment.cs" Link="BenchmarkEnvironment.cs" />
    <Compile Include="../SharpLink.Benchmarks/ServerLifecycleTestExtensions.cs" Link="ServerLifecycleTestExtensions.cs" />
    <Compile Include="../SharpLink.Benchmarks/AllocationReadProbe.cs" Link="AllocationReadProbe.cs" />
    <Compile Include="../SharpLink.Benchmarks/BenchmarkContracts.cs" Link="BenchmarkContracts.cs" />
    <Compile Include="../SharpLink.Benchmarks/BenchmarkService.cs" Link="BenchmarkService.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/SharpLink.Abstractions/SharpLink.Abstractions.csproj" />
    <ProjectReference Include="../../src/SharpLink.Runtime/SharpLink.Runtime.csproj" />
    <ProjectReference Include="../../src/SharpLink.Client/SharpLink.Client.csproj" />
    <ProjectReference Include="../../src/SharpLink.Server/SharpLink.Server.csproj" />
    <ProjectReference Include="../../src/SharpLink.Sdk/SharpLink.Sdk.csproj" />
    <ProjectReference Include="../../src/SharpLink.Serializer.SharpPack/SharpLink.Serializer.SharpPack.csproj" />
    <ProjectReference Include="../../src/SharpLink.Generator/SharpLink.Generator.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false"
                      GlobalPropertiesToRemove="RuntimeIdentifier;SelfContained;PublishAot;PublishSingleFile" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="SharpPack" />
  </ItemGroup>
</Project>
