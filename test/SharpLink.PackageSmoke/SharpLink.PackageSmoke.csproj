<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <SharpLinkPackageVersion Condition="'$(SharpLinkPackageVersion)' == '' and '$(VersionSuffix)' == ''">$(VersionPrefix)</SharpLinkPackageVersion>
    <SharpLinkPackageVersion Condition="'$(SharpLinkPackageVersion)' == '' and '$(VersionSuffix)' != ''">$(VersionPrefix)-$(VersionSuffix)</SharpLinkPackageVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SharpLink.Client" Version="$(SharpLinkPackageVersion)" />
    <PackageReference Include="SharpLink.Server" Version="$(SharpLinkPackageVersion)" />
    <PackageReference Include="SharpLink.Sdk" Version="$(SharpLinkPackageVersion)" />
    <PackageReference Include="SharpLink.Serializer.SharpPack" Version="$(SharpLinkPackageVersion)" />
  </ItemGroup>
</Project>
